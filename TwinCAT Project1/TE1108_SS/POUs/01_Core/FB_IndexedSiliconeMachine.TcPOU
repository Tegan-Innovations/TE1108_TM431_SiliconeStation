<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_IndexedSiliconeMachine" Id="{ff07b0ce-3073-475d-ae18-b3b039ab22f1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IndexedSiliconeMachine
VAR
    fbIndex              : FB_IndexTable4;
    fbProcessStation     : FB_ProcessStation;
    fbMainDoorLock       : FB_MainDoorLock;
    fbIvek               : FB_IvekDigiSpense4000;
    fbSimulatedEquipment : FB_SimulatedProcessEquipment;
    fbNestManager        : FB_NestTableManager;
    fbOperatorStation    : FB_OperatorStation;
    fbPuckLocker         : FB_PuckLocker;
    fbProcessCycle       : FB_ProcessCycle;
    fbManualMode         : FB_ManualMode;
    ipEquipment          : I_ProcessEquipment;
    eMachineState        : E_MachineState := E_MachineState.PowerUp;
    eCycleState          : E_CycleState := E_CycleState.Idle;
    stLastResult         : ST_ProcessResult;
    stOperatorNest       : ST_Nest;
    stPuckStatus         : ST_PuckLockerStatus;
    stOperatorStatus     : ST_OperatorStationStatus;
    stIndexStatus        : ST_IndexStatus;
    stProcessStationStatus : ST_ProcessStationStatus;
    stMainDoorLockStatus : ST_MainDoorLockStatus;
    ePreviousMachineState : E_MachineState := E_MachineState.PowerUp;
    bMachineStateEntry    : BOOL;
    eInitialisingWaitReason : E_InitialisingWaitReason := E_InitialisingWaitReason.None;
    eStoppingWaitReason     : E_StoppingWaitReason := E_StoppingWaitReason.None;
    stPermissives        : ST_MachinePermissives;
    stOutputsInternal    : ST_MachineOutputs;
    stProcessCycleInputs : ST_ProcessCycleInputs;
    stProcessCycleRequests : ST_ProcessCycleRequests;
    stProcessCycleStatus : ST_ProcessCycleStatus;
    stManualModeInputs   : ST_ManualModeInputs;
    stManualModeRequests : ST_ManualModeRequests;
    stManualModeStatus   : ST_ManualModeStatus;
    bManualIndexRequestAccepted : BOOL;
    stProcessNest        : ST_Nest;
    bConfigured          : BOOL;
    bProcessStartPulse   : BOOL;
    bProcExtend          : BOOL;
    bProcRetract         : BOOL;
    bPuckPinUp           : BOOL;
    bIndexStable         : BOOL;
    bIndexDone           : BOOL;
    bProcessReady        : BOOL;
    bInitialisationComplete : BOOL;
    bStoppingComplete       : BOOL;
    bInitialisationTimeoutFault : BOOL;
    bStoppingTimeoutFault       : BOOL;
    bResultStoredFeedback       : BOOL;
    bIndexRequestAcceptedFeedback : BOOL;
    bIndexRecoveryRequestAcceptedFeedback : BOOL;
    tonInitialising         : TON;
    tonStopping             : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{b3ad9d70-3bf2-42da-ab5a-7255e3c227a5}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    stInputs       : ST_MachineInputs;
    stCommand      : ST_MachineCommand;
    stConfig       : ST_MachineConfig;
    stIvekInput    : ST_IvekCyclicInput;
    bIvekCommsOk   : BOOL;
END_VAR
VAR_OUTPUT
    stOutputs      : ST_MachineOutputs;
    stStatus       : ST_MachineStatus;
    stIvekOutput   : ST_IvekCyclicOutput;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Deterministic defaults
ResetCyclicOutputs();
bMachineStateEntry := eMachineState <> ePreviousMachineState;
bProcessStartPulse := FALSE;
bProcessStartPulse := FALSE;
stIndexStatus := fbIndex.GetStatus();
bIndexStable := stIndexStatus.bProcessPositionReady AND stInputs.bIndexReady AND stInputs.bIndexLocked;
bIndexDone := fbIndex.IsDone();

// Configure process equipment once. Simulation is the default until the IVEK is available.
IF NOT bConfigured THEN
    IF stConfig.bUseProcessSimulation THEN ipEquipment := fbSimulatedEquipment; ELSE ipEquipment := fbIvek; END_IF
    fbProcessStation.Configure(ipNewEquipment := ipEquipment);
    bConfigured := TRUE;
END_IF

fbIvek.stCyclicIn := stIvekInput;
fbIvek.bCommunicationOk := bIvekCommsOk;
IF stCommand.usiRecipeRequest <> 0 THEN ipEquipment.SetRecipe(stCommand.usiRecipeRequest); END_IF
IF stConfig.bUseProcessSimulation THEN
    IF stCommand.bSimulateProcessFault THEN fbSimulatedEquipment.SetSimulationResult(bPass := FALSE, bFault := TRUE);
    ELSIF stCommand.bSimulateProcessFail THEN fbSimulatedEquipment.SetSimulationResult(bPass := FALSE, bFault := FALSE);
    ELSIF stCommand.bSimulateProcessPass THEN fbSimulatedEquipment.SetSimulationResult(bPass := TRUE, bFault := FALSE);
    END_IF
END_IF

// Nest ownership and stable sensor edge tracking
fbNestManager.Cyclic(
    bIndexStable := bIndexStable,
    bIndexComplete := bIndexDone,
    bGearboxAssemblyPartPresent := stInputs.bGearboxAssemblyPartPresent,
    bReservoirPartPresent := stInputs.bReservoirPartPresent,
    eOperatorPosition := stConfig.eOperatorPosition,
    eProcessPosition := stConfig.eProcessPosition,
    aNestEnabled := stConfig.aNestEnabled);
stOperatorNest := fbNestManager.GetNestAtPosition(stConfig.eOperatorPosition);

// Puck locker remains independent from the automatic cycle.
fbPuckLocker.Cyclic(
    eMode := stConfig.ePuckLockerMode,
    bSensorUp := stInputs.bPuckSensorUp,
    bSensorDown := stInputs.bPuckSensorDown,
    bPartRemovedFromNest := stOperatorNest.bPartRemovedPulse,
    bReleasePassPuck := stOperatorNest.stResult.bValid AND stOperatorNest.stResult.bPassed AND NOT stOperatorNest.bDispositionSent,
    bAcknowledgeFault := stCommand.bAcknowledgePuckRemovalFault,
    bEmptyPuckBypass := stCommand.bEmptyPuckBypass,
    tRemovalConfirm := stConfig.tPuckRemovalConfirm,
    bPinCommandUp => bPuckPinUp);
stPuckStatus := fbPuckLocker.GetStatus();

// Operator exchange is evaluated independently of process-equipment implementation.
fbOperatorStation.Cyclic(
    bAutomaticActive := eMachineState = E_MachineState.AutoCycle,
    bIndexStable := bIndexStable,
    stOperatorNest := stOperatorNest,
    bGearboxAssemblyPartPresent := stInputs.bGearboxAssemblyPartPresent,
    bRejectChutePartPresent := stInputs.bRejectChutePartPresent,
    bPuckLockerEnabled := stConfig.ePuckLockerMode <> E_PuckLockerMode.Disabled,
    bPuckLocked := fbPuckLocker.IsLocked(),
    bPuckDetected := stPuckStatus.bPuckDetected,
    ePuckLockerState := stPuckStatus.eState,
    bRequireRejectConfirm := stConfig.bRequireRejectConfirm,
    bAllowEmptyNestIndex := stConfig.bAllowEmptyNestIndex);
stOperatorStatus := fbOperatorStation.GetStatus();

// Explicit permissive aggregation.
stPermissives.bSafetyIndexPermissive := stInputs.stSafety.bMotionSafetyPermitted;
stPermissives.bOperatorIndexPermissive := fbOperatorStation.IndexPermissive();
stPermissives.bProcessIndexPermissive := fbProcessStation.IndexPermissive();
stPermissives.bPuckLockerIndexPermissive := stPuckStatus.bIndexPermissive;
stPermissives.bIndexMoveAllowed := stPermissives.bSafetyIndexPermissive
    AND stPermissives.bOperatorIndexPermissive
    AND stPermissives.bProcessIndexPermissive
    AND stPermissives.bPuckLockerIndexPermissive;
stPermissives.bProcessStartAllowed := stInputs.stSafety.bProcessSafetyPermitted
    AND stInputs.bIndexReady AND stInputs.bIndexLocked
    AND stInputs.bReservoirPartPresent;

// Event architecture from the Leak Tester.
// Point classification is fixed in PRG_Events; station latches are provided
// through stInputs.bEventFault and stInputs.bEventCycleStopRequest.

// Manual-mode coordinator consumes only normalized component status and produces requests.
stManualModeInputs.bSafetyOk := stInputs.stSafety.bSafetyOk;
stManualModeInputs.bMotionSafetyPermitted := stInputs.stSafety.bMotionSafetyPermitted;
stManualModeInputs.bTwoHandsSafe := stInputs.bTwoHandsSafe;
stManualModeInputs.bProcessSafetyPermitted := stInputs.stSafety.bProcessSafetyPermitted;
stManualModeInputs.bMainDoorSafe := stInputs.stSafety.bMainDoorSafe;
stManualModeInputs.bIndexReady := stInputs.bIndexReady;
stManualModeInputs.bIndexLocked := stInputs.bIndexLocked;
stManualModeInputs.bIndexBusy := stIndexStatus.bBusy;
stManualModeInputs.bIndexFaulted := fbIndex.IsFaulted();
stManualModeInputs.bTransferNestSupportCylinderExtended := stInputs.bTransferNestSupportCylinderExtended;
stManualModeInputs.bTransferNestSupportCylinderRetracted := stInputs.bTransferNestSupportCylinderRetracted;
stManualModeInputs.bProcessStationFaulted := fbProcessStation.IsFaulted();
stManualModeInputs.bEquipmentReady := ipEquipment.IsReady();
stManualModeInputs.bEquipmentBusy := ipEquipment.IsBusy();
stManualModeInputs.bEquipmentFaulted := ipEquipment.IsFaulted();
stManualModeInputs.bReservoirPartPresent := stInputs.bReservoirPartPresent;

fbManualMode.Cyclic(
    bEnable := eMachineState = E_MachineState.Manual,
    bStopRequest := stCommand.bStop OR NOT stCommand.bManualRequest,
    stCommand := stCommand,
    stInputs := stManualModeInputs,
    stRequests => stManualModeRequests,
    stStatus => stManualModeStatus);

CASE eMachineState OF
E_MachineState.PowerUp:
    // Same machine lifecycle used by the Kistler: always enter a controlled stop first.
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);
    eCycleState := E_CycleState.Idle;
    eMachineState := E_MachineState.Stopping;

E_MachineState.Fault:
    // Fault blocks automatic operation. The safe chain is only dropped for alarms
    // explicitly classified as SafetyStop by the alarm manager.
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);
    ipEquipment.RequestStop();

    // Reset clears component fault latches and the event manager clears each
    // station latch only when no classified fault condition remains active.
    IF stCommand.bReset THEN
        fbIndex.Reset();
        ipEquipment.RequestReset();
        bInitialisationTimeoutFault := FALSE;
        bStoppingTimeoutFault := FALSE;
        eCycleState := E_CycleState.Idle;
    END_IF

    // SafetyOk can only recover after the event latch releases SafetyRun.
    IF NOT stInputs.bEventFault
       AND stInputs.stSafety.bSafetyOk
    THEN
        eMachineState := E_MachineState.Stopping;
    END_IF

E_MachineState.Stopping:
    // Active stop: cancel requests, stop equipment and retract process tooling.
    tonInitialising(IN := FALSE);
    tonStopping(IN := TRUE, PT := stConfig.tStoppingTimeout);
    ipEquipment.RequestStop();
    stIndexStatus := fbIndex.GetStatus();
    stProcessStationStatus := fbProcessStation.GetStatus();
    stMainDoorLockStatus := fbMainDoorLock.GetStatus();
    eStoppingWaitReason := E_StoppingWaitReason.None;
    IF stIndexStatus.bBusy THEN eStoppingWaitReason := E_StoppingWaitReason.IndexStillMoving;
    ELSIF NOT stInputs.bTransferNestSupportCylinderRetracted THEN eStoppingWaitReason := E_StoppingWaitReason.TransferNestSupportCylinderRetracting;
    ELSIF ipEquipment.IsBusy() THEN eStoppingWaitReason := E_StoppingWaitReason.ProcessEquipmentStopping;
    ELSIF (stMainDoorLockStatus.eState = E_MainDoorLockState.Locking) OR (stMainDoorLockStatus.eState = E_MainDoorLockState.Unlocking) THEN eStoppingWaitReason := E_StoppingWaitReason.MainDoorTransition;
    END_IF
    bStoppingComplete := eStoppingWaitReason = E_StoppingWaitReason.None;
    IF bStoppingComplete THEN
        tonStopping(IN := FALSE);
        eCycleState := E_CycleState.Idle;
        eMachineState := E_MachineState.Stopped;
    ELSIF tonStopping.Q THEN
        bStoppingTimeoutFault := TRUE;
        eMachineState := E_MachineState.Fault;
    END_IF

E_MachineState.Stopped:
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);
    ipEquipment.RequestStop();

    IF stCommand.bReset AND stInputs.stSafety.bSafetyOk THEN
        eMachineState := E_MachineState.Initialising;
    END_IF

E_MachineState.Initialising:
    // Initialising normalises software objects once and never moves the index.
    tonStopping(IN := FALSE);
    tonInitialising(IN := TRUE, PT := stConfig.tInitialiseTimeout);
    IF bMachineStateEntry THEN
        fbProcessCycle.Initialise();
        fbManualMode.Initialise();
        fbProcessStation.Initialise();
        fbMainDoorLock.Initialise();
        bResultStoredFeedback := FALSE;
        bIndexRequestAcceptedFeedback := FALSE;
        bIndexRecoveryRequestAcceptedFeedback := FALSE;
        bProcessStartPulse := FALSE;
    END_IF
    ipEquipment.RequestReset();
    stIndexStatus := fbIndex.GetStatus();
    stProcessStationStatus := fbProcessStation.GetStatus();
    stMainDoorLockStatus := fbMainDoorLock.GetStatus();
    eInitialisingWaitReason := E_InitialisingWaitReason.None;
    IF NOT stInputs.stSafety.bSafetyOk THEN eInitialisingWaitReason := E_InitialisingWaitReason.SafetyNotReady;
    ELSIF NOT stInputs.stSafety.bFsoeOk THEN eInitialisingWaitReason := E_InitialisingWaitReason.FsoeNotReady;
    ELSIF NOT stInputs.stSafety.bSafetyLogicOk THEN eInitialisingWaitReason := E_InitialisingWaitReason.SafetyLogicNotReady;
    ELSIF stIndexStatus.bBusy THEN eInitialisingWaitReason := E_InitialisingWaitReason.IndexBusy;
    ELSIF NOT stInputs.bTransferNestSupportCylinderRetracted THEN eInitialisingWaitReason := E_InitialisingWaitReason.TransferNestSupportCylinderNotRetracted;
    ELSIF fbProcessStation.IsFaulted() THEN eInitialisingWaitReason := E_InitialisingWaitReason.ProcessStationFaulted;
    ELSIF fbMainDoorLock.IsFaulted() THEN eInitialisingWaitReason := E_InitialisingWaitReason.MainDoorFaulted;
    ELSIF stPuckStatus.bUnexpectedRemovalFault OR stPuckStatus.bPuckSensorMismatch THEN eInitialisingWaitReason := E_InitialisingWaitReason.PuckLockerFaulted;
    ELSIF NOT ipEquipment.IsReady() THEN eInitialisingWaitReason := E_InitialisingWaitReason.ProcessEquipmentNotReady;
    END_IF
    bInitialisationComplete := eInitialisingWaitReason = E_InitialisingWaitReason.None;
    IF bInitialisationComplete THEN
        tonInitialising(IN := FALSE);
        eCycleState := E_CycleState.Idle;
        eMachineState := E_MachineState.ReadyToStart;
    ELSIF tonInitialising.Q THEN
        bInitialisationTimeoutFault := TRUE;
        eMachineState := E_MachineState.Fault;
    END_IF

E_MachineState.ReadyToStart:
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);

    IF stInputs.bEventFault THEN
        eMachineState := E_MachineState.Fault;
    ELSIF stCommand.bStop THEN
        eMachineState := E_MachineState.Stopping;
	ELSIF stCommand.bManualRequest
        AND stInputs.stSafety.bSafetyOk
        AND NOT stInputs.bEventFault
        AND NOT stIndexStatus.bBusy
        AND NOT fbProcessStation.IsFaulted()
        AND NOT ipEquipment.IsFaulted()
    THEN
        fbManualMode.Initialise();
        eMachineState := E_MachineState.Manual;
    ELSIF stCommand.bStart
       AND fbIndex.IsReady()
       AND ipEquipment.IsReady()
       AND fbMainDoorLock.IsReadyForAutomatic()
    THEN
        eCycleState := E_CycleState.Idle;
        eMachineState := E_MachineState.AutoCycle;
    END_IF

E_MachineState.AutoCycle:
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);

    stProcessNest := fbNestManager.GetNestAtPosition(stConfig.eProcessPosition);
    stProcessCycleInputs.bSafetyOk := stInputs.stSafety.bSafetyOk;
    stProcessCycleInputs.bTwoHandsSafe := stInputs.bTwoHandsSafe;
    stProcessCycleInputs.bIndexPositionValid := stInputs.eIndexPosition <> E_TablePosition.Unknown;
    stProcessCycleInputs.bProcessNestEnabled := stProcessNest.bEnabled;
    stProcessCycleInputs.bReservoirPartPresent := stInputs.bReservoirPartPresent;
    stProcessCycleInputs.bProcessResultAlreadyValid := stProcessNest.stResult.bValid;
    stProcessCycleInputs.bProcessStationReady := fbProcessStation.IndexPermissive() AND NOT fbProcessStation.IsFaulted();
    stProcessCycleInputs.bProcessStationBusy := ipEquipment.IsBusy();
    stProcessCycleInputs.bProcessStationComplete := fbProcessStation.IsComplete();
    stProcessCycleInputs.bProcessStationFaulted := fbProcessStation.IsFaulted();
    stProcessCycleInputs.bResultStored := bResultStoredFeedback;
    stProcessCycleInputs.bOperatorExchangeComplete := fbOperatorStation.IsComplete();
    stProcessCycleInputs.bIndexMoveAllowed := stPermissives.bIndexMoveAllowed;
    stProcessCycleInputs.bIndexReady := fbIndex.IsReady();
    stProcessCycleInputs.bIndexBusy := stIndexStatus.bBusy;
    stProcessCycleInputs.bIndexDone := fbIndex.IsDone();
    stProcessCycleInputs.bIndexFaulted := fbIndex.IsFaulted();
    stProcessCycleInputs.bIndexRequestAccepted := bIndexRequestAcceptedFeedback;
    stProcessCycleInputs.bIndexRecoveryRequestAccepted := bIndexRecoveryRequestAcceptedFeedback;

    fbProcessCycle.Cyclic(
        bEnable := TRUE,
        bStopRequest := stCommand.bStop,
        bResetRequest := stCommand.bReset,
        stInputs := stProcessCycleInputs,
        stRequests => stProcessCycleRequests,
        stStatus => stProcessCycleStatus);

    // Feedback flags are retained for one scan and consumed by FB_ProcessCycle above.
    bResultStoredFeedback := FALSE;
    bIndexRequestAcceptedFeedback := FALSE;
    bIndexRecoveryRequestAcceptedFeedback := FALSE;

    IF stProcessCycleRequests.bCaptureProcessResult THEN
        stLastResult := fbProcessStation.GetResult();
    END_IF

    IF stProcessCycleRequests.bStoreProcessResult THEN
        stLastResult := fbProcessStation.GetResult();
        bResultStoredFeedback := fbNestManager.StoreResultAtPosition(
            ePosition := stConfig.eProcessPosition,
            stResult := stLastResult);
        IF bResultStoredFeedback THEN
            fbIndex.ReleaseProcessPosition();
        END_IF
    END_IF

    IF stProcessCycleRequests.bConfirmOperatorExchange THEN
        fbNestManager.MarkDispositionComplete(stConfig.eOperatorPosition);
        fbIndex.ConfirmOperatorExchange();
    END_IF

    IF stProcessCycleRequests.bRequestIndex THEN
        bIndexRequestAcceptedFeedback := fbIndex.RequestMove();
    END_IF

    IF stProcessCycleRequests.bRequestIndexRecovery THEN
        bIndexRecoveryRequestAcceptedFeedback := fbIndex.RequestPositionRecovery();
    END_IF

    IF stProcessCycleRequests.bUpdateNestPositions THEN
        fbNestManager.ClearOperatorNest(stConfig.eOperatorPosition);
    END_IF

    bProcessStartPulse := stProcessCycleRequests.bStartProcessStation;

    IF stProcessCycleStatus.bFaulted THEN
        eMachineState := E_MachineState.Fault;
    ELSIF stCommand.bStop AND (stProcessCycleStatus.eState = E_CycleState.ResetCycle) THEN
        eMachineState := E_MachineState.Stopping;
    END_IF

E_MachineState.Manual:
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);

    IF stInputs.bEventFault THEN
        eMachineState := E_MachineState.Fault;
    ELSE
        IF stManualModeRequests.bIndexMoveRequest THEN
            bManualIndexRequestAccepted := fbIndex.RequestManualMove();
        END_IF

        // A home request currently reinitialises the pneumatic index sequence.
        // Replace with a dedicated home method if the final index hardware supports one.
        IF stManualModeRequests.bIndexHomeRequest THEN
            fbIndex.Reset();
        END_IF

        IF stManualModeRequests.bEquipmentStart THEN
            ipEquipment.RequestStart();
        END_IF
        IF stManualModeRequests.bEquipmentStop THEN
            ipEquipment.RequestStop();
        END_IF
        IF stManualModeRequests.bEquipmentReset THEN
            ipEquipment.RequestReset();
        END_IF

        IF (stCommand.bStop OR NOT stCommand.bManualRequest) AND stManualModeStatus.bSafeToExit THEN
            eMachineState := E_MachineState.Stopping;
        END_IF
    END_IF
END_CASE

IF eMachineState <> E_MachineState.AutoCycle THEN
    fbProcessCycle.Cyclic(
        bEnable := FALSE,
        bStopRequest := TRUE,
        bResetRequest := stCommand.bReset,
        stInputs := stProcessCycleInputs,
        stRequests => stProcessCycleRequests,
        stStatus => stProcessCycleStatus);
END_IF

// Cyclic component execution
fbProcessStation.Cyclic(
    bEnable := eMachineState = E_MachineState.AutoCycle,
    bAutomaticStartRequest := bProcessStartPulse,
    bManualEnable := eMachineState = E_MachineState.Manual,
    bManualExtendRequest := stManualModeRequests.bCylinderExtend,
    bManualRetractRequest := stManualModeRequests.bCylinderRetract,
    bStopRequest := (eMachineState = E_MachineState.Stopping) OR (eMachineState = E_MachineState.Fault),
    bResetRequest := stCommand.bReset,
    bPartPresent := stInputs.bReservoirPartPresent,
    bProcessPermissive := stPermissives.bProcessStartAllowed,
    bIndexReady := stInputs.bIndexReady,
    bIndexLocked := stInputs.bIndexLocked,
    bIndexBusy := stIndexStatus.bBusy,
    bProcessSafetyPermitted := stInputs.stSafety.bProcessSafetyPermitted,
    bMainDoorSafe := stInputs.stSafety.bMainDoorSafe,
    bCylinderExtended := stInputs.bTransferNestSupportCylinderExtended,
    bCylinderRetracted := stInputs.bTransferNestSupportCylinderRetracted,
    tCylinderTimeout := stConfig.tCylinderTimeout,
    tProcessTimeout := stConfig.tProcessTimeout,
    bCylinderExtendOutput => bProcExtend,
    bCylinderRetractOutput => bProcRetract);
stProcessStationStatus := fbProcessStation.GetStatus();

fbMainDoorLock.Cyclic(
    bEnableAutomatic := eMachineState = E_MachineState.AutoCycle OR eMachineState = E_MachineState.ReadyToStart,
    bManualEnable := eMachineState = E_MachineState.Manual,
    bManualLockRequest := stManualModeRequests.bMainDoorLockRequest,
    bManualUnlockRequest := NOT stManualModeRequests.bMainDoorLockRequest,
    bStopRequest := eMachineState = E_MachineState.Stopping OR eMachineState = E_MachineState.Stopped,
    bResetRequest := stCommand.bReset,
    bDoorClosed := stInputs.bMainDoorClosed,
    bDoorLocked := stInputs.bMainDoorLocked,
    bDoorSafe := stInputs.stSafety.bMainDoorSafe,
    bIndexBusy := stIndexStatus.bBusy,
    bProcessSafePosition := fbProcessStation.IsSafePosition(),
    tLockTimeout := stConfig.tDoorLockTimeout,
    tUnlockTimeout := stConfig.tDoorUnlockTimeout,
    bLockOutput => stOutputsInternal.bMainDoorLockRequest);
stMainDoorLockStatus := fbMainDoorLock.GetStatus();

fbIndex.Cyclic(
    bEnable := (eMachineState = E_MachineState.Initialising)
        OR (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (eMachineState = E_MachineState.Manual)
        OR (eMachineState = E_MachineState.Stopping),
    bReset := stCommand.bReset,
    bAutomaticMode := eMachineState = E_MachineState.AutoCycle,
    bManualMode := eMachineState = E_MachineState.Manual,
    bMovePermissive :=
        ((eMachineState = E_MachineState.AutoCycle)
            AND
            (stPermissives.bIndexMoveAllowed
             OR (stInputs.eIndexPosition = E_TablePosition.Unknown
                 AND stInputs.stSafety.bMotionSafetyPermitted
                 AND stInputs.bTransferNestSupportCylinderRetracted)))
        OR (stManualModeStatus.bIndexPermissive AND (eMachineState = E_MachineState.Manual)),
    bSafetyMotionPermitted := stInputs.stSafety.bMotionSafetyPermitted,
    bTwoHandsSafe := stInputs.bTwoHandsSafe,
    bStationsHome := stInputs.bTransferNestSupportCylinderRetracted,
    bProcessToolingRetracted := stInputs.bTransferNestSupportCylinderRetracted,
    bTableReady := stInputs.bIndexReady,
    bTableLocked := stInputs.bIndexLocked,
    bCompletedSensor := stInputs.bIndexCompletedSensor,
    bSupportExtended := stInputs.bIndexSupportExtended,
    bSupportRetracted := stInputs.bIndexSupportRetracted,
    eCurrentPosition := stInputs.eIndexPosition,
    tRotateDelay := stConfig.tIndexRotateDelay,
    tStopDelay := stConfig.tIndexStopDelay,
    tSupportTimeout := stConfig.tIndexSupportTimeout,
    tMovementTimeout := stConfig.tIndexTimeout,
    tTwoHandHold := stConfig.tTwoHandHold,
    tTwoHandRecoveryTimeout := stConfig.tTwoHandRecoveryTimeout,
    bRotatePortA => stOutputsInternal.bIndexRotatePortA,
    bStopPortB => stOutputsInternal.bIndexStopPortB,
    bSupportExtendRequest => stOutputsInternal.bIndexSupportExtend,
    bSupportRetractRequest => stOutputsInternal.bIndexSupportRetract);

IF stInputs.bEventFault THEN
    eMachineState := E_MachineState.Fault;
ELSIF stInputs.bEventCycleStopRequest
      AND (eMachineState = E_MachineState.AutoCycle OR eMachineState = E_MachineState.Manual)
THEN
    eMachineState := E_MachineState.Stopping;
END_IF

// Outputs and public status
stOutputsInternal.bTransferNestSupportCylinderExtend := bProcExtend;
stOutputsInternal.bTransferNestSupportCylinderRetract := bProcRetract;
stOutputsInternal.bPuckLockerPinUp := bPuckPinUp;
// Only a latched station fault generated by point.bFault AND point.bEventFlag
// requests the TwinSAFE chain to drop. Visual messages and cycle-stop events do not.
stOutputsInternal.bSafetyRunRequest := NOT stInputs.bEventFault;
stOutputsInternal.bSafetyResetRequest := stCommand.bReset AND NOT stInputs.stSafety.bSafetyOk;
stOutputsInternal.bAirSupplyEnable :=
    (eMachineState = E_MachineState.Initialising)
    OR (eMachineState = E_MachineState.ReadyToStart)
    OR (eMachineState = E_MachineState.AutoCycle)
    OR (eMachineState = E_MachineState.Manual)
    OR (eMachineState = E_MachineState.Stopping);
stOutputsInternal.bLedStart := eMachineState = E_MachineState.ReadyToStart;
stOutputsInternal.bLedReset := eMachineState = E_MachineState.Fault OR eMachineState = E_MachineState.Stopped;
stOutputsInternal.bLedPass := stLastResult.bValid AND stLastResult.bPassed;
stOutputsInternal.bLedFail := stLastResult.bValid AND NOT stLastResult.bPassed;
stOutputsInternal.bInternalLight := TRUE;
stOutputsInternal.bExternalLight := eMachineState = E_MachineState.AutoCycle;

stIvekOutput := fbIvek.stCyclicOut;
stStatus.eMachineState := eMachineState;
stStatus.eCycleState := stProcessCycleStatus.eState;
stStatus.stProcessCycle := stProcessCycleStatus;
stStatus.stProcessStation := stProcessStationStatus;
stStatus.stMainDoorLock := stMainDoorLockStatus;
stStatus.eInitialisingWaitReason := eInitialisingWaitReason;
stStatus.eStoppingWaitReason := eStoppingWaitReason;
stIndexStatus := fbIndex.GetStatus();
stStatus.eIndexState := stIndexStatus.eState;
stStatus.stIndexStatus := stIndexStatus;
stStatus.eEquipmentState := ipEquipment.GetState();
stStatus.eOperatorExchangeState := fbOperatorStation.GetState();
stStatus.eOperatorInstruction := fbOperatorStation.GetInstruction();
stStatus.stOperatorStation := stOperatorStatus;
stStatus.eManualModeState := stManualModeStatus.eState;
stStatus.stManualMode := stManualModeStatus;
stStatus.bReady := eMachineState = E_MachineState.ReadyToStart;
stStatus.bBusy := eMachineState = E_MachineState.AutoCycle;
stStatus.bFaulted := eMachineState = E_MachineState.Fault;
stStatus.bInitialisationTimeoutFault := bInitialisationTimeoutFault;
stStatus.bStoppingTimeoutFault := bStoppingTimeoutFault;
stStatus.bSafetyStopRequested := stInputs.bEventFault;
stStatus.bSafetyRunRequested := stOutputsInternal.bSafetyRunRequest;
stStatus.bEventFault := stInputs.bEventFault;
stStatus.bCycleStopRequested := stInputs.bEventCycleStopRequest;
stStatus.bIndexPermissive := stPermissives.bIndexMoveAllowed;
stStatus.bProcessPermissive := stPermissives.bProcessStartAllowed;
stStatus.stPermissives := stPermissives;
stStatus.stLastResult := stLastResult;
stStatus.stPuckLocker := stPuckStatus;
// Legacy alarm-summary fields retained only for HMI compatibility.
// The Events Manager is now the single source of machine fault state.
stStatus.stAlarms.bHasFault := stInputs.bEventFault;
stStatus.stAlarms.bHasSafetyStopFault := stInputs.bEventFault;
stStatus.stAlarms.uiActiveCount := 0;
stStatus.stAlarms.eHighestAlarm := E_AlarmId.None;
stStatus.aNest := fbNestManager.GetAllNests();
stStatus.udiAlarmCode := 0;
stStatus.sOperatorMessage := fbOperatorStation.GetMessage();
// Row 0 of the event DataGrid is exclusively the current automatic-cycle instruction.
IF eMachineState = E_MachineState.AutoCycle THEN
    IF fbOperatorStation.GetInstruction() <> E_OperatorInstruction.None THEN
        stStatus.sMachineMessage := fbOperatorStation.GetMessage();
    ELSE
        stStatus.sMachineMessage := stProcessCycleStatus.sMessage;
    END_IF
ELSIF eMachineState = E_MachineState.Manual THEN
    stStatus.sMachineMessage := stManualModeStatus.sMessage;
ELSIF eMachineState = E_MachineState.Initialising THEN
    CASE eInitialisingWaitReason OF
        E_InitialisingWaitReason.SafetyNotReady: stStatus.sMachineMessage := 'System initialising - waiting for Safety OK';
        E_InitialisingWaitReason.FsoeNotReady: stStatus.sMachineMessage := 'System initialising - waiting for FSoE';
        E_InitialisingWaitReason.SafetyLogicNotReady: stStatus.sMachineMessage := 'System initialising - waiting for TwinSAFE logic';
        E_InitialisingWaitReason.IndexBusy: stStatus.sMachineMessage := 'System initialising - waiting for index to stop';
        E_InitialisingWaitReason.TransferNestSupportCylinderNotRetracted: stStatus.sMachineMessage := 'System initialising - waiting for transfer nest support cylinder retract';
        E_InitialisingWaitReason.ProcessStationFaulted: stStatus.sMachineMessage := 'System initialising - process station fault';
        E_InitialisingWaitReason.MainDoorFaulted: stStatus.sMachineMessage := 'System initialising - main door lock fault';
        E_InitialisingWaitReason.PuckLockerFaulted: stStatus.sMachineMessage := 'System initialising - puck locker fault';
        E_InitialisingWaitReason.ProcessEquipmentNotReady: stStatus.sMachineMessage := 'System initialising - waiting for process equipment';
    ELSE stStatus.sMachineMessage := 'System initialising'; END_CASE
ELSIF eMachineState = E_MachineState.ReadyToStart THEN
    stStatus.sMachineMessage := 'Ready to start';
ELSIF eMachineState = E_MachineState.Stopping THEN
    CASE eStoppingWaitReason OF
        E_StoppingWaitReason.IndexStillMoving: stStatus.sMachineMessage := 'System stopping - waiting for index';
        E_StoppingWaitReason.TransferNestSupportCylinderRetracting: stStatus.sMachineMessage := 'System stopping - retracting transfer nest support cylinder';
        E_StoppingWaitReason.ProcessEquipmentStopping: stStatus.sMachineMessage := 'System stopping - stopping process equipment';
        E_StoppingWaitReason.MainDoorTransition: stStatus.sMachineMessage := 'System stopping - waiting for main door lock';
    ELSE stStatus.sMachineMessage := 'System stopping'; END_CASE
ELSIF eMachineState = E_MachineState.Fault THEN
    stStatus.sMachineMessage := 'Machine fault - check active alarms below';
ELSE
    stStatus.sMachineMessage := 'Machine stopped';
END_IF

ePreviousMachineState := eMachineState;
stOutputs := stOutputsInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetCyclicOutputs" Id="{9b31b272-cf95-4c0b-9674-4eee2c2eaa71}">
      <Declaration><![CDATA[METHOD PRIVATE ResetCyclicOutputs]]></Declaration>
      <Implementation>
        <ST><![CDATA[stOutputsInternal.bSafetyRunRequest := FALSE;
stOutputsInternal.bSafetyResetRequest := FALSE;
stOutputsInternal.bAirSupplyEnable := FALSE;
stOutputsInternal.bIndexRotatePortA := FALSE;
stOutputsInternal.bIndexStopPortB := FALSE;
stOutputsInternal.bIndexSupportExtend := FALSE;
stOutputsInternal.bIndexSupportRetract := FALSE;
stOutputsInternal.bTransferNestSupportCylinderExtend := FALSE;
stOutputsInternal.bTransferNestSupportCylinderRetract := FALSE;
stOutputsInternal.bMainDoorLockRequest := FALSE;
stOutputsInternal.bLedStart := FALSE;
stOutputsInternal.bLedReset := FALSE;
stOutputsInternal.bLedPass := FALSE;
stOutputsInternal.bLedFail := FALSE;
stOutputsInternal.bInternalLight := FALSE;
stOutputsInternal.bExternalLight := FALSE;
stOutputsInternal.bPuckLockerPinUp := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>