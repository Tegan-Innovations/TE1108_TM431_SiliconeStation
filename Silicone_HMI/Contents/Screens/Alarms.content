<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onSelectionChanged",
    "actions": [
      {
        "objectType": "SwitchCase",
        "active": false,
        "compare": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/INT",
          "symbolExpression": "%i%EventFilter%/i%"
        },
        "cases": [
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/INT",
              "value": 1
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiDatagrid_14::Filter%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/filter",
                  "value": [
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Fault",
                      "valueType": "tchmi:general#/definitions/String"
                    },
                    {
                      "logic": "OR"
                    },
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Cycle Stop Fault",
                      "valueType": "tchmi:general#/definitions/String"
                    },
                    {
                      "logic": "OR"
                    },
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Cycle Stop Request",
                      "valueType": "tchmi:general#/definitions/String"
                    },
                    {
                      "logic": "OR"
                    },
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Message",
                      "valueType": "tchmi:general#/definitions/String"
                    }
                  ]
                },
                "asyncWait": true
              }
            ]
          },
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/INT",
              "value": 2
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiDatagrid_14::Filter%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/filter",
                  "value": [
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Fault",
                      "valueType": "tchmi:general#/definitions/String"
                    }
                  ]
                },
                "asyncWait": true
              }
            ]
          },
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/INT",
              "value": 3
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiDatagrid_14::Filter%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/filter",
                  "value": [
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Cycle Stop Request",
                      "valueType": "tchmi:general#/definitions/String"
                    }
                  ]
                },
                "asyncWait": true
              }
            ]
          },
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:general#/definitions/INT",
              "value": 4
            },
            "actions": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctrl%TcHmiDatagrid_14::Filter%/ctrl%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:server#/definitions/filter",
                  "value": [
                    {
                      "path": "sType",
                      "comparator": "==",
                      "value": "Message"
                    }
                  ]
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// 1. Capture the components by their exact ID",
          "var cmb = TcHmi.Controls.get('TcHmiCombobox_1');",
          "var grid = TcHmi.Controls.get('TcHmiDatagrid_14');",
          "",
          "console.log(\"=== FILTER DIAGNOSTICS ===\");",
          "console.log(\"ComboBox found?\", !!cmb);",
          "console.log(\"Datagrid found?\", !!grid);",
          "",
          "// Safely wrapping in an if-statement to avoid using illegal top-level return statements",
          "if (cmb && grid) {",
          "    // 2. Capture the selected value from the ComboBox",
          "    var selectedValue = cmb.getSelectedValue();",
          "    console.log(\"Value captured from ComboBox: '\" + selectedValue + \"'\");",
          "",
          "    // 3. Apply or clear the filter based on the selection",
          "    if (selectedValue === 'HISTORY' || !selectedValue) {",
          "        console.log(\"Action: Clearing all filters (Show All)\");",
          "        grid.setFilter(null);",
          "    } else {",
          "        console.log(\"Action: Filtering 'sType' column by '\" + selectedValue + \"'\");",
          "        grid.setFilter([",
          "            {",
          "                \"path\": \"abType\",",
          "                \"comparator\": \"==\",",
          "                \"value\": selectedValue",
          "            }",
          "        ]);",
          "    }",
          "} else {",
          "    console.error(\"Error: One or both components could not be found. Check IDs!\");",
          "}",
          "console.log(\"=============================\");"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

