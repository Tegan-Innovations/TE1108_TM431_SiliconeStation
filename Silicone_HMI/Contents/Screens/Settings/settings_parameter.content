<div id="TcHmiButton_129" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height="30" data-tchmi-height-unit="px" data-tchmi-left="150" data-tchmi-left-unit="px" data-tchmi-text="IVEK" data-tchmi-top="58" data-tchmi-top-unit="px" data-tchmi-width="60" data-tchmi-width-unit="px" data-tchmi-word-wrap="True">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    const symbol =",
          "        '%s%ADS.PLC1.GVL_HMI.bCmdOpenIvekSettings%/s%';",
          "",
          "    const pulseDurationMs = 3000;",
          "",
          "    console.log(",
          "        '[IVEK Launcher] Writing TRUE to:',",
          "        symbol",
          "    );",
          "",
          "    TcHmi.Symbol.writeEx(",
          "        symbol,",
          "        true,",
          "        function (data) {",
          "            if (",
          "                data &&",
          "                data.error !== undefined &&",
          "                data.error !== TcHmi.Errors.NONE",
          "            ) {",
          "                console.error(",
          "                    '[IVEK Launcher] Failed to write TRUE.',",
          "                    data",
          "                );",
          "                return;",
          "            }",
          "",
          "            console.log(",
          "                '[IVEK Launcher] TRUE successfully written.'",
          "            );",
          "",
          "            window.setTimeout(function () {",
          "                console.log(",
          "                    '[IVEK Launcher] Writing FALSE to:',",
          "                    symbol",
          "                );",
          "",
          "                TcHmi.Symbol.writeEx(",
          "                    symbol,",
          "                    false,",
          "                    function (resetData) {",
          "                        if (",
          "                            resetData &&",
          "                            resetData.error !== undefined &&",
          "                            resetData.error !== TcHmi.Errors.NONE",
          "                        ) {",
          "                            console.error(",
          "                                '[IVEK Launcher] Failed to write FALSE.',",
          "                                resetData",
          "                            );",
          "                            return;",
          "                        }",
          "",
          "                        console.log(",
          "                            '[IVEK Launcher] FALSE successfully written.'",
          "                        );",
          "                    }",
          "                );",
          "            }, pulseDurationMs);",
          "        }",
          "    );",
          "})();"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
