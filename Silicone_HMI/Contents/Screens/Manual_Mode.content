<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%ADS.PLC1.PRG_MachineControl.stKistler_Status.bBusy%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%ADS.PLC1.PRG_MachineControl.stKistler_Status.bBusy%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "(function () {",
                  "    var control = TcHmi.Controls.get('TcHmiImage_21');",
                  "",
                  "    if (!control) {",
                  "        console.error('Control TcHmiImage_21 was not found.');",
                  "        return;",
                  "    }",
                  "",
                  "    if (typeof control.setTopUnit === 'function') {",
                  "        control.setTopUnit('%');",
                  "    }",
                  "",
                  "    function moveY(from, to, duration, callback) {",
                  "        var startTime = null;",
                  "",
                  "        function animate(currentTime) {",
                  "            if (startTime === null) {",
                  "                startTime = currentTime;",
                  "            }",
                  "",
                  "            var elapsedTime = currentTime - startTime;",
                  "            var progress = Math.min(elapsedTime / duration, 1);",
                  "",
                  "            var easedProgress =",
                  "                progress < 0.5",
                  "                    ? 2 * progress * progress",
                  "                    : 1 - Math.pow(-2 * progress + 2, 2) / 2;",
                  "",
                  "            var currentPosition =",
                  "                from + (to - from) * easedProgress;",
                  "",
                  "            control.setTop(currentPosition);",
                  "",
                  "            if (progress < 1) {",
                  "                window.requestAnimationFrame(animate);",
                  "            } else if (typeof callback === 'function') {",
                  "                callback();",
                  "            }",
                  "        }",
                  "",
                  "        window.requestAnimationFrame(animate);",
                  "    }",
                  "",
                  "    control.setTop(0);",
                  "",
                  "    moveY(12, 17, 1000, function () {",
                  "        moveY(17, 12, 1000);",
                  "    });",
                  "})();"
                ],
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": false,
        "sourceLines": [
          "(function () {",
          "    var control = TcHmi.Controls.get('TcHmiImage_21');",
          "",
          "    if (!control) {",
          "        console.error('Control TcHmiImage_21 was not found.');",
          "        return;",
          "    }",
          "",
          "    if (typeof control.setTopUnit === 'function') {",
          "        control.setTopUnit('%');",
          "    }",
          "",
          "    function moveY(from, to, duration, callback) {",
          "        var startTime = null;",
          "",
          "        function animate(currentTime) {",
          "            if (startTime === null) {",
          "                startTime = currentTime;",
          "            }",
          "",
          "            var elapsedTime = currentTime - startTime;",
          "            var progress = Math.min(elapsedTime / duration, 1);",
          "",
          "            var easedProgress =",
          "                progress < 0.5",
          "                    ? 2 * progress * progress",
          "                    : 1 - Math.pow(-2 * progress + 2, 2) / 2;",
          "",
          "            var currentPosition =",
          "                from + (to - from) * easedProgress;",
          "",
          "            control.setTop(currentPosition);",
          "",
          "            if (progress < 1) {",
          "                window.requestAnimationFrame(animate);",
          "            } else if (typeof callback === 'function') {",
          "                callback();",
          "            }",
          "        }",
          "",
          "        window.requestAnimationFrame(animate);",
          "    }",
          "",
          "    control.setTop(0);",
          "",
          "    moveY(12, 18, 1000, function () {",
          "        moveY(18, 12, 1000);",
          "    });",
          "})();"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
