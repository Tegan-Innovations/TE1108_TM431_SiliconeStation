<div id="IndexKistler_2" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-tchmi-height="250" data-tchmi-height-unit="px" data-tchmi-left="37" data-tchmi-left-unit="px" data-tchmi-src="Images/Project/SiliconeIndexTable.png" data-tchmi-top="37" data-tchmi-top-unit="px" data-tchmi-width="255" data-tchmi-width-unit="px" data-tchmi-zindex="5">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%ADS.PLC1.GVL_MASTER.stNestTable.bNestReadySensor%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%ADS.PLC1.GVL_MASTER.stNestTable.bNestReadySensor%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "(function () {",
                  "    var control = TcHmi.Controls.get('IndexKistler_2');",
                  "",
                  "    if (!control) {",
                  "        console.error('Control IndexKistler_1 was not found.');",
                  "        return;",
                  "    }",
                  "",
                  "    TcHmi.Symbol.readEx2(",
                  "        '%s%ADS.PLC1.GVL_HMI.iNestRotationAngle%/s%',",
                  "        function (data) {",
                  "            if (data.error !== TcHmi.Errors.NONE) {",
                  "                console.error(",
                  "                    'Error reading iNestRotationAngle:',",
                  "                    data.error",
                  "                );",
                  "                return;",
                  "            }",
                  "",
                  "            var plcAngle = Number(data.value);",
                  "",
                  "            if (isNaN(plcAngle)) {",
                  "                console.error(",
                  "                    'Invalid nest rotation angle:',",
                  "                    data.value",
                  "                );",
                  "                return;",
                  "            }",
                  "",
                  "            /*",
                  "             * Inverte o ângulo recebido do PLC para que a imagem",
                  "             * gire no sentido anti-horário.",
                  "             *",
                  "             * PLC:",
                  "             * 0°   -> HMI 0°",
                  "             * 90°  -> HMI 270°",
                  "             * 180° -> HMI 180°",
                  "             * 270° -> HMI 90°",
                  "             */",
                  "            var targetNormalized =",
                  "                ((-plcAngle % 360) + 360) % 360;",
                  "",
                  "            /*",
                  "             * Na primeira execução, sincroniza diretamente",
                  "             * a imagem com o ângulo do PLC.",
                  "             */",
                  "            if (",
                  "                typeof window.indexKistlerCurrentAngle !== 'number'",
                  "            ) {",
                  "                window.indexKistlerCurrentAngle =",
                  "                    targetNormalized;",
                  "",
                  "                control.setTransform([",
                  "                    {",
                  "                        transformType: 'Rotate',",
                  "                        angleUnit: 'deg',",
                  "                        angle: targetNormalized",
                  "                    }",
                  "                ]);",
                  "",
                  "                return;",
                  "            }",
                  "",
                  "            /*",
                  "             * Interrompe a animação anterior caso uma nova",
                  "             * posição seja recebida.",
                  "             */",
                  "            if (window.indexKistlerAnimationFrame) {",
                  "                window.cancelAnimationFrame(",
                  "                    window.indexKistlerAnimationFrame",
                  "                );",
                  "",
                  "                window.indexKistlerAnimationFrame = null;",
                  "            }",
                  "",
                  "            var startAngle =",
                  "                window.indexKistlerCurrentAngle;",
                  "",
                  "            var startNormalized =",
                  "                ((startAngle % 360) + 360) % 360;",
                  "",
                  "            /*",
                  "             * Calcula o menor deslocamento entre a posição",
                  "             * atual e a nova posição.",
                  "             *",
                  "             * Como o ângulo do PLC foi invertido, o movimento",
                  "             * visual ocorre no sentido anti-horário.",
                  "             */",
                  "            var movement =",
                  "                (",
                  "                    targetNormalized -",
                  "                    startNormalized +",
                  "                    540",
                  "                ) % 360 - 180;",
                  "",
                  "            /*",
                  "             * Mantém o ângulo acumulado para evitar que a imagem",
                  "             * retorne no sentido errado ao passar de 0° para 270°.",
                  "             */",
                  "            var targetAngle =",
                  "                startAngle + movement;",
                  "",
                  "            var duration = 500;",
                  "            var startTime = null;",
                  "",
                  "            function animate(currentTime) {",
                  "                if (startTime === null) {",
                  "                    startTime = currentTime;",
                  "                }",
                  "",
                  "                var progress = Math.min(",
                  "                    (currentTime - startTime) / duration,",
                  "                    1",
                  "                );",
                  "",
                  "                /*",
                  "                 * Aceleração e desaceleração suaves.",
                  "                 */",
                  "                var easedProgress =",
                  "                    progress < 0.5",
                  "                        ? 2 * progress * progress",
                  "                        : 1 -",
                  "                          Math.pow(",
                  "                              -2 * progress + 2,",
                  "                              2",
                  "                          ) / 2;",
                  "",
                  "                var animatedAngle =",
                  "                    startAngle +",
                  "                    (targetAngle - startAngle) *",
                  "                    easedProgress;",
                  "",
                  "                control.setTransform([",
                  "                    {",
                  "                        transformType: 'Rotate',",
                  "                        angleUnit: 'deg',",
                  "                        angle: animatedAngle",
                  "                    }",
                  "                ]);",
                  "",
                  "                window.indexKistlerCurrentAngle =",
                  "                    animatedAngle;",
                  "",
                  "                if (progress < 1) {",
                  "                    window.indexKistlerAnimationFrame =",
                  "                        window.requestAnimationFrame(",
                  "                            animate",
                  "                        );",
                  "                } else {",
                  "                    /*",
                  "                     * Garante a posição final exata.",
                  "                     */",
                  "                    window.indexKistlerCurrentAngle =",
                  "                        targetAngle;",
                  "",
                  "                    control.setTransform([",
                  "                        {",
                  "                            transformType: 'Rotate',",
                  "                            angleUnit: 'deg',",
                  "                            angle: targetAngle",
                  "                        }",
                  "                    ]);",
                  "",
                  "                    window.indexKistlerAnimationFrame = null;",
                  "                }",
                  "            }",
                  "",
                  "            window.indexKistlerAnimationFrame =",
                  "                window.requestAnimationFrame(animate);",
                  "        }",
                  "    );",
                  "})();"
                ],
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
</div>
