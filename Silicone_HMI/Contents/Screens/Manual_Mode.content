<div id="IndexKistler_2" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-tchmi-height="250" data-tchmi-height-unit="px" data-tchmi-left="37" data-tchmi-left-unit="px" data-tchmi-src="Imports/Images/IndexKistler_1.png" data-tchmi-top="37" data-tchmi-top-unit="px" data-tchmi-width="255" data-tchmi-width-unit="px" data-tchmi-zindex="5">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%ADS.PLC1.GVL_MASTER.stNestTable.bNestReadySensor%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%ADS.PLC1.GVL_MASTER.stNestTable.bNestReadySensor%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "(function () {",
                  "    var control = TcHmi.Controls.get('IndexKistler_2');",
                  "",
                  "    if (!control) {",
                  "        console.error('Control IndexKistler_1 was not found.');",
                  "        return;",
                  "    }",
                  "",
                  "    TcHmi.Symbol.readEx2(",
                  "        '%s%ADS.PLC1.GVL_HMI.iNestRotationAngle%/s%',",
                  "        function (data) {",
                  "            if (data.error !== TcHmi.Errors.NONE) {",
                  "                console.error(",
                  "                    'Error reading iNestRotationAngle:',",
                  "                    data.error",
                  "                );",
                  "                return;",
                  "            }",
                  "",
                  "            var plcAngle = Number(data.value);",
                  "",
                  "            if (isNaN(plcAngle)) {",
                  "                console.error(",
                  "                    'Invalid nest rotation angle:',",
                  "                    data.value",
                  "                );",
                  "                return;",
                  "            }",
                  "",
                  "            /*",
                  "             * Inverte o ângulo recebido do PLC para que a imagem",
                  "             * gire no sentido anti-horário.",
                  "             *",
                  "             * PLC:",
                  "             * 0°   -> HMI 0°",
                  "             * 90°  -> HMI 270°",
                  "             * 180° -> HMI 180°",
                  "             * 270° -> HMI 90°",
                  "             */",
                  "            var targetNormalized =",
                  "                ((-plcAngle % 360) + 360) % 360;",
                  "",
                  "            /*",
                  "             * Na primeira execução, sincroniza diretamente",
                  "             * a imagem com o ângulo do PLC.",
                  "             */",
                  "            if (",
                  "                typeof window.indexKistlerCurrentAngle !== 'number'",
                  "            ) {",
                  "                window.indexKistlerCurrentAngle =",
                  "                    targetNormalized;",
                  "",
                  "                control.setTransform([",
                  "                    {",
                  "                        transformType: 'Rotate',",
                  "                        angleUnit: 'deg',",
                  "                        angle: targetNormalized",
                  "                    }",
                  "                ]);",
                  "",
                  "                return;",
                  "            }",
                  "",
                  "            /*",
                  "             * Interrompe a animação anterior caso uma nova",
                  "             * posição seja recebida.",
                  "             */",
                  "            if (window.indexKistlerAnimationFrame) {",
                  "                window.cancelAnimationFrame(",
                  "                    window.indexKistlerAnimationFrame",
                  "                );",
                  "",
                  "                window.indexKistlerAnimationFrame = null;",
                  "            }",
                  "",
                  "            var startAngle =",
                  "                window.indexKistlerCurrentAngle;",
                  "",
                  "            var startNormalized =",
                  "                ((startAngle % 360) + 360) % 360;",
                  "",
                  "            /*",
                  "             * Calcula o menor deslocamento entre a posição",
                  "             * atual e a nova posição.",
                  "             *",
                  "             * Como o ângulo do PLC foi invertido, o movimento",
                  "             * visual ocorre no sentido anti-horário.",
                  "             */",
                  "            var movement =",
                  "                (",
                  "                    targetNormalized -",
                  "                    startNormalized +",
                  "                    540",
                  "                ) % 360 - 180;",
                  "",
                  "            /*",
                  "             * Mantém o ângulo acumulado para evitar que a imagem",
                  "             * retorne no sentido errado ao passar de 0° para 270°.",
                  "             */",
                  "            var targetAngle =",
                  "                startAngle + movement;",
                  "",
                  "            var duration = 500;",
                  "            var startTime = null;",
                  "",
                  "            function animate(currentTime) {",
                  "                if (startTime === null) {",
                  "                    startTime = currentTime;",
                  "                }",
                  "",
                  "                var progress = Math.min(",
                  "                    (currentTime - startTime) / duration,",
                  "                    1",
                  "                );",
                  "",
                  "                /*",
                  "                 * Aceleração e desaceleração suaves.",
                  "                 */",
                  "                var easedProgress =",
                  "                    progress < 0.5",
                  "                        ? 2 * progress * progress",
                  "                        : 1 -",
                  "                          Math.pow(",
                  "                              -2 * progress + 2,",
                  "                              2",
                  "                          ) / 2;",
                  "",
                  "                var animatedAngle =",
                  "                    startAngle +",
                  "                    (targetAngle - startAngle) *",
                  "                    easedProgress;",
                  "",
                  "                control.setTransform([",
                  "                    {",
                  "                        transformType: 'Rotate',",
                  "                        angleUnit: 'deg',",
                  "                        angle: animatedAngle",
                  "                    }",
                  "                ]);",
                  "",
                  "                window.indexKistlerCurrentAngle =",
                  "                    animatedAngle;",
                  "",
                  "                if (progress < 1) {",
                  "                    window.indexKistlerAnimationFrame =",
                  "                        window.requestAnimationFrame(",
                  "                            animate",
                  "                        );",
                  "                } else {",
                  "                    /*",
                  "                     * Garante a posição final exata.",
                  "                     */",
                  "                    window.indexKistlerCurrentAngle =",
                  "                        targetAngle;",
                  "",
                  "                    control.setTransform([",
                  "                        {",
                  "                            transformType: 'Rotate',",
                  "                            angleUnit: 'deg',",
                  "                            angle: targetAngle",
                  "                        }",
                  "                    ]);",
                  "",
                  "                    window.indexKistlerAnimationFrame = null;",
                  "                }",
                  "            }",
                  "",
                  "            window.indexKistlerAnimationFrame =",
                  "                window.requestAnimationFrame(animate);",
                  "        }",
                  "    );",
                  "})();"
                ],
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          },
          {
            "else": []
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onAttached",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "// Keep these lines for IntelliSense in the TwinCAT HMI editor.",
          "/// <reference path=\"./../../../TE1108_Kistler/Packages/Beckhoff.TwinCAT.HMI.Framework.14.3.431/runtimes/native1.12-tchmi/TcHmi.d.ts\" />",
          "/// <reference path=\"./../../../Packages/Beckhoff.TwinCAT.HMI.Framework.14.3.431/runtimes/native1.12-tchmi/TcHmi.d.ts\" />",
          "",
          "(function () {",
          "    'use strict';",
          "",
          "    // ============================================================",
          "    // CONFIGURATION",
          "    // ============================================================",
          "",
          "    const MACHINE_STATE_SYMBOL =",
          "        '%s%ADS.PLC1.GVL_MASTER.stMachineStatus.eMachineState%/s%';",
          "",
          "    const MANUAL_MODE_REQUEST_SYMBOL =",
          "        '%s%ADS.PLC1.GVL_HMI.i_bHMIManualModeRequest%/s%';",
          "",
          "    const MAIN_REGION_ID = 'Main_Region';",
          "",
          "    const MAIN_PAGE =",
          "        'Contents/Screens/Main_Kistler.content';",
          "",
          "    const MANUAL_MODE_PAGE =",
          "        'Contents/Screens/Manual_Mode.content';",
          "",
          "    const MACHINE_STATE_READY_TO_START = 3;",
          "    const MACHINE_STATE_MANUAL_MODE = 6;",
          "",
          "    const MONITOR_INTERVAL_MS = 250;",
          "    const MANUAL_MODE_ENTRY_TIMEOUT_MS = 5000;",
          "",
          "    let monitorInterval = null;",
          "    let monitorReadInProgress = false;",
          "    let waitingForManualMode = false;",
          "",
          "",
          "    // ============================================================",
          "    // VALUE CONVERSION",
          "    // ============================================================",
          "",
          "    function getMachineStateValue(data) {",
          "        if (!data) {",
          "            return null;",
          "        }",
          "",
          "        const rawValue =",
          "            data.value !== undefined",
          "                ? data.value",
          "                : data.result;",
          "",
          "        if (typeof rawValue === 'number') {",
          "            return rawValue;",
          "        }",
          "",
          "        const numericValue = Number(rawValue);",
          "",
          "        if (!Number.isNaN(numericValue)) {",
          "            return numericValue;",
          "        }",
          "",
          "        const stateText =",
          "            String(rawValue).trim().toUpperCase();",
          "",
          "        if (stateText.includes('SYSTEM_READY_TO_START')) {",
          "            return MACHINE_STATE_READY_TO_START;",
          "        }",
          "",
          "        if (stateText.includes('MANUAL_MODE')) {",
          "            return MACHINE_STATE_MANUAL_MODE;",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "",
          "    // ============================================================",
          "    // REGION NAVIGATION",
          "    // ============================================================",
          "",
          "    function getMainRegion() {",
          "        return TcHmi.Controls.get(MAIN_REGION_ID);",
          "    }",
          "",
          "",
          "    function getCurrentPage() {",
          "        const mainRegion = getMainRegion();",
          "",
          "        if (!mainRegion) {",
          "            return null;",
          "        }",
          "",
          "        try {",
          "            if (",
          "                typeof mainRegion.getTargetContent === 'function'",
          "            ) {",
          "                return mainRegion.getTargetContent();",
          "            }",
          "        } catch (error) {",
          "            console.error(",
          "                'Failed to read Main_Region target content:',",
          "                error",
          "            );",
          "        }",
          "",
          "        return null;",
          "    }",
          "",
          "",
          "    window.goToManualModePage = function () {",
          "        try {",
          "            const mainRegion = getMainRegion();",
          "",
          "            if (!mainRegion) {",
          "                console.error(",
          "                    'Main_Region control was not found.'",
          "                );",
          "                return;",
          "            }",
          "",
          "            mainRegion.setTargetContent(MANUAL_MODE_PAGE);",
          "",
          "        } catch (error) {",
          "            console.error(",
          "                'Failed to open Manual Mode page:',",
          "                error",
          "            );",
          "        }",
          "    };",
          "",
          "",
          "    window.goToMainPage = function () {",
          "        try {",
          "            const mainRegion = getMainRegion();",
          "",
          "            if (!mainRegion) {",
          "                console.error(",
          "                    'Main_Region control was not found.'",
          "                );",
          "                return;",
          "            }",
          "",
          "            mainRegion.setTargetContent(MAIN_PAGE);",
          "",
          "        } catch (error) {",
          "            console.error(",
          "                'Failed to open Main page:',",
          "                error",
          "            );",
          "        }",
          "    };",
          "",
          "",
          "    // ============================================================",
          "    // POPUP",
          "    // ============================================================",
          "",
          "    window.closeMainPopup = function () {",
          "        try {",
          "            const popup =",
          "                TcHmi.Controls.get('Main_Popup');",
          "",
          "            if (",
          "                popup &&",
          "                typeof popup.close === 'function'",
          "            ) {",
          "                popup.close();",
          "            }",
          "",
          "        } catch (error) {",
          "            console.error(",
          "                'Failed to close Main_Popup:',",
          "                error",
          "            );",
          "        }",
          "    };",
          "",
          "",
          "    // ============================================================",
          "    // WAIT FOR PLC TO ENTER MANUAL MODE",
          "    // ============================================================",
          "",
          "    function waitForManualMode() {",
          "        if (waitingForManualMode) {",
          "            return;",
          "        }",
          "",
          "        waitingForManualMode = true;",
          "",
          "        const startTime = Date.now();",
          "",
          "        function checkState() {",
          "            TcHmi.Symbol.readEx2(",
          "                MACHINE_STATE_SYMBOL,",
          "                function (data) {",
          "                    if (",
          "                        data.error !== TcHmi.Errors.NONE",
          "                    ) {",
          "                        waitingForManualMode = false;",
          "",
          "                        alert(",
          "                            'HMI Error: Failed to verify ' +",
          "                            'Manual Mode. Code: ' +",
          "                            data.error",
          "                        );",
          "",
          "                        return;",
          "                    }",
          "",
          "                    const machineState =",
          "                        getMachineStateValue(data);",
          "",
          "                    if (",
          "                        machineState ===",
          "                        MACHINE_STATE_MANUAL_MODE",
          "                    ) {",
          "                        waitingForManualMode = false;",
          "",
          "                        window.goToManualModePage();",
          "",
          "                        return;",
          "                    }",
          "",
          "                    if (",
          "                        Date.now() - startTime >=",
          "                        MANUAL_MODE_ENTRY_TIMEOUT_MS",
          "                    ) {",
          "                        waitingForManualMode = false;",
          "",
          "                        alert(",
          "                            'Manual Mode request timed out. ' +",
          "                            'The PLC did not enter Manual Mode.'",
          "                        );",
          "",
          "                        return;",
          "                    }",
          "",
          "                    setTimeout(checkState, 200);",
          "                }",
          "            );",
          "        }",
          "",
          "        checkState();",
          "    }",
          "",
          "",
          "    // ============================================================",
          "    // MANUAL MODE CONFIRMATION",
          "    // ============================================================",
          "",
          "    window.confirmManualMode = function () {",
          "        try {",
          "            TcHmi.Symbol.readEx2(",
          "                MACHINE_STATE_SYMBOL,",
          "                function (dataState) {",
          "                    if (",
          "                        dataState.error !==",
          "                        TcHmi.Errors.NONE",
          "                    ) {",
          "                        window.closeMainPopup();",
          "",
          "                        alert(",
          "                            'HMI Error: Failed to read ' +",
          "                            'Machine State. Code: ' +",
          "                            dataState.error",
          "                        );",
          "",
          "                        return;",
          "                    }",
          "",
          "                    const machineState =",
          "                        getMachineStateValue(dataState);",
          "",
          "                    const isReadyToStart =",
          "                        machineState ===",
          "                        MACHINE_STATE_READY_TO_START;",
          "",
          "                    const isAlreadyManualMode =",
          "                        machineState ===",
          "                        MACHINE_STATE_MANUAL_MODE;",
          "",
          "                    if (isAlreadyManualMode) {",
          "                        window.closeMainPopup();",
          "                        window.goToManualModePage();",
          "",
          "                        return;",
          "                    }",
          "",
          "                    if (!isReadyToStart) {",
          "                        window.closeMainPopup();",
          "",
          "                        alert(",
          "                            'Manual Mode blocked: ' +",
          "                            'the machine must be in ' +",
          "                            'Ready To Start.'",
          "                        );",
          "",
          "                        return;",
          "                    }",
          "",
          "                    TcHmi.Symbol.writeEx2(",
          "                        MANUAL_MODE_REQUEST_SYMBOL,",
          "                        true,",
          "                        function (dataWrite) {",
          "                            if (",
          "                                dataWrite.error !==",
          "                                TcHmi.Errors.NONE",
          "                            ) {",
          "                                alert(",
          "                                    'HMI Error: Failed to ' +",
          "                                    'request Manual Mode. Code: ' +",
          "                                    dataWrite.error",
          "                                );",
          "",
          "                                return;",
          "                            }",
          "",
          "                            /*",
          "                             * Do not open the Manual Mode screen",
          "                             * immediately. Wait until the PLC",
          "                             * actually changes to MANUAL_MODE.",
          "                             */",
          "                            waitForManualMode();",
          "                        }",
          "                    );",
          "",
          "                    window.closeMainPopup();",
          "                }",
          "            );",
          "",
          "        } catch (error) {",
          "            window.closeMainPopup();",
          "",
          "            alert(",
          "                'Fatal Application Exception: ' +",
          "                error.message",
          "            );",
          "        }",
          "    };",
          "",
          "",
          "    // ============================================================",
          "    // AUTOMATIC MANUAL PAGE EXIT",
          "    // ============================================================",
          "",
          "    function monitorManualModePage() {",
          "        if (monitorReadInProgress) {",
          "            return;",
          "        }",
          "",
          "        const currentPage = getCurrentPage();",
          "",
          "        /*",
          "         * Only read the PLC state while the Manual Mode page",
          "         * is currently displayed.",
          "         */",
          "        if (currentPage !== MANUAL_MODE_PAGE) {",
          "            return;",
          "        }",
          "",
          "        monitorReadInProgress = true;",
          "",
          "        TcHmi.Symbol.readEx2(",
          "            MACHINE_STATE_SYMBOL,",
          "            function (data) {",
          "                monitorReadInProgress = false;",
          "",
          "                if (",
          "                    data.error !== TcHmi.Errors.NONE",
          "                ) {",
          "                    console.error(",
          "                        'Failed to monitor Machine State:',",
          "                        data.error",
          "                    );",
          "",
          "                    return;",
          "                }",
          "",
          "                const machineState =",
          "                    getMachineStateValue(data);",
          "",
          "                /*",
          "                 * As soon as the PLC leaves MANUAL_MODE,",
          "                 * return the operator to the main screen.",
          "                 */",
          "                if (",
          "                    machineState !==",
          "                    MACHINE_STATE_MANUAL_MODE",
          "                ) {",
          "                    window.goToMainPage();",
          "                }",
          "            }",
          "        );",
          "    }",
          "",
          "",
          "    function startManualModeMonitor() {",
          "        if (monitorInterval !== null) {",
          "            return;",
          "        }",
          "",
          "        monitorInterval = setInterval(",
          "            monitorManualModePage,",
          "            MONITOR_INTERVAL_MS",
          "        );",
          "    }",
          "",
          "",
          "    // ============================================================",
          "    // INITIALIZATION",
          "    // ============================================================",
          "",
          "    const destroyOnInitialized =",
          "        TcHmi.EventProvider.register(",
          "            'onInitialized',",
          "            function (event) {",
          "                if (",
          "                    typeof destroyOnInitialized ===",
          "                    'function'",
          "                ) {",
          "                    destroyOnInitialized();",
          "                }",
          "",
          "                startManualModeMonitor();",
          "            }",
          "        );",
          "",
          "})();"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
<div id="TcHmiContainer_66" data-tchmi-type="TcHmi.Controls.System.TcHmiContainer" data-tchmi-height="410" data-tchmi-height-unit="px" data-tchmi-left="30" data-tchmi-left-unit="px" data-tchmi-top="40" data-tchmi-top-unit="px" data-tchmi-width="330" data-tchmi-width-unit="px" data-tchmi-zindex="5" data-tchmi-is-enabled="False">
