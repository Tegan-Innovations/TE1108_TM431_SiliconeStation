<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_MASTER" Id="{d8cdc899-ad9f-4304-82d7-52ea9c20ba14}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // Single logical boundary used by the application and reusable FBs.
    stInputs        : ST_MachineInputs;
    stOutputs       : ST_MachineOutputs;
    stCommand       : ST_MachineCommand;
    stStatus        : ST_MachineStatus;

    // IVEK logical process image after EtherNet/IP mapping.
    stIvekInput     : ST_IvekCyclicInput;
    stIvekOutput    : ST_IvekCyclicOutput;
    bIvekCommsOk    : BOOL;

    // Event system shared with TcHMI alarm grids.
    stStationEvents     : ARRAY[0..4] OF ST_StationEvents;
    stEventsAssigment   : ST_EventsAssigmentGeneral;
    astActiveEvents     : ARRAY[0..50] OF ST_ActiveEvents;
    sSystemTime         : STRING(255);
    sSystemDate         : STRING(255);
    bMachineFault       : BOOL;
    bCycleStopRequest   : BOOL;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>