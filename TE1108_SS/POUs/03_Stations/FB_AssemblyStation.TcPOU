    <Method Name="RequestReset" Id="{ca408c3f-ace4-42a7-93a1-ea3f25d9d23f}">
      <Declaration><![CDATA[METHOD PUBLIC RequestReset
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bResetRequest := TRUE;]]></ST>
