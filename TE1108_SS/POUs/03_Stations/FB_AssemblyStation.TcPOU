    </Method>
    <Method Name="RequestStart" Id="{b709cea2-7aee-43ce-b498-1c542bf332e4}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStart : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestStart := FALSE;
IF eState = E_AssemblyStationState.Idle
    AND NOT stStatusInternal.bFaulted
THEN
    bStartRequest := TRUE;
    RequestStart := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
