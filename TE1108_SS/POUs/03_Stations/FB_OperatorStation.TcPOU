<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_OperatorStation" Id="{2c967b62-a173-4dd3-9c1d-bfbb663c0215}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OperatorStation
VAR
    eState                    : E_OperatorExchangeState := E_OperatorExchangeState.Idle;
    eInstruction              : E_OperatorInstruction;
    sMessage                  : STRING(255);
    stStatusInternal          : ST_OperatorStationStatus;
    bExchangeComplete         : BOOL;
    bPartRemovedConfirmed     : BOOL;
    bRejectConfirmed          : BOOL;
    bRejectArmed              : BOOL;
    bRejectEdgeAccepted       : BOOL;
    bPreviousRejectSensor     : BOOL;
    bRejectPulse              : BOOL;
	bAnyPartPresent 		  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{0c713c3d-a462-493a-8e33-fea5d7ea48d3}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bAutomaticActive       			: BOOL;
    bIndexStable           			: BOOL;
    stOperatorNest         			: ST_Nest;
    bGearboxAssemblyPartPresent   	: BOOL;
    bRejectChutePartPresent     	: BOOL;
    bRequireRejectConfirm  			: BOOL;
    bAllowEmptyNestIndex   			: BOOL;
	bReservoirPartPresent  			: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================
// OPERATOR EXCHANGE CONTROL
// =========================================================

// Detect whether any physical part is currently present
// at the operator station.
bAnyPartPresent :=
    bGearboxAssemblyPartPresent
    OR bReservoirPartPresent;


// =========================================================
// REJECT EDGE DETECTION
// =========================================================

// Reject confirmation is intentionally edge-based.
//
// The reject input must return LOW after the operator nest
// becomes empty before a new reject confirmation is accepted.
//
// This prevents an already-active reject sensor from being
// incorrectly accepted for the current failed part.
bRejectPulse :=
    bRejectChutePartPresent
    AND NOT bPreviousRejectSensor;

bPreviousRejectSensor :=
    bRejectChutePartPresent;

bRejectEdgeAccepted := FALSE;


// =========================================================
// OPERATOR EXCHANGE STATE MACHINE
// =========================================================

IF NOT bAutomaticActive THEN

    eState :=
        E_OperatorExchangeState.Idle;

    bExchangeComplete := FALSE;
    bPartRemovedConfirmed := FALSE;
    bRejectConfirmed := FALSE;
    bRejectArmed := FALSE;

    eInstruction :=
        E_OperatorInstruction.None;

    sMessage := '';

ELSE

    CASE eState OF


        // =====================================================
        // IDLE
        // =====================================================

        E_OperatorExchangeState.Idle:

            bExchangeComplete := FALSE;

            eInstruction :=
                E_OperatorInstruction.None;

            sMessage := '';

            IF bIndexStable THEN

                eState :=
                    E_OperatorExchangeState.EvaluateNest;

            END_IF


        // =====================================================
        // EVALUATE OPERATOR NEST
        // =====================================================

        E_OperatorExchangeState.EvaluateNest:

            bExchangeComplete := FALSE;

            bPartRemovedConfirmed := FALSE;
            bRejectConfirmed := FALSE;
            bRejectArmed := FALSE;


            // -------------------------------------------------
            // Previous processed result exists.
            // -------------------------------------------------

            IF stOperatorNest.stResult.bValid THEN


                // ---------------------------------------------
                // Processed part is still physically present.
                // ---------------------------------------------

                IF bAnyPartPresent THEN

                    eState :=
                        E_OperatorExchangeState.WaitingForPartRemoval;


                // ---------------------------------------------
                // Processed part is already absent.
                // ---------------------------------------------

                ELSE

                    bPartRemovedConfirmed := TRUE;


                    // Failed part still requires reject
                    // confirmation when enabled.
                    IF NOT stOperatorNest.stResult.bPassed
                       AND bRequireRejectConfirm THEN

                        eState :=
                            E_OperatorExchangeState.WaitingForRejectConfirmation;


                    // Passed part or reject confirmation disabled.
                    ELSE

                        eState :=
                            E_OperatorExchangeState.WaitingForPartLoading;

                    END_IF

                END_IF


            // -------------------------------------------------
            // No previous processed result.
            // -------------------------------------------------

            ELSE

                eState :=
                    E_OperatorExchangeState.WaitingForPartLoading;

            END_IF


        // =====================================================
        // WAITING FOR PART REMOVAL
        // =====================================================

        E_OperatorExchangeState.WaitingForPartRemoval:


            // -------------------------------------------------
            // Operator instruction.
            // -------------------------------------------------

            IF stOperatorNest.stResult.bPassed THEN

                eInstruction :=
                    E_OperatorInstruction.RemovePassedPart;

                sMessage :=
                    'Remove passed part from operator nest';

            ELSE

                eInstruction :=
                    E_OperatorInstruction.RemoveFailedPart;

                sMessage :=
                    'Remove failed part from operator nest';

            END_IF


            // -------------------------------------------------
            // Wait until the processed part is physically gone.
            // -------------------------------------------------

            IF NOT bAnyPartPresent THEN

                bPartRemovedConfirmed := TRUE;

                // Reject confirmation must always start
                // disarmed after part removal.
                bRejectArmed := FALSE;


                // ---------------------------------------------
                // Failed part requires reject confirmation.
                // ---------------------------------------------

                IF NOT stOperatorNest.stResult.bPassed
                   AND bRequireRejectConfirm THEN

                    eState :=
                        E_OperatorExchangeState.WaitingForRejectConfirmation;


                // ---------------------------------------------
                // Passed part can continue directly to loading.
                // ---------------------------------------------

                ELSE

                    eState :=
                        E_OperatorExchangeState.WaitingForPartLoading;

                END_IF

            END_IF


        // =====================================================
        // WAITING FOR REJECT CONFIRMATION
        // =====================================================

        E_OperatorExchangeState.WaitingForRejectConfirmation:

            eInstruction :=
                E_OperatorInstruction.PlacePartInRejectBin;


            // -------------------------------------------------
            // Reject sensor must first become LOW.
            //
            // This prevents an object that was already present
            // in the reject chute from confirming the new reject.
            // -------------------------------------------------

            IF NOT bRejectChutePartPresent THEN

                bRejectArmed := TRUE;

            END_IF


            // -------------------------------------------------
            // Operator message.
            // -------------------------------------------------

            IF NOT bRejectArmed THEN

                sMessage :=
                    'Remove failed part from reject bin, then place it back after the nest is empty';

            ELSE

                sMessage :=
                    'Place failed part into reject station';

            END_IF


            // -------------------------------------------------
            // Accept a new LOW -> HIGH reject sensor transition.
            // -------------------------------------------------

            IF bPartRemovedConfirmed
               AND bRejectArmed
               AND bRejectPulse THEN

                bRejectConfirmed := TRUE;
                bRejectEdgeAccepted := TRUE;

            END_IF


            // -------------------------------------------------
            // Rejected part disposition completed.
            // Continue with loading the next part.
            // -------------------------------------------------

            IF bPartRemovedConfirmed
               AND bRejectConfirmed THEN

                eState :=
                    E_OperatorExchangeState.WaitingForPartLoading;

            END_IF


        // =====================================================
        // WAITING FOR PART LOADING
        // =====================================================

        E_OperatorExchangeState.WaitingForPartLoading:


            // -------------------------------------------------
            // Empty nest indexing is allowed.
            // -------------------------------------------------

            IF bAllowEmptyNestIndex THEN

                eInstruction :=
                    E_OperatorInstruction.ReadyToIndexEmpty;

                sMessage :=
                    'Load new part or continue with empty nest';

                bExchangeComplete := TRUE;

                eState :=
                    E_OperatorExchangeState.ExchangeComplete;


            // -------------------------------------------------
            // New part is required.
            // -------------------------------------------------

            ELSE

                eInstruction :=
                    E_OperatorInstruction.LoadPart;

                sMessage :=
                    'Load new part into operator nest';


                IF bAnyPartPresent THEN

                    bExchangeComplete := TRUE;

                    eState :=
                        E_OperatorExchangeState.ExchangeComplete;

                END_IF

            END_IF


        // =====================================================
        // EXCHANGE COMPLETE
        // =====================================================

        E_OperatorExchangeState.ExchangeComplete:

            eInstruction :=
                E_OperatorInstruction.ReadyToIndex;

            sMessage :=
                'Operator exchange complete - press two-hand buttons to index';

            // Keep the index permission active until the
            // table physically starts moving.
            bExchangeComplete := TRUE;


            IF NOT bIndexStable THEN

                eState :=
                    E_OperatorExchangeState.WaitingForTableIndexComplete;

            END_IF


        // =====================================================
        // WAITING FOR TABLE INDEX COMPLETE
        // =====================================================

        E_OperatorExchangeState.WaitingForTableIndexComplete:

            eInstruction :=
                E_OperatorInstruction.TableIndexing;

            sMessage :=
                'Table index in progress';


            // Table has finished indexing and is stable again.
            IF bIndexStable THEN

                bExchangeComplete := FALSE;

                bPartRemovedConfirmed := FALSE;
                bRejectConfirmed := FALSE;
                bRejectArmed := FALSE;

                eState :=
                    E_OperatorExchangeState.EvaluateNest;

            END_IF


        // =====================================================
        // FAULT
        // =====================================================

        E_OperatorExchangeState.Fault:

            bExchangeComplete := FALSE;

            eInstruction :=
                E_OperatorInstruction.None;

            sMessage :=
                'Operator exchange fault';


    END_CASE

END_IF


// =========================================================
// STATUS MAPPING
// =========================================================

stStatusInternal.eState :=
    eState;

stStatusInternal.eInstruction :=
    eInstruction;

stStatusInternal.bExchangeComplete :=
    bExchangeComplete;


// Index is permitted only while the operator exchange
// has explicitly reached ExchangeComplete.
stStatusInternal.bIndexPermissive :=
    bExchangeComplete
    AND
    eState = E_OperatorExchangeState.ExchangeComplete;


stStatusInternal.bPartRemovedConfirmed :=
    bPartRemovedConfirmed;

stStatusInternal.bRejectConfirmed :=
    bRejectConfirmed;

stStatusInternal.bRejectArmed :=
    bRejectArmed;

stStatusInternal.bRejectEdgeAccepted :=
    bRejectEdgeAccepted;


// TRUE while waiting for the reject sensor to return LOW
// before accepting the next reject edge.
stStatusInternal.bRejectWaitingForClear :=
    (
        eState =
            E_OperatorExchangeState.WaitingForRejectConfirmation
    )
    AND NOT bRejectArmed;


stStatusInternal.bGearboxAssemblyPartPresent :=
    bGearboxAssemblyPartPresent;

stStatusInternal.bRejectChutePartPresent :=
    bRejectChutePartPresent;

stStatusInternal.bResultValid :=
    stOperatorNest.stResult.bValid;

stStatusInternal.bResultPassed :=
    stOperatorNest.stResult.bPassed;

stStatusInternal.sMessage :=
    sMessage;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetInstruction" Id="{2034d533-b044-4c41-a727-b56a5384cce6}">
      <Declaration><![CDATA[METHOD PUBLIC GetInstruction : E_OperatorInstruction
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetInstruction := eInstruction;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMessage" Id="{f4a3f09e-742b-4482-b624-2cff7a47a468}">
      <Declaration><![CDATA[METHOD PUBLIC GetMessage : STRING(255)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetMessage := sMessage;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetState" Id="{06e24a3c-75a3-4ce3-adc8-f813c2b175e6}">
      <Declaration><![CDATA[METHOD PUBLIC GetState : E_OperatorExchangeState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetState := eState;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetStatus" Id="{ec2efa24-24b7-4fad-b980-a91c4f46131d}">
      <Declaration><![CDATA[METHOD PUBLIC GetStatus : ST_OperatorStationStatus
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetStatus := stStatusInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IndexPermissive" Id="{aa2cf093-7c9d-46e0-bfb7-4810ac3575fe}">
      <Declaration><![CDATA[METHOD PUBLIC IndexPermissive : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IndexPermissive := bExchangeComplete AND eState = E_OperatorExchangeState.ExchangeComplete;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsComplete" Id="{55505d0e-8d4e-411a-a4e9-96c98a1d4c97}">
      <Declaration><![CDATA[METHOD PUBLIC IsComplete : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsComplete := bExchangeComplete;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>