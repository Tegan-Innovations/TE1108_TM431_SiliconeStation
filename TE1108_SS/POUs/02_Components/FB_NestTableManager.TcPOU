<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_NestTableManager" Id="{09f0063d-2876-4ea3-8f96-9e3892567937}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NestTableManager
VAR
    aNestInternal          : ARRAY[1..4] OF ST_Nest;
	aNestStatisticsInternal: ARRAY[1..4] OF ST_NestStatistics;
	udiTotalTestsInternal  : UDINT;
	udiGoodPartsInternal   : UDINT;
	udiBadPartsInternal    : UDINT;
	
    bInitialised           : BOOL;
    bPreviousIndexComplete : BOOL;
    bIndexCompletePulse    : BOOL;
    i                      : INT;
    uiNest                 : UINT;
END_VAR

VAR RETAIN
    aPositionToNest        : ARRAY[1..4] OF UINT := [1,2,3,4];
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ClearOperatorNest" Id="{d4dc5783-ebb9-4f71-bf6e-3c634e383e9d}">
      <Declaration><![CDATA[METHOD PUBLIC ClearOperatorNest
VAR_INPUT ePosition : E_TablePosition; END_VAR
VAR uiId : UINT; END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[uiId := GetNestIdAtPosition(ePosition);

IF uiId >= 1 AND uiId <= 4 THEN

    // Clear Silicone result
    aNestInternal[uiId].stSiliconeResult.bValid := FALSE;
    aNestInternal[uiId].stSiliconeResult.bPassed := FALSE;

    // Clear Assembly result
    aNestInternal[uiId].stAssemblyResult.bValid := FALSE;
    aNestInternal[uiId].stAssemblyResult.bPassed := FALSE;

    // Clear final result
    aNestInternal[uiId].stResult.bValid := FALSE;
    aNestInternal[uiId].stResult.bPassed := FALSE;

    // Reset process tracking
    aNestInternal[uiId].bProcessComplete := FALSE;
    aNestInternal[uiId].bProcessRequired := FALSE;

    // Reset disposition tracking
    aNestInternal[uiId].bDispositionSent := FALSE;
    aNestInternal[uiId].bOperatorExchangeComplete := FALSE;
    aNestInternal[uiId].eDisposition := E_PartDisposition.None;
	
	// Reset statistics tracking for the next part
	aNestInternal[uiId].bStatisticsCounted := FALSE;
	
	aNestInternal[uiId].stSiliconeResult.bValid := FALSE;
	aNestInternal[uiId].stSiliconeResult.bPassed := FALSE;
	
	aNestInternal[uiId].stAssemblyResult.bValid := FALSE;
	aNestInternal[uiId].stAssemblyResult.bPassed := FALSE;
	
	aNestInternal[uiId].stResult.bValid := FALSE;
	aNestInternal[uiId].stResult.bPassed := FALSE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountStatisticsAtPosition" Id="{8b3cd375-588b-4820-ae93-12542215e418}">
      <Declaration><![CDATA[METHOD PUBLIC CountStatisticsAtPosition : BOOL
VAR_INPUT
    ePosition : E_TablePosition;
END_VAR

VAR
    uiId : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CountStatisticsAtPosition := FALSE;

uiId := GetNestIdAtPosition(ePosition);

IF uiId >= 1 AND uiId <= 4 THEN

    // Count only a valid final result that has not
    // already been counted for the current part.
    IF aNestInternal[uiId].stResult.bValid
        AND NOT aNestInternal[uiId].bStatisticsCounted
    THEN

        // Total completed parts for this physical nest.
        aNestStatisticsInternal[uiId].udiTotalTests :=
            aNestStatisticsInternal[uiId].udiTotalTests + 1;

        udiTotalTestsInternal :=
            udiTotalTestsInternal + 1;


        // GOOD / BAD
        IF aNestInternal[uiId].stResult.bPassed THEN

            aNestStatisticsInternal[uiId].udiGoodParts :=
                aNestStatisticsInternal[uiId].udiGoodParts + 1;

            udiGoodPartsInternal :=
                udiGoodPartsInternal + 1;

        ELSE

            aNestStatisticsInternal[uiId].udiBadParts :=
                aNestStatisticsInternal[uiId].udiBadParts + 1;

            udiBadPartsInternal :=
                udiBadPartsInternal + 1;

        END_IF


        // Prevent counting the same part again while
        // the table remains at the operator position.
        aNestInternal[uiId].bStatisticsCounted := TRUE;

        CountStatisticsAtPosition := TRUE;

    END_IF

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic" Id="{de27be2a-8360-45f0-a441-d7a982c88486}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bIndexStable                   : BOOL;
    bIndexComplete                 : BOOL;
    bIndexSamePositionDetected     : BOOL;

    eIndexPosition                 : E_TablePosition;

    bGearboxAssemblyPartPresent    : BOOL;
    bReservoirPartPresent          : BOOL;
    eOperatorPosition              : E_TablePosition;
    aNestEnabled                   : ARRAY[1..4] OF BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================
// INITIALISATION
// =========================================================

IF NOT bInitialised THEN

    // ---------------------------------------------------------
    // INITIALISE NEST IDENTITIES
    // ---------------------------------------------------------
    FOR i := 1 TO 4 DO

        aNestInternal[i].nId :=
            INT_TO_UINT(i);

        aNestInternal[i].bEnabled :=
            aNestEnabled[i];

    END_FOR

    bInitialised := TRUE;

END_IF



// =========================================================
// NEST ENABLE SETTINGS
// =========================================================

FOR i := 1 TO 4 DO

    aNestInternal[i].bEnabled :=
        aNestEnabled[i];

END_FOR



// =========================================================
// ABSOLUTE NEST POSITION SYNCHRONISATION
// =========================================================
//
// eIndexPosition identifies which physical nest is currently
// located at the reference/operator position.
//
// Position 1 = Operator
// Position 3 = Silicone
// Position 4 = Assembly
//
// The complete table layout is reconstructed from this
// absolute reference.
// =========================================================

IF bIndexStable
    AND eIndexPosition <> E_TablePosition.Unknown
THEN

    CASE eIndexPosition OF

        // Nest 1 is currently at Operator / Position 1
        E_TablePosition.Position1:

            aPositionToNest[1] := 1;
            aPositionToNest[2] := 4;
            aPositionToNest[3] := 3;
            aPositionToNest[4] := 2;


        // Nest 2 is currently at Operator / Position 1
        E_TablePosition.Position2:

            aPositionToNest[1] := 2;
            aPositionToNest[2] := 1;
            aPositionToNest[3] := 4;
            aPositionToNest[4] := 3;


        // Nest 3 is currently at Operator / Position 1
        E_TablePosition.Position3:

            aPositionToNest[1] := 3;
            aPositionToNest[2] := 2;
            aPositionToNest[3] := 1;
            aPositionToNest[4] := 4;


        // Nest 4 is currently at Operator / Position 1
        E_TablePosition.Position4:

            aPositionToNest[1] := 4;
            aPositionToNest[2] := 3;
            aPositionToNest[3] := 2;
            aPositionToNest[4] := 1;

    END_CASE

END_IF



// =========================================================
// UPDATE CURRENT POSITION OF EACH NEST
// =========================================================

IF bIndexStable
    AND eIndexPosition <> E_TablePosition.Unknown
THEN

    FOR i := 1 TO 4 DO

        aNestInternal[
            aPositionToNest[i]
        ].ePosition :=
            UINT_TO_E_TablePosition(
                INT_TO_UINT(i)
            );

    END_FOR

END_IF



// =========================================================
// RESET NEST EDGE PULSES
// =========================================================

FOR i := 1 TO 4 DO

    aNestInternal[i].bPartLoadedPulse :=
        FALSE;

    aNestInternal[i].bPartRemovedPulse :=
        FALSE;

END_FOR



// =========================================================
// OPERATOR STATION PART TRACKING
// =========================================================

IF bIndexStable THEN

    uiNest :=
        aPositionToNest[
            TO_UINT(eOperatorPosition)
        ];

    aNestInternal[uiNest].bPartLoadedPulse :=
        bGearboxAssemblyPartPresent
        AND NOT
            aNestInternal[uiNest].bPreviousPartPresent;

    aNestInternal[uiNest].bPartRemovedPulse :=
        NOT bGearboxAssemblyPartPresent
        AND
            aNestInternal[uiNest].bPreviousPartPresent;

    aNestInternal[uiNest].bPreviousPartPresent :=
        bGearboxAssemblyPartPresent;

    aNestInternal[uiNest].bGearboxAssemblyPartPresent :=
        bGearboxAssemblyPartPresent;

    aNestInternal[uiNest].bReservoirPartPresent :=
        bReservoirPartPresent;

END_IF

// =========================================================
// NEST PART COMPLETENESS
// =========================================================

FOR i := 1 TO 4 DO

    aNestInternal[i].bPartComplete :=
        aNestInternal[i].bGearboxAssemblyPartPresent
        AND aNestInternal[i].bReservoirPartPresent;

END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetAllNests" Id="{040243fe-9195-4d5a-9ec4-ac09c7b1f29a}">
      <Declaration><![CDATA[METHOD PUBLIC GetAllNests : ARRAY[1..4] OF ST_Nest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetAllNests := aNestInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetAllNestStatistics" Id="{871802a9-143f-4f73-a687-6c9915a0bb47}">
      <Declaration><![CDATA[METHOD PUBLIC GetAllNestStatistics : ARRAY[1..4] OF ST_NestStatistics
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetAllNestStatistics := aNestStatisticsInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetNestAtPosition" Id="{0745dbbc-9394-432e-878b-30be589989e2}">
      <Declaration><![CDATA[METHOD PUBLIC GetNestAtPosition : ST_Nest
VAR_INPUT ePosition : E_TablePosition; END_VAR
VAR uiId : UINT; END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[uiId := GetNestIdAtPosition(ePosition);
IF uiId >= 1 AND uiId <= 4 THEN GetNestAtPosition := aNestInternal[uiId]; END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetNestIdAtPosition" Id="{63b89a52-07a6-4e44-b561-4ccffa7ada5e}">
      <Declaration><![CDATA[METHOD PUBLIC GetNestIdAtPosition : UINT
VAR_INPUT ePosition : E_TablePosition; END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ePosition >= E_TablePosition.Position1 AND ePosition <= E_TablePosition.Position4 THEN
    GetNestIdAtPosition := aPositionToNest[TO_UINT(ePosition)];
ELSE
    GetNestIdAtPosition := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MarkDispositionComplete" Id="{c70a4344-213e-4717-8088-9601e267aed7}">
      <Declaration><![CDATA[METHOD PUBLIC MarkDispositionComplete
VAR_INPUT ePosition : E_TablePosition; END_VAR
VAR uiId : UINT; END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[uiId := GetNestIdAtPosition(ePosition);
IF uiId >= 1 AND uiId <= 4 THEN
    aNestInternal[uiId].bDispositionSent := TRUE;
    aNestInternal[uiId].bOperatorExchangeComplete := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StoreAssemblyResultAtPosition" Id="{8c97de87-1f32-4073-baf8-37cf70fd5d6e}">
      <Declaration><![CDATA[METHOD PUBLIC StoreAssemblyResultAtPosition : BOOL
VAR_INPUT
    ePosition : E_TablePosition;
    stResult  : ST_ProcessResult;
END_VAR

VAR
    uiId : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StoreAssemblyResultAtPosition := FALSE;

uiId := GetNestIdAtPosition(ePosition);

IF uiId >= 1 AND uiId <= 4 THEN

    aNestInternal[uiId].stAssemblyResult := stResult;

    StoreAssemblyResultAtPosition := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StoreResultAtPosition" Id="{ddb2e5e3-90e7-449e-bf71-eb713c031025}">
      <Declaration><![CDATA[METHOD PUBLIC StoreResultAtPosition : BOOL
VAR_INPUT
    ePosition : E_TablePosition;
    stResult  : ST_ProcessResult;
END_VAR

VAR
    uiId : UINT;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[StoreResultAtPosition := FALSE;

uiId := GetNestIdAtPosition(ePosition);

IF uiId >= 1 AND uiId <= 4 THEN

    // Always overwrite the final result for the current part.
    aNestInternal[uiId].stResult := stResult;

    aNestInternal[uiId].bProcessComplete := stResult.bValid;
    aNestInternal[uiId].bProcessRequired := FALSE;

    IF stResult.bValid AND stResult.bPassed THEN
        aNestInternal[uiId].eDisposition := E_PartDisposition.Pass;

    ELSIF stResult.bValid THEN
        aNestInternal[uiId].eDisposition := E_PartDisposition.Reject;
    END_IF

    StoreResultAtPosition := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StoreSiliconeResultAtPosition" Id="{ef4df2df-edca-421a-ba37-9dde27b38377}">
      <Declaration><![CDATA[METHOD PUBLIC StoreSiliconeResultAtPosition : BOOL
VAR_INPUT
    ePosition : E_TablePosition;
    stResult  : ST_ProcessResult;
END_VAR

VAR
    uiId : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StoreSiliconeResultAtPosition := FALSE;

uiId := GetNestIdAtPosition(ePosition);

IF uiId >= 1 AND uiId <= 4 THEN

    aNestInternal[uiId].stSiliconeResult := stResult;

    StoreSiliconeResultAtPosition := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>