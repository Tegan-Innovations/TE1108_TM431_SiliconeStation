<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_IndexTable4" Id="{f63bf922-32d6-47a6-a320-fd5098ca85ff}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IndexTable4
VAR
    eState                         : E_IndexState := E_IndexState.Initialising;
    eFault                         : E_IndexFault := E_IndexFault.None;
    ePositionAtMoveStart           : E_TablePosition := E_TablePosition.Unknown;
	eStateBeforeWrongPosition       : E_IndexState := E_IndexState.Idle;
	
    bRequestPending                : BOOL;
    bDonePulse                     : BOOL;
    bManualMoveActive              : BOOL;
    bPositionRecoveryActive        : BOOL;
    bWrongPositionSupervisionActive: BOOL;
    bReleaseProcessPosition        : BOOL;
    bOperatorExchangeDone          : BOOL;
	bSamePositionDetected 		   : BOOL;
	
	
    tonTwoHandHold                 : TON;
    tonRotateDelay                 : TON;
    tonStopDelay                   : TON;
    tonStateTimeout                : TON;
    tonWrongPosition               : TON;
	
	
    stInternalStatus               : ST_IndexStatus;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="ConfirmOperatorExchange" Id="{8b826530-aead-4a56-93ce-c34de7df3106}">
      <Declaration><![CDATA[METHOD PUBLIC ConfirmOperatorExchange]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState = E_IndexState.WaitingOperatorExchange THEN bOperatorExchangeDone := TRUE; END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic" Id="{2fb46229-138b-4d0e-8c96-4881bd8dada6}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bEnable                 : BOOL;
    bReset                  : BOOL;
    bAutomaticMode          : BOOL;
    bManualMode             : BOOL;
    bMovePermissive         : BOOL;
    bSafetyMotionPermitted  : BOOL;
    bTwoHandsSafe           : BOOL;
    bStationsHome           : BOOL;
    bProcessToolingRetracted: BOOL;
    bTableReady             : BOOL;
    bTableLocked            : BOOL;
    bCompletedSensor        : BOOL;
    bSupportExtended        : BOOL;
    bSupportRetracted       : BOOL;
    eCurrentPosition        : E_TablePosition;
    tRotateDelay            : TIME;
    tStopDelay              : TIME;
    tSupportTimeout         : TIME;
    tMovementTimeout        : TIME;
    tTwoHandHold            : TIME;
    tTwoHandRecoveryTimeout : TIME;
END_VAR
VAR_OUTPUT
    bRotatePortA            : BOOL;
    bStopPortB              : BOOL;
    bSupportExtendRequest   : BOOL;
    bSupportRetractRequest  : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================
// DETERMINISTIC OUTPUT DEFAULTS
// =========================================================

bRotatePortA := FALSE;
bStopPortB := FALSE;

// Support-cylinder outputs are not used during the current commissioning stage.
bSupportExtendRequest := FALSE;
bSupportRetractRequest := FALSE;

bDonePulse := FALSE;


// =========================================================
// TIMERS
// =========================================================

// Temporarily disabled.
//
// The index movement starts immediately when the validated two-hand signal
// becomes TRUE. A minimum hold time is not currently required.
//
// tonTwoHandHold(
//     IN := bTwoHandsSafe,
//     PT := tTwoHandHold
// );

tonRotateDelay(
    IN := eState = E_IndexState.RotatingPortA,
    PT := tRotateDelay
);

tonStopDelay(
    IN := eState = E_IndexState.StoppingPortB,
    PT := tStopDelay
);

tonWrongPosition(
    IN := bWrongPositionSupervisionActive,
    PT := tTwoHandRecoveryTimeout
);


// Only active movement states are supervised during the current
// index commissioning stage.
tonStateTimeout(
    IN :=
        eState = E_IndexState.RotatingPortA
        OR eState = E_IndexState.StoppingPortB
        OR eState = E_IndexState.VerifyingPosition,

    PT := tMovementTimeout
);


// Original support supervision retained for future implementation.
//
// tonStateTimeout(
//     IN := eState = E_IndexState.RetractingSupport
//        OR eState = E_IndexState.WaitingSupportRetracted
//        OR eState = E_IndexState.RotatingPortA
//        OR eState = E_IndexState.StoppingPortB
//        OR eState = E_IndexState.VerifyingPosition
//        OR eState = E_IndexState.ExtendingSupport
//        OR eState = E_IndexState.WaitingSupportExtended,
// 
//     PT := SEL(
//         eState = E_IndexState.RotatingPortA
//         OR eState = E_IndexState.StoppingPortB
//         OR eState = E_IndexState.VerifyingPosition,
//         tSupportTimeout,
//         tMovementTimeout
//     )
// );


// =========================================================
// RESET
// =========================================================

IF bReset THEN

    bRequestPending := FALSE;
    bReleaseProcessPosition := FALSE;
    bOperatorExchangeDone := FALSE;

    bManualMoveActive := FALSE;
    bPositionRecoveryActive := FALSE;
    bWrongPositionSupervisionActive := FALSE;

    eFault := E_IndexFault.None;

    IF bEnable THEN
        eState := E_IndexState.Initialising;
    ELSE
        eState := E_IndexState.Disabled;
    END_IF

END_IF


// =========================================================
// DISABLE HANDLING
// =========================================================

IF NOT bEnable
    AND eState <> E_IndexState.Disabled
THEN
    eState := E_IndexState.Disabled;
END_IF


// =========================================================
// INDEX STATE MACHINE
// =========================================================

CASE eState OF


    // =====================================================
    // DISABLED
    // =====================================================

    E_IndexState.Disabled:

        IF bEnable THEN
            eState := E_IndexState.Initialising;
        END_IF


    // =====================================================
    // INITIALISING
    // =====================================================

    E_IndexState.Initialising:

        // Initialising only prepares the index controller.
        // No automatic movement is performed here.
        IF bEnable
            AND bSafetyMotionPermitted
        THEN
            eState := E_IndexState.Idle;
        END_IF


    // =====================================================
    // IDLE
    // =====================================================

    E_IndexState.Idle:

        // Current commissioning requirements:
        //
        // 1. A movement request is pending.
        // 2. Manual movement is permitted.
        // 3. Motion safety is available.
        // 4. The two-hand signal is active.
        //
        // Support-cylinder feedback is temporarily excluded.
        IF bRequestPending
            AND bMovePermissive

            // Temporarily disabled until the support cylinders
            // are commissioned.
            //
            // AND bStationsHome
            // AND bProcessToolingRetracted

            AND bSafetyMotionPermitted
            AND bTwoHandsSafe
        THEN

            bRequestPending := FALSE;
            ePositionAtMoveStart := eCurrentPosition;

            // Support retraction sequence temporarily bypassed.
            //
            // eState := E_IndexState.RetractingSupport;

            eState := E_IndexState.RotatingPortA;

        END_IF


    // =====================================================
    // SUPPORT RETRACTION
    // TEMPORARILY NOT USED
    // =====================================================

    E_IndexState.RetractingSupport:

        (*
        bSupportRetractRequest := TRUE;

        IF NOT bSafetyMotionPermitted THEN

            eFault := E_IndexFault.SafetyLostDuringMovement;
            eState := E_IndexState.Fault;

        ELSIF NOT bTableLocked
            AND NOT bTwoHandsSafe
        THEN

            bWrongPositionSupervisionActive := TRUE;
            eState := E_IndexState.WrongPositionRecovery;

        ELSIF bSupportRetracted THEN

            eState := E_IndexState.WaitingSupportRetracted;

        ELSIF tonStateTimeout.Q THEN

            eFault := E_IndexFault.SupportRetractTimeout;
            eState := E_IndexState.Fault;

        END_IF
        *)

        // Temporary bypass.
        eState := E_IndexState.RotatingPortA;


    E_IndexState.WaitingSupportRetracted:

        (*
        bSupportRetractRequest := TRUE;

        IF NOT bTableLocked
            AND NOT bTwoHandsSafe
        THEN

            bWrongPositionSupervisionActive := TRUE;
            eState := E_IndexState.WrongPositionRecovery;

        ELSIF bSupportRetracted THEN

            eState := E_IndexState.RotatingPortA;

        ELSIF tonStateTimeout.Q THEN

            eFault := E_IndexFault.SupportRetractTimeout;
            eState := E_IndexState.Fault;

        END_IF
        *)

        // Temporary bypass.
        eState := E_IndexState.RotatingPortA;


    // =====================================================
    // ROTATE TABLE — PORT A
    // =====================================================

    E_IndexState.RotatingPortA:

        // Support output remains disabled until the cylinder is commissioned.
        //
        // bSupportRetractRequest := TRUE;

        // The two-hand condition must be evaluated first because
        // TwinSAFE may remove bSafetyMotionPermitted immediately when
        // either hand is released.
        IF NOT bTableLocked
            AND NOT bTwoHandsSafe
        THEN

            bWrongPositionSupervisionActive := TRUE;
            eState := E_IndexState.WrongPositionRecovery;


        ELSIF NOT bSafetyMotionPermitted THEN

            eFault := E_IndexFault.SafetyLostDuringMovement;
            eState := E_IndexState.Fault;


        ELSIF NOT bMovePermissive THEN

            eFault := E_IndexFault.MovementPermissiveLost;
            eState := E_IndexState.Fault;


        ELSE

            bRotatePortA := TRUE;

            IF tonRotateDelay.Q
                AND bCompletedSensor
            THEN

                eState := E_IndexState.StoppingPortB;

            ELSIF tonStateTimeout.Q THEN

                eFault := E_IndexFault.RotationTimeout;
                eState := E_IndexState.Fault;

            END_IF

        END_IF


    // =====================================================
    // TWO-HAND RECOVERY
    // =====================================================
	// =====================================================
// TWO-HAND / WRONG-POSITION RECOVERY
// =====================================================
	E_IndexState.WrongPositionRecovery:
	
		// Port B is activated first so that the table can stop
		// and lock safely after the two-hand signal is released.
		bStopPortB := TRUE;
	
	
		// -------------------------------------------------
		// TABLE STOPPED AND LOCKED
		// -------------------------------------------------
		// Once the table is locked, the two-hand command is no
		// longer required. Continue with position verification.
		IF bTableReady
			AND bTableLocked
		THEN
	
			bWrongPositionSupervisionActive := FALSE;
			eState := E_IndexState.VerifyingPosition;
	
	
		// -------------------------------------------------
		// RECOVERY TIMEOUT
		// -------------------------------------------------
		ELSIF tonWrongPosition.Q THEN
	
			bWrongPositionSupervisionActive := FALSE;
	
			eFault := E_IndexFault.WrongPositionTimeout;
			eState := E_IndexState.Fault;
	
	
		// -------------------------------------------------
		// OPERATOR RESTORED BOTH HANDS BEFORE TABLE LOCKED
		// -------------------------------------------------
		ELSIF bTwoHandsSafe
			AND bSafetyMotionPermitted
			AND bMovePermissive
		THEN
	
			bWrongPositionSupervisionActive := FALSE;
	
			// Resume the exact state interrupted by the
			// two-hand signal release.
			eState := eStateBeforeWrongPosition;
	
		END_IF
    // =====================================================
    // STOP TABLE — PORT B
    // =====================================================

    E_IndexState.StoppingPortB:

        // Support output temporarily disabled.
        //
        // bSupportRetractRequest := TRUE;

        // Continue requiring two hands until the table is locked.
        // This check must be evaluated before bSafetyMotionPermitted.
        IF NOT bTableLocked
            AND NOT bTwoHandsSafe
        THEN

            bWrongPositionSupervisionActive := TRUE;
            eState := E_IndexState.WrongPositionRecovery;


        ELSIF NOT bSafetyMotionPermitted THEN

            eFault := E_IndexFault.SafetyLostDuringMovement;
            eState := E_IndexState.Fault;


        ELSE

            bStopPortB := TRUE;

            IF tonStopDelay.Q
                AND bTableReady
                AND bTableLocked
            THEN

                eState := E_IndexState.VerifyingPosition;

            ELSIF tonStateTimeout.Q THEN

                eFault := E_IndexFault.StopAndLockTimeout;
                eState := E_IndexState.Fault;

            END_IF

        END_IF


    // =====================================================
	// VERIFY NEW POSITION
	// =====================================================
	E_IndexState.VerifyingPosition:
	
		// Support output temporarily disabled.
		//
		// bSupportRetractRequest := TRUE;
	
	
		// At this point the table is already confirmed ready and locked.
		// Two hands are therefore no longer required.
	
		IF eCurrentPosition = E_TablePosition.Unknown THEN
	
			IF tonStateTimeout.Q THEN
	
				eFault := E_IndexFault.PositionInvalid;
				//eState := E_IndexState.Fault;
	
			END_IF
	
	
		ELSIF NOT bPositionRecoveryActive
			AND eCurrentPosition = ePositionAtMoveStart
		THEN
	
			// A valid and known position was detected, but it is the
			// same position from which the movement started.
			//
			// This is process information only and is not an index fault.
			bSamePositionDetected := TRUE;
	
			bWrongPositionSupervisionActive := FALSE;
			eState := E_IndexState.Complete;
	
	
		ELSE
	
			bSamePositionDetected := FALSE;
			bWrongPositionSupervisionActive := FALSE;
	
			// Support extension sequence temporarily bypassed.
			//
			// eState := E_IndexState.ExtendingSupport;
	
			eState := E_IndexState.Complete;
	
		END_IF


    // =====================================================
    // SUPPORT EXTENSION
    // TEMPORARILY NOT USED
    // =====================================================

    E_IndexState.ExtendingSupport:

        (*
        bSupportExtendRequest := TRUE;

        IF bSupportExtended THEN

            eState := E_IndexState.WaitingSupportExtended;

        ELSIF tonStateTimeout.Q THEN

            eFault := E_IndexFault.SupportExtendTimeout;
            eState := E_IndexState.Fault;

        END_IF
        *)

        // Temporary bypass.
        eState := E_IndexState.Complete;


    E_IndexState.WaitingSupportExtended:

        (*
        bSupportExtendRequest := TRUE;

        IF bSupportExtended
            AND bTableReady
            AND bTableLocked
        THEN

            IF bManualMoveActive
                OR bPositionRecoveryActive
            THEN
                eState := E_IndexState.Complete;
            ELSE
                eState := E_IndexState.ProcessPositionReady;
            END_IF

        ELSIF tonStateTimeout.Q THEN

            eFault := E_IndexFault.SupportExtendTimeout;
            eState := E_IndexState.Fault;

        END_IF
        *)

        // Temporary bypass.
        eState := E_IndexState.Complete;


    // =====================================================
    // AUTOMATIC-CYCLE STATES
    // CURRENTLY RETAINED BUT NOT USED BY MANUAL MOVEMENT
    // =====================================================

    E_IndexState.ProcessPositionReady:

        (*
        bSupportExtendRequest := TRUE;
        *)

        IF bReleaseProcessPosition THEN

            bReleaseProcessPosition := FALSE;
            eState := E_IndexState.WaitingOperatorExchange;

        END_IF


    E_IndexState.WaitingOperatorExchange:

        (*
        bSupportExtendRequest := TRUE;
        *)

        IF bOperatorExchangeDone THEN

            bOperatorExchangeDone := FALSE;
            eState := E_IndexState.Complete;

        END_IF


    // =====================================================
    // COMPLETE
    // =====================================================

    E_IndexState.Complete:

        bDonePulse := TRUE;

        bManualMoveActive := FALSE;
        bPositionRecoveryActive := FALSE;
        bWrongPositionSupervisionActive := FALSE;

        eState := E_IndexState.Idle;


    // =====================================================
    // STOPPING
    // =====================================================

    E_IndexState.Stopping:

        // Outputs are already reset at the beginning of this method.
        IF NOT bRotatePortA THEN
            eState := E_IndexState.Idle;
        END_IF


    // =====================================================
    // FAULT
    // =====================================================

    E_IndexState.Fault:

        // No movement outputs are generated while faulted.


END_CASE


// =========================================================
// STATUS MAPPING
// =========================================================

stInternalStatus.eState := eState;
stInternalStatus.eFault := eFault;
stInternalStatus.eCurrentPosition := eCurrentPosition;

stInternalStatus.bReady :=
    eState = E_IndexState.Idle
    OR eState = E_IndexState.ProcessPositionReady;

stInternalStatus.bBusy :=
    // Support states retained for future use.
    (eState = E_IndexState.RetractingSupport)
    OR (eState = E_IndexState.WaitingSupportRetracted)

    OR (eState = E_IndexState.RotatingPortA)
    OR (eState = E_IndexState.WrongPositionRecovery)
    OR (eState = E_IndexState.StoppingPortB)
    OR (eState = E_IndexState.VerifyingPosition)

    // Support states retained for future use.
    OR (eState = E_IndexState.ExtendingSupport)
    OR (eState = E_IndexState.WaitingSupportExtended);

stInternalStatus.bFaulted :=
    eState = E_IndexState.Fault;

stInternalStatus.bDonePulse :=
    bDonePulse;

stInternalStatus.bManualMoveActive :=
    bManualMoveActive;

stInternalStatus.bPositionRecoveryActive :=
    bPositionRecoveryActive;
	
stInternalStatus.bSamePositionDetected :=
    bSamePositionDetected;

stInternalStatus.bWrongPositionTimerActive :=
    bWrongPositionSupervisionActive;

stInternalStatus.bTwoHandRequired :=
    bRequestPending
    OR (
        stInternalStatus.bBusy
        AND NOT bTableLocked
    );

stInternalStatus.bProcessPositionReady :=
    eState = E_IndexState.ProcessPositionReady;

stInternalStatus.bWaitingOperatorExchange :=
    eState = E_IndexState.WaitingOperatorExchange;


// Support feedback remains published for diagnostics, even though it
// is not currently used to permit the movement.
stInternalStatus.bSupportRetracted :=
    bSupportRetracted;

stInternalStatus.bSupportExtended :=
    bSupportExtended;

stInternalStatus.bTableReady :=
    bTableReady;

stInternalStatus.bTableLocked :=
    bTableLocked;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetFault" Id="{eea007e7-caa7-4f88-943f-67842896f546}">
      <Declaration><![CDATA[METHOD PUBLIC GetFault : E_IndexFault]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetFault := eFault;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetState" Id="{8eb30043-dd74-46b4-827c-a056aa2f22c3}">
      <Declaration><![CDATA[METHOD PUBLIC GetState : E_IndexState]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetState := eState;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetStatus" Id="{c3360144-f938-49d7-804e-e9b150d88fe0}">
      <Declaration><![CDATA[METHOD PUBLIC GetStatus : ST_IndexStatus]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetStatus := stInternalStatus;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsDone" Id="{e28496d3-a991-4b37-870c-bd2b5f311447}">
      <Declaration><![CDATA[METHOD PUBLIC IsDone : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsDone := bDonePulse;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFaulted" Id="{bb69d094-7f98-4956-affc-0791a9d73b61}">
      <Declaration><![CDATA[METHOD PUBLIC IsFaulted : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFaulted := eState = E_IndexState.Fault;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsProcessPositionReady" Id="{ad81a1fd-cb24-4b77-90fc-13c20395726b}">
      <Declaration><![CDATA[METHOD PUBLIC IsProcessPositionReady : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsProcessPositionReady := eState = E_IndexState.ProcessPositionReady;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsReady" Id="{026204c6-23a9-42b6-a142-3c5752fde993}">
      <Declaration><![CDATA[METHOD PUBLIC IsReady : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsReady := eState = E_IndexState.Idle OR eState = E_IndexState.ProcessPositionReady;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseProcessPosition" Id="{aa2a17c9-0111-4d03-9905-6c0cd9e98b54}">
      <Declaration><![CDATA[METHOD PUBLIC ReleaseProcessPosition]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState = E_IndexState.ProcessPositionReady THEN bReleaseProcessPosition := TRUE; END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestManualMove" Id="{214b40fe-b417-48f1-81b8-424bbac569d6}">
      <Declaration><![CDATA[METHOD PUBLIC RequestManualMove : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestManualMove := FALSE;
IF eState = E_IndexState.Idle AND NOT bRequestPending THEN
    bRequestPending := TRUE;
    bManualMoveActive := TRUE;
    RequestManualMove := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestMove" Id="{e8821bef-9d36-4d6f-a002-e87f6fe258fa}">
      <Declaration><![CDATA[METHOD PUBLIC RequestMove : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestMove := FALSE;
IF eState = E_IndexState.Idle AND NOT bRequestPending THEN
    bRequestPending := TRUE;
    bManualMoveActive := FALSE;
    RequestMove := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestPositionRecovery" Id="{9f628d1a-bf3f-44d6-ae95-13ff93d31901}">
      <Declaration><![CDATA[METHOD PUBLIC RequestPositionRecovery : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestPositionRecovery := FALSE;
IF eState = E_IndexState.Idle
   AND NOT bRequestPending
   AND stInternalStatus.eCurrentPosition = E_TablePosition.Unknown
THEN
    bRequestPending := TRUE;
    bManualMoveActive := FALSE;
    bPositionRecoveryActive := TRUE;
    RequestPositionRecovery := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{4382a52e-2cae-448b-bcaf-347271ed8c78}">
      <Declaration><![CDATA[METHOD PUBLIC Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestPending := FALSE;
bManualMoveActive := FALSE;
bPositionRecoveryActive := FALSE;
bWrongPositionSupervisionActive := FALSE;
bReleaseProcessPosition := FALSE;
bOperatorExchangeDone := FALSE;
eFault := E_IndexFault.None;
eState := E_IndexState.Initialising;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>