<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ProcessCycle" Id="{622f2bef-5510-4430-be8a-312a17e95422}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProcessCycle
VAR
    // STATE MACHINE
    eState                     : E_CycleState := E_CycleState.Disabled;

    // REQUESTS AND STATUS
    stRequestsInternal         : ST_ProcessCycleRequests;
    stStatusInternal           : ST_ProcessCycleStatus;

    // EDGE DETECTION
    rtProcessCycleTrigger      : R_TRIG;

    // SIMULATED PROCESS STATIONS
    tonAssemblyProcess         : TON;
    tonSiliconeProcess         : TON;
	
	// Timeout
	tonProcessCycleTimeout : TON;
	tonAutoCycleIdleTimeout : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{e84fc6ef-4070-40dd-8010-e10d3773e159}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bEnable          : BOOL;
    bResetRequest    : BOOL;
    bStopRequest     : BOOL;

    stInputs         : ST_ProcessCycleInputs;

    tAssemblyProcessSimulation : TIME;
    tSiliconeProcessSimulation : TIME;
END_VAR

VAR_OUTPUT
    stRequests       : ST_ProcessCycleRequests;
    stStatus         : ST_ProcessCycleStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The Process Cycle coordinates objects.
// It does not operate physical outputs directly.


// =========================================================
// CYCLIC DEFAULTS
// =========================================================

stRequestsInternal.bStartProcessStation 			:= FALSE;
stRequestsInternal.bStopProcessStation 				:= FALSE;
stRequestsInternal.bCaptureProcessResult 			:= FALSE;
stRequestsInternal.bStoreProcessResult 				:= FALSE;

stRequestsInternal.bSiliconeSupportExtend 			:= FALSE;
stRequestsInternal.bSiliconeSupportRetract 			:= FALSE;
stRequestsInternal.bAssemblySupportExtend 			:= FALSE;
stRequestsInternal.bAssemblySupportRetract 			:= FALSE;

stRequestsInternal.bPrepareOperatorExchange 		:= FALSE;
stRequestsInternal.bConfirmOperatorExchange 		:= FALSE;

stRequestsInternal.bRequestIndex 					:= FALSE;
stRequestsInternal.bRequestIndexRecovery 			:= FALSE;
stRequestsInternal.bUpdateNestPositions 			:= FALSE;

stStatusInternal.bCompletePulse 					:= FALSE;



// =========================================================
// PROCESS TRIGGER EDGE DETECTION
// =========================================================

rtProcessCycleTrigger(
    CLK := stInputs.bTwoHandsSafe
);


// =========================================================
// TIMEOUTS
// =========================================================

tonProcessCycleTimeout(
    IN := eState <> E_CycleState.Disabled
        AND eState <> E_CycleState.Initialising
        AND eState <> E_CycleState.WaitingForProcessCycleTrigger
        AND eState <> E_CycleState.CycleComplete
        AND eState <> E_CycleState.ControlledStop
        AND eState <> E_CycleState.Fault,
    PT := T#10S
);

IF tonProcessCycleTimeout.Q THEN
	stStatusInternal.bTimeoutFault := TRUE;
    eState := E_CycleState.Fault;
END_IF

// =========================================================
// SIMULATED PROCESS TIMERS
// =========================================================

tonAssemblyProcess(
    IN := eState = E_CycleState.WaitingForProcessesComplete
        AND stInputs.bAssemblyProcessRequired,
    PT := tAssemblyProcessSimulation
);

tonSiliconeProcess(
    IN := eState = E_CycleState.WaitingForProcessesComplete
        AND stInputs.bSiliconeProcessRequired,
    PT := tSiliconeProcessSimulation
);

// =========================================================
// GLOBAL STATE CONTROL
// =========================================================

IF bResetRequest THEN
	
	stStatusInternal.bTimeoutFault := FALSE;
    eState := E_CycleState.Initialising;
	

ELSIF NOT bEnable THEN

    eState := E_CycleState.Disabled;

ELSIF bStopRequest
    AND eState <> E_CycleState.Disabled
    AND eState <> E_CycleState.ControlledStop
THEN

    eState := E_CycleState.ControlledStop;

END_IF


// =========================================================
// PROCESS CYCLE STATE MACHINE
// =========================================================

CASE eState OF

    // -----------------------------------------------------
    // DISABLED
    // -----------------------------------------------------

    E_CycleState.Disabled:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.None;

        IF bEnable THEN

            eState :=
                E_CycleState.Initialising;

        END_IF


    // -----------------------------------------------------
    // INITIALISING
    // -----------------------------------------------------

    E_CycleState.Initialising:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.InitialisingProcessCycle;

        IF bEnable
            AND stInputs.bSafetyOk
            AND stInputs.bIndexReady
            AND stInputs.bIndexLocked
            AND stInputs.bSiliconeSupportRetracted
            AND stInputs.bAssemblySupportRetracted
        THEN

            eState :=
                E_CycleState.WaitingForProcessCycleTrigger;

        END_IF


    // -----------------------------------------------------
    // WAITING FOR PROCESS CYCLE TRIGGER
    // -----------------------------------------------------

    E_CycleState.WaitingForProcessCycleTrigger:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.WaitingForProcessCycleTrigger;

        IF stInputs.bIndexFaulted
            OR stInputs.bSiliconeSupportFaulted
            OR stInputs.bAssemblySupportFaulted
        THEN

            eState :=
                E_CycleState.Fault;

        ELSIF rtProcessCycleTrigger.Q
            AND stInputs.bSafetyOk
            AND stInputs.bIndexMoveAllowed
            AND stInputs.bIndexReady
            AND stInputs.bIndexLocked
            AND stInputs.bSiliconeSupportRetracted
            AND stInputs.bAssemblySupportRetracted
        THEN

            eState :=
                E_CycleState.ValidatingIndexPermissives;

        END_IF


    // -----------------------------------------------------
    // VALIDATING INDEX PERMISSIVES
    // -----------------------------------------------------

    E_CycleState.ValidatingIndexPermissives:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.ValidatingIndexPermissives;

        IF stInputs.bIndexFaulted THEN

            eState :=
                E_CycleState.Fault;

        ELSIF stInputs.bIndexMoveAllowed
            AND stInputs.bIndexReady
            AND stInputs.bIndexLocked
            AND stInputs.bSiliconeSupportRetracted
            AND stInputs.bAssemblySupportRetracted
        THEN

            eState :=
                E_CycleState.RequestingIndexMove;

        END_IF


    // -----------------------------------------------------
    // REQUESTING INDEX MOVE
    // -----------------------------------------------------

    E_CycleState.RequestingIndexMove:

        stRequestsInternal.bRequestIndex := TRUE;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.RequestingIndexMove;

        IF stInputs.bIndexRequestAccepted THEN

            eState :=
                E_CycleState.WaitingForIndexStart;

        END_IF


    // -----------------------------------------------------
    // WAITING FOR INDEX START
    // -----------------------------------------------------

    E_CycleState.WaitingForIndexStart:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.WaitingForIndexStart;

        IF stInputs.bIndexFaulted THEN

            eState :=
                E_CycleState.Fault;

        ELSIF stInputs.bIndexBusy
            OR stInputs.bIndexDone
        THEN

            eState :=
                E_CycleState.WaitingForIndexComplete;

        END_IF


    // -----------------------------------------------------
    // WAITING FOR INDEX COMPLETE
    // -----------------------------------------------------

    E_CycleState.WaitingForIndexComplete:

        stStatusInternal.eMessage :=E_ProcessCycleMessage.WaitingForIndexComplete;

       IF stInputs.bIndexFaulted THEN
			eState := E_CycleState.Fault;
		
		ELSIF stInputs.bIndexDone THEN
		
			IF stInputs.bIndexSamePositionDetected THEN
				eState := E_CycleState.CycleComplete;
		
			ELSIF stInputs.bSiliconeProcessRequired
				OR stInputs.bAssemblyProcessRequired
			THEN
				eState := E_CycleState.RequestingSupportsExtend;
		
			ELSE
				eState := E_CycleState.CycleComplete;
			END_IF
		
		END_IF


    // -----------------------------------------------------
    // REQUESTING SUPPORTS EXTEND
    // -----------------------------------------------------

    E_CycleState.RequestingSupportsExtend:

        stRequestsInternal.bSiliconeSupportExtend := stInputs.bSiliconeProcessRequired;
		stRequestsInternal.bAssemblySupportExtend := stInputs.bAssemblyProcessRequired;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.RequestingSupportsExtend;

        eState :=
            E_CycleState.WaitingForSupportsExtended;


    // -----------------------------------------------------
    // WAITING FOR SUPPORTS EXTENDED
    // -----------------------------------------------------

    E_CycleState.WaitingForSupportsExtended:

        stRequestsInternal.bSiliconeSupportExtend := stInputs.bSiliconeProcessRequired;
		stRequestsInternal.bAssemblySupportExtend := stInputs.bAssemblyProcessRequired;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.WaitingForSupportsExtended;

        IF (stInputs.bSiliconeProcessRequired AND stInputs.bSiliconeSupportFaulted)
			OR (stInputs.bAssemblyProcessRequired AND stInputs.bAssemblySupportFaulted)
		THEN
		
			eState := E_CycleState.Fault;
		
		ELSIF (NOT stInputs.bSiliconeProcessRequired OR stInputs.bSiliconeSupportExtended)
			AND (NOT stInputs.bAssemblyProcessRequired OR stInputs.bAssemblySupportExtended)
		THEN
		
			eState := E_CycleState.PreparingProcessStations;
		
		END_IF


    // -----------------------------------------------------
    // PREPARING PROCESS STATIONS
    // -----------------------------------------------------

    E_CycleState.PreparingProcessStations:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.PreparingProcessStation;

        eState :=
            E_CycleState.StartingProcesses;


    // -----------------------------------------------------
    // STARTING PROCESSES
    // -----------------------------------------------------

    E_CycleState.StartingProcesses:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.StartingProcessEquipment;

        eState :=
            E_CycleState.WaitingForProcessesRunning;


    // -----------------------------------------------------
    // WAITING FOR PROCESSES RUNNING
    // -----------------------------------------------------

    E_CycleState.WaitingForProcessesRunning:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.StartingProcessEquipment;

        eState :=
            E_CycleState.WaitingForProcessesComplete;


    // -----------------------------------------------------
    // WAITING FOR PROCESSES COMPLETE
    // -----------------------------------------------------

    E_CycleState.WaitingForProcessesComplete:

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.WaitingForProcessesComplete;

        IF (NOT stInputs.bAssemblyProcessRequired OR tonAssemblyProcess.Q)
			AND (NOT stInputs.bSiliconeProcessRequired OR tonSiliconeProcess.Q)
		THEN
		
			eState := E_CycleState.RequestingSupportsRetract;
		
		END_IF


    // -----------------------------------------------------
    // REQUESTING SUPPORTS RETRACT
    // -----------------------------------------------------

    E_CycleState.RequestingSupportsRetract:

        stRequestsInternal.bSiliconeSupportRetract := stInputs.bSiliconeProcessRequired;
		stRequestsInternal.bAssemblySupportRetract := stInputs.bAssemblyProcessRequired;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.RequestingSupportsRetract;

        eState :=
            E_CycleState.WaitingForSupportsRetracted;


    // -----------------------------------------------------
    // WAITING FOR SUPPORTS RETRACTED
    // -----------------------------------------------------

    E_CycleState.WaitingForSupportsRetracted:

        stRequestsInternal.bSiliconeSupportRetract := stInputs.bSiliconeProcessRequired;
		stRequestsInternal.bAssemblySupportRetract := stInputs.bAssemblyProcessRequired;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.WaitingForSupportsRetracted;

        IF (stInputs.bSiliconeProcessRequired AND stInputs.bSiliconeSupportFaulted)
			OR (stInputs.bAssemblyProcessRequired AND stInputs.bAssemblySupportFaulted)
		THEN
		
			eState := E_CycleState.Fault;
		
		ELSIF (NOT stInputs.bSiliconeProcessRequired OR stInputs.bSiliconeSupportRetracted)
			AND (NOT stInputs.bAssemblyProcessRequired OR stInputs.bAssemblySupportRetracted)
		THEN
		
			eState := E_CycleState.CycleComplete;
		
		END_IF


    // -----------------------------------------------------
    // CYCLE COMPLETE
    // -----------------------------------------------------

    E_CycleState.CycleComplete:

        stStatusInternal.bCompletePulse := TRUE;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.ProcessCycleComplete;

        eState :=
            E_CycleState.WaitingForProcessCycleTrigger;


    // -----------------------------------------------------
    // CONTROLLED STOP
    // -----------------------------------------------------
	E_CycleState.ControlledStop:
	
		stRequestsInternal.bStopProcessStation := TRUE;
		stRequestsInternal.bSiliconeSupportRetract := TRUE;
		stRequestsInternal.bAssemblySupportRetract := TRUE;
	
		stStatusInternal.eMessage := E_ProcessCycleMessage.ControlledStopping;
	
		IF NOT stInputs.bIndexBusy
			AND NOT stInputs.bProcessStationBusy
			AND stInputs.bSiliconeSupportRetracted
			AND stInputs.bAssemblySupportRetracted
		THEN
			eState := E_CycleState.Disabled;
		END_IF


    // -----------------------------------------------------
    // FAULT
    // -----------------------------------------------------

    E_CycleState.Fault:

        stRequestsInternal.bStopProcessStation := TRUE;

        stStatusInternal.eMessage :=
            E_ProcessCycleMessage.ProcessCycleFault;

END_CASE


// =========================================================
// STATUS MAPPING
// =========================================================

stStatusInternal.eState :=
    eState;

stStatusInternal.bActive :=
    bEnable
    AND eState <> E_CycleState.Disabled;

stStatusInternal.bIdle :=
    eState = E_CycleState.WaitingForProcessCycleTrigger;

stStatusInternal.bFaulted :=
    eState = E_CycleState.Fault;

stStatusInternal.bWaitingForPart :=
    FALSE;

stStatusInternal.bWaitingForOperator :=
    FALSE;

stStatusInternal.bWaitingForIndex :=
    eState = E_CycleState.ValidatingIndexPermissives
    OR eState = E_CycleState.RequestingIndexMove
    OR eState = E_CycleState.WaitingForIndexStart
    OR eState = E_CycleState.WaitingForIndexComplete;

stStatusInternal.bWaitingForSupports :=
    eState = E_CycleState.RequestingSupportsExtend
    OR eState = E_CycleState.WaitingForSupportsExtended
    OR eState = E_CycleState.RequestingSupportsRetract
    OR eState = E_CycleState.WaitingForSupportsRetracted;

stStatusInternal.bSiliconeSupportExtended :=
    stInputs.bSiliconeSupportExtended;

stStatusInternal.bSiliconeSupportRetracted :=
    stInputs.bSiliconeSupportRetracted;

stStatusInternal.bAssemblySupportExtended :=
    stInputs.bAssemblySupportExtended;

stStatusInternal.bAssemblySupportRetracted :=
    stInputs.bAssemblySupportRetracted;

stStatusInternal.bAssemblyProcessRunning :=
    eState = E_CycleState.WaitingForProcessesComplete
    AND stInputs.bAssemblyProcessRequired
    AND NOT tonAssemblyProcess.Q;

stStatusInternal.bAssemblyProcessComplete :=
    NOT stInputs.bAssemblyProcessRequired
    OR tonAssemblyProcess.Q;

stStatusInternal.bSiliconeProcessRunning :=
    eState = E_CycleState.WaitingForProcessesComplete
    AND stInputs.bSiliconeProcessRequired
    AND NOT tonSiliconeProcess.Q;

stStatusInternal.bSiliconeProcessComplete :=
    NOT stInputs.bSiliconeProcessRequired
    OR tonSiliconeProcess.Q;


// =========================================================
// MESSAGE MAPPING
// =========================================================

CASE stStatusInternal.eMessage OF

    E_ProcessCycleMessage.None:
        stStatusInternal.sMessage := '';

    E_ProcessCycleMessage.InitialisingProcessCycle:
        stStatusInternal.sMessage := 'Initialising automatic process cycle';

    E_ProcessCycleMessage.WaitingForProcessCycleTrigger:
        stStatusInternal.sMessage := 'Place both hands on the two-hand controls to start the cycle';

    E_ProcessCycleMessage.ValidatingIndexPermissives:
        stStatusInternal.sMessage := 'Validating index movement conditions';

    E_ProcessCycleMessage.RequestingIndexMove:
        stStatusInternal.sMessage := 'Requesting index table movement';

    E_ProcessCycleMessage.WaitingForIndexStart:
        stStatusInternal.sMessage := 'Waiting for index table movement to start';

    E_ProcessCycleMessage.WaitingForIndexComplete:
        stStatusInternal.sMessage := 'Index table moving';

    E_ProcessCycleMessage.RequestingSupportsExtend:
        stStatusInternal.sMessage := 'Requesting support extension';

    E_ProcessCycleMessage.WaitingForSupportsExtended:
        stStatusInternal.sMessage := 'Waiting for Silicone and Assembly Supports to extend';

    E_ProcessCycleMessage.PreparingProcessStation:
        stStatusInternal.sMessage := 'Preparing Assembly and Silicone processes';

    E_ProcessCycleMessage.StartingProcessEquipment:
        stStatusInternal.sMessage := 'Starting Assembly and Silicone processes';

    E_ProcessCycleMessage.WaitingForProcessesComplete:
        stStatusInternal.sMessage := 'Assembly and Silicone processes in progress';

    E_ProcessCycleMessage.RequestingSupportsRetract:
        stStatusInternal.sMessage := 'Requesting support retraction';

    E_ProcessCycleMessage.WaitingForSupportsRetracted:
        stStatusInternal.sMessage := 'Waiting for Silicone and Assembly Supports to retract';

    E_ProcessCycleMessage.ProcessCycleComplete:
        stStatusInternal.sMessage := 'Automatic process cycle complete';

    E_ProcessCycleMessage.ControlledStopping:
        stStatusInternal.sMessage := 'Stopping automatic cycle safely';

    E_ProcessCycleMessage.ProcessCycleFault:
        stStatusInternal.sMessage := 'Automatic process cycle fault';

ELSE

    stStatusInternal.sMessage := '';

END_CASE


// =========================================================
// OUTPUT PUBLICATION
// =========================================================

stRequests :=
    stRequestsInternal;

stStatus :=
    stStatusInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{927d8406-5eba-41e0-aa89-1016258d8a70}">
      <Declaration><![CDATA[METHOD PUBLIC Initialise]]></Declaration>
      <Implementation>
        <ST><![CDATA[eState := E_CycleState.Disabled;
stRequestsInternal.bStartProcessStation := FALSE;
stRequestsInternal.bStopProcessStation := FALSE;
stRequestsInternal.bCaptureProcessResult := FALSE;
stRequestsInternal.bStoreProcessResult := FALSE;
stRequestsInternal.bPrepareOperatorExchange := FALSE;
stRequestsInternal.bConfirmOperatorExchange := FALSE;
stRequestsInternal.bRequestIndex := FALSE;
stRequestsInternal.bRequestIndexRecovery := FALSE;
stRequestsInternal.bUpdateNestPositions := FALSE;
stStatusInternal.bCompletePulse := FALSE;
stStatusInternal.bFaulted := FALSE;
stStatusInternal.eMessage := E_ProcessCycleMessage.None;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>