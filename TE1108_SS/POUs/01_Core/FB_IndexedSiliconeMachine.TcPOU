<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_IndexedSiliconeMachine" Id="{ff07b0ce-3073-475d-ae18-b3b039ab22f1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IndexedSiliconeMachine
VAR

    // =====================================================
    // CORE COMPONENTS
    // =====================================================
    fbIndex                     : FB_IndexTable4;
    fbMainDoorLock              : FB_MainDoorLock;
    fbNestManager               : FB_NestTableManager;
    fbOperatorStation           : FB_OperatorStation;
    

    // =====================================================
    // PROCESS COMPONENTS
    // =====================================================
    fbProcessStation            : FB_ProcessStation;
    fbProcessCycle              : FB_ProcessCycle;

    fbSiliconeProcess           : FB_SiliconeProcess;
    fbAssemblyProcess           : FB_AssemblyProcess;

    fbIvek                      : FB_IvekDigiSpense4000;
    fbIvekSettingsLauncher      : FB_IvekSettingsLauncher;

    fbSimulatedEquipment        : FB_SimulatedProcessEquipment;
    ipEquipment                 : I_ProcessEquipment;

    // =====================================================
    // SUPPORT COMPONENTS
    // =====================================================
    fbSiliconeSupportCylinder   : FB_Support;
    fbAssemblySupportCylinder   : FB_Support;

    // =====================================================
    // MACHINE MODES
    // =====================================================
    fbManualMode                : FB_ManualMode;

    // =====================================================
    // MACHINE / CYCLE STATES
    // =====================================================
    eMachineState               : E_MachineState := E_MachineState.PowerUp;
    ePreviousMachineState       : E_MachineState := E_MachineState.PowerUp;
    eCycleState                 : E_CycleState := E_CycleState.Disabled;

    bMachineStateEntry          : BOOL;

    eInitialisingWaitReason     : E_InitialisingWaitReason :=
                                    E_InitialisingWaitReason.None;

    eStoppingWaitReason         : E_StoppingWaitReason :=
                                    E_StoppingWaitReason.None;

    // =====================================================
    // NEST DATA
    // =====================================================
    stOperatorNest              : ST_Nest;
    stSiliconeNest              : ST_Nest;
    stAssemblyNest              : ST_Nest;
    stProcessNest               : ST_Nest;
	stFaultNest 				: ST_Nest;

    stLastResult                : ST_ProcessResult;

    // =====================================================
    // COMPONENT STATUS
    // =====================================================
    stOperatorStatus            : ST_OperatorStationStatus;
    stIndexStatus               : ST_IndexStatus;
    stProcessStationStatus      : ST_ProcessStationStatus;
    stMainDoorLockStatus        : ST_MainDoorLockStatus;
	uiResetStatisticsNestIdOld 	: UINT;
	

    // =====================================================
    // MACHINE PERMISSIVES / OUTPUTS
    // =====================================================
    stPermissives               : ST_MachinePermissives;
    stOutputsInternal           : ST_MachineOutputs;
	stFaultRejectResult 		: ST_ProcessResult;
    // =====================================================
    // PROCESS CYCLE INTERFACE
    // =====================================================
    stProcessCycleInputs        : ST_ProcessCycleInputs;
    stProcessCycleRequests      : ST_ProcessCycleRequests;
    stProcessCycleStatus        : ST_ProcessCycleStatus;

    // =====================================================
    // MANUAL MODE INTERFACE
    // =====================================================
    stManualModeInputs          : ST_ManualModeInputs;
    stManualModeRequests        : ST_ManualModeRequests;
    stManualModeStatus          : ST_ManualModeStatus;

    // =====================================================
    // SUPPORT COMMANDS
    // =====================================================
    bSiliconeSupportRaiseRequest  : BOOL;
    bSiliconeSupportLowerRequest  : BOOL;

    bAssemblySupportRaiseRequest  : BOOL;
    bAssemblySupportLowerRequest  : BOOL;

    // =====================================================
    // INDEX COMMAND / FEEDBACK
    // =====================================================
    bManualIndexRequestAccepted             : BOOL;
    bIndexRequestAcceptedFeedback           : BOOL;
    bIndexRecoveryRequestAcceptedFeedback   : BOOL;

    bIndexStable                            : BOOL;
    bIndexDone                              : BOOL;

    // =====================================================
    // PROCESS COMMAND / FEEDBACK
    // =====================================================
    bProcessStartPulse            : BOOL;
    bProcessReady                 : BOOL;
    bResultStoredFeedback         : BOOL;

    bProcExtend                   : BOOL;
    bProcRetract                  : BOOL;


    // =====================================================
    // INITIALISATION / STOPPING
    // =====================================================
    bInitialisationComplete       : BOOL;
    bStoppingComplete             : BOOL;

    bInitialisationTimeoutFault   : BOOL;
    bStoppingTimeoutFault         : BOOL;
	bStopRequestTimeout 		  : BOOL;
	
    tonInitialising               : TON;
    tonStopping                   : TON;
    tonAutoCycleIdleTimeout       : TON;
	tonMainDoorNotClosed 		  : TON;
	tonStopRequest 				  : TON;
	
	
	bStopRequested 				  : BOOL;
    // =====================================================
    // AIR / DOOR CONTROL
    // =====================================================
    bAirAndDoorEnable             : BOOL;
    bAirSupplyLatched             : BOOL;
    bAirSupplyEnable              : BOOL;

    // =====================================================
    // SAFETY / FAULT HANDLING
    // =====================================================
    bSafetyDropRequest            : BOOL;

    fbEventFaultTrigger           : R_TRIG;
    fbResetTrigger                : R_TRIG;
	bFaultResetRequested 		  : BOOL;

    tpSafetyRunDrop               : TP;
	bHmiLogoutFault 				: BOOL;

    // =====================================================
    // CONFIGURATION
    // =====================================================
    bConfigured                   : BOOL;
	
	// =====================================================
    // LEDS
    // =====================================================
	eMode_LED_Start 				: E_LEDs_Mode := E_LEDs_Mode.OFF;
	eMode_LED_Reset 				: E_LEDs_Mode := E_LEDs_Mode.OFF;
	eMode_LED_PASS  				: E_LEDs_Mode := E_LEDs_Mode.OFF;
	eMode_LED_Fail  				: E_LEDs_Mode := E_LEDs_Mode.OFF;

	tonLedBlink    					: TON;
	bLedBlink      					: BOOL;
	fbLedBlinkTrigger 				: R_TRIG;
	bLedBlinkState 					: BOOL;
	
	uiHistoryNestId 				: UINT;
	bHistoryPassed  				: BOOL;
	stHistoryNest   				: ST_Nest;


END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CheckComponentFaults" Id="{1e0a6e8d-fb2f-4560-a186-ac64f265cfd0}">
      <Declaration><![CDATA[METHOD CheckComponentFaults : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================
// COMPONENT FAULT AGGREGATION
// =========================================================

CheckComponentFaults := FALSE;

IF fbMainDoorLock.IsFaulted()
    OR fbIndex.IsFaulted()
	OR fbSiliconeSupportCylinder.IsFaulted()
	OR fbAssemblySupportCylinder.IsFaulted()
    OR fbProcessStation.IsFaulted()

    // Enable after equipment commissioning.
    // OR ipEquipment.IsFaulted()
THEN

    bSafetyDropRequest := TRUE;
    eMachineState := E_MachineState.Fault;

    CheckComponentFaults := TRUE;

END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic" Id="{b3ad9d70-3bf2-42da-ab5a-7255e3c227a5}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    stInputs       : ST_MachineInputs;
    stCommand      : ST_MachineCommand;
    stConfig       : ST_MachineConfig;
    stIvekInput    : ST_IvekCyclicInput;
    bIvekCommsOk   : BOOL;
	blogoutHMI	   : BOOL;

	
END_VAR
VAR_OUTPUT
    stOutputs      : ST_MachineOutputs;
    stStatus       : ST_MachineStatus;
    stIvekOutput   : ST_IvekCyclicOutput;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// =========================================================
// GLOBAL MACHINE FAULT CONDITION
// =========================================================
// Any loss of the validated TwinSAFE safety status must place
// the machine in Fault immediately, regardless of machine state.
// =========================================================

IF NOT stInputs.stSafety.bSafetyOk OR bSafetyDropRequest THEN

    eMachineState := E_MachineState.Fault;

END_IF

// =========================================================
// MACHINE STOP REQUEST LATCH
// =========================================================

// Memorise the Stop command until the machine has
// completed the required stopping sequence.
IF stCommand.bStop THEN
    bStopRequested := TRUE;
END_IF


// =========================================================
// LED BLINK GENERATOR
// =========================================================

tonLedBlink(
    IN := NOT tonLedBlink.Q,
    PT := T#500MS
);

fbLedBlinkTrigger(
    CLK := tonLedBlink.Q
);

IF fbLedBlinkTrigger.Q THEN
    bLedBlinkState := NOT bLedBlinkState;
END_IF

bLedBlink := bLedBlinkState;
// =========================================================
// DETERMINISTIC CYCLIC INITIALISATION
// =========================================================

// Deterministic defaults
ResetCyclicOutputs();

// This request is generated for one PLC scan by an internal machine fault.
// The TP converts the one-scan request into the required TwinSAFE run-drop time.
bSafetyDropRequest := FALSE;

bMachineStateEntry := eMachineState <> ePreviousMachineState;

fbResetTrigger(
    CLK := stCommand.bReset
);

IF fbResetTrigger.Q THEN
    fbSiliconeProcess.RequestReset();
    fbAssemblyProcess.RequestReset();
END_IF

// Execute process FBs once per PLC scan
fbSiliconeProcess.Cyclic();
fbAssemblyProcess.Cyclic();

bProcessStartPulse := FALSE;

// Automatic door-lock request. Air supply is managed independently by the machine states below.
bAirAndDoorEnable := (eMachineState = E_MachineState.Initialising) OR (eMachineState = E_MachineState.ReadyToStart) OR (eMachineState = E_MachineState.AutoCycle) OR (eMachineState = E_MachineState.Manual);

stIndexStatus := fbIndex.GetStatus();
bIndexStable := NOT stIndexStatus.bBusy AND stInputs.bIndexReady AND stInputs.bIndexLocked AND stInputs.eIndexPosition <> E_TablePosition.Unknown;
bIndexDone := fbIndex.IsDone();

// =========================================================
// HMI LOGOUT SUPERVISION
// =========================================================
//
// If the HMI heartbeat is lost while the machine is already
// Stopped, the machine must remain Stopped.
//
// If the heartbeat is lost in any other operating state,
// the machine enters Fault immediately.
//
// Fault is never overridden by the HMI logout condition.
// =========================================================


// Loss of HMI heartbeat also requests a controlled stop.
// Fault has higher priority and is handled separately.
IF blogoutHMI
    AND (eMachineState = E_MachineState.Stopped OR eMachineState = E_MachineState.Stopping)THEN
	bStopRequested := TRUE;
	
ELSIF blogoutHMI
    AND (eMachineState <> E_MachineState.Stopped AND eMachineState <> E_MachineState.Stopping)THEN 
	bHmiLogoutFault := TRUE;
    bSafetyDropRequest := TRUE;
END_IF




// =========================================================
// PROCESS EQUIPMENT CONFIGURATION
// =========================================================

// Configure process equipment once. Simulation is the default until the IVEK is available.
IF NOT bConfigured THEN
    IF stConfig.bUseProcessSimulation THEN ipEquipment := fbSimulatedEquipment; ELSE ipEquipment := fbIvek; END_IF
    fbProcessStation.Configure(ipNewEquipment := ipEquipment);
    bConfigured := TRUE;
END_IF

fbIvek.stCyclicIn := stIvekInput;
fbIvek.bCommunicationOk := bIvekCommsOk;
IF stCommand.usiRecipeRequest <> 0 THEN ipEquipment.SetRecipe(stCommand.usiRecipeRequest); END_IF
IF stConfig.bUseProcessSimulation THEN
    IF stCommand.bSimulateProcessFault THEN fbSimulatedEquipment.SetSimulationResult(bPass := FALSE, bFault := TRUE);
    ELSIF stCommand.bSimulateProcessFail THEN fbSimulatedEquipment.SetSimulationResult(bPass := FALSE, bFault := FALSE);
    ELSIF stCommand.bSimulateProcessPass THEN fbSimulatedEquipment.SetSimulationResult(bPass := TRUE, bFault := FALSE);
    END_IF
END_IF

// =========================================================
// NEST MANAGEMENT

fbNestManager.Cyclic(
    bIndexStable := bIndexStable,
    bIndexComplete := bIndexDone,

    eIndexPosition := stInputs.eIndexPosition,

    bGearboxAssemblyPartPresent := stInputs.bGearboxAssemblyPartPresent,
    bReservoirPartPresent := stInputs.bReservoirPartPresent,
    eOperatorPosition := stConfig.eOperatorPosition,
    bIndexSamePositionDetected := stIndexStatus.bSamePositionDetected,
    aNestEnabled := stConfig.aNestEnabled
);


stOperatorNest := fbNestManager.GetNestAtPosition(stConfig.eOperatorPosition);
stSiliconeNest := fbNestManager.GetNestAtPosition(stConfig.eSiliconePosition);
stAssemblyNest := fbNestManager.GetNestAtPosition(stConfig.eAssemblyPosition);

// =========================================================
// RESET CURRENT NEST STATISTICS
// =========================================================

IF stCommand.uiResetStatisticsNestId >= 1
    AND stCommand.uiResetStatisticsNestId <= 4
    AND stCommand.uiResetStatisticsNestId <> uiResetStatisticsNestIdOld
THEN

    fbNestManager.ResetNestStatistics(
        uiNestId := stCommand.uiResetStatisticsNestId
    );

END_IF

uiResetStatisticsNestIdOld :=stCommand.uiResetStatisticsNestId;

fbNestManager.CountStatisticsAtPosition(
    ePosition := stConfig.eOperatorPosition
);



// =========================================================
// TEST HISTORY EVENT
// =========================================================

IF fbNestManager.GetStatisticsEvent(
    uiNestId => uiHistoryNestId,
    bPassed  => bHistoryPassed
) THEN

    // Get the complete nest data at the moment
    // the result is added to the statistics.
    stHistoryNest := fbNestManager.GetNestAtPosition( stConfig.eOperatorPosition );


    // -----------------------------------------------------
    // STORE TEST HISTORY ENTRY
    // -----------------------------------------------------

    GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].uiNestId 				:= uiHistoryNestId;
    GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].eResult 				:= stHistoryNest.eDisposition;
    GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].bSiliconeValid 		:= stHistoryNest.stSiliconeResult.bValid;
    GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].bSiliconePass 		:= stHistoryNest.stSiliconeResult.bPassed;
    GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].bAssemblyValid 		:= stHistoryNest.stAssemblyResult.bValid;
    GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].bAssemblyPass 		:= stHistoryNest.stAssemblyResult.bPassed;
	GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sDate 				:= GVL_MASTER.sSystemDate;
	GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sTime 				:= GVL_MASTER.sSystemTime;
				
				// Final result text
		IF stHistoryNest.stResult.bPassed THEN
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sResult := 'PASS';
		ELSE
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sResult := 'FAIL';
		END_IF;
		
		
		// Silicone result text
		IF NOT stHistoryNest.stSiliconeResult.bValid THEN
		
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sSiliconeResult := 'NOT TESTED';
		
		ELSIF stHistoryNest.stSiliconeResult.bPassed THEN
		
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sSiliconeResult := 'PASS';
		
		ELSE
		
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sSiliconeResult := 'FAIL';
		
		END_IF;
		
		
		// Flipping result text
		IF NOT stHistoryNest.stAssemblyResult.bValid THEN
		
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sFlippingResult := 'NOT TESTED';
		
		ELSIF stHistoryNest.stAssemblyResult.bPassed THEN
		
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sFlippingResult := 'PASS';
		
		ELSE
		
			GVL_Persistent.astTestHistory[GVL_Persistent.uiTestHistoryWriteIndex].sFlippingResult := 'FAIL';
		
		END_IF;
				
		// -----------------------------------------------------
		// ADVANCE TEST HISTORY WRITE INDEX
		// -----------------------------------------------------
		
		IF GVL_Persistent.uiTestHistoryCount < 2001 THEN
			GVL_Persistent.uiTestHistoryCount := GVL_Persistent.uiTestHistoryCount + 1;
		END_IF
		
		IF GVL_Persistent.uiTestHistoryWriteIndex < 2000 THEN
		
			GVL_Persistent.uiTestHistoryWriteIndex := GVL_Persistent.uiTestHistoryWriteIndex + 1;
		
		ELSE
		
			GVL_Persistent.uiTestHistoryWriteIndex := 0;
		
		END_IF
		

END_IF

// =========================================================
// OPERATOR STATION CONTROL
// =========================================================

// Operator exchange is evaluated independently of process-equipment implementation.
fbOperatorStation.Cyclic(
    bAutomaticActive := eMachineState = E_MachineState.AutoCycle,
    bIndexStable := bIndexStable,
    stOperatorNest := stOperatorNest,
    bGearboxAssemblyPartPresent := stInputs.bGearboxAssemblyPartPresent,
    bReservoirPartPresent := stInputs.bReservoirPartPresent,
    bRejectChutePartPresent := stInputs.bRejectChutePartPresent,
    bRequireRejectConfirm := stConfig.bRequireRejectConfirm,
    bAllowEmptyNestIndex := stConfig.bAllowEmptyNestIndex);
	
stOperatorStatus := fbOperatorStation.GetStatus();

// =========================================================
// OPERATOR NEST RESULT RELEASE
// =========================================================


// PASS: clear after part removal.
IF stOperatorNest.stResult.bValid
    AND stOperatorNest.stResult.bPassed
    AND stOperatorStatus.bPartRemovedConfirmed
THEN

    fbNestManager.ClearOperatorNest(
        stConfig.eOperatorPosition
    );

END_IF


// FAIL: clear only after reject confirmation.
IF stOperatorNest.stResult.bValid
    AND NOT stOperatorNest.stResult.bPassed
    AND stOperatorStatus.bRejectConfirmed
THEN

    fbNestManager.ClearOperatorNest(
        stConfig.eOperatorPosition
    );

END_IF

// =========================================================
// MACHINE PERMISSIVE AGGREGATION
// =========================================================

// Explicit permissive aggregation.
stPermissives.bSafetyIndexPermissive := stInputs.stSafety.bMotionSafetyPermitted;
stPermissives.bOperatorIndexPermissive := fbOperatorStation.IndexPermissive();
stPermissives.bProcessIndexPermissive := fbProcessStation.IndexPermissive();

stPermissives.bIndexMoveAllowed :=
    stPermissives.bSafetyIndexPermissive
    //AND stPermissives.bOperatorIndexPermissive
    AND stPermissives.bProcessIndexPermissive;


stPermissives.bProcessStartAllowed :=
    stInputs.stSafety.bProcessSafetyPermitted
    AND stInputs.bIndexReady
    AND stInputs.bIndexLocked
    AND stInputs.bReservoirPartPresent;


// =========================================================
// INITIALISATION PERMISSIVES
// =========================================================

stPermissives.bAirSupplyReady :=
	GVL_Safety.bAirSupplySafe;

stPermissives.bSiliconeSupportHome :=
    stInputs.bSiliconeSupportRetracted;

stPermissives.bAssemblySupportHome :=
    stInputs.bAssemblySupportRetracted;

stPermissives.bSupportsHome :=
    stPermissives.bSiliconeSupportHome
    AND stPermissives.bAssemblySupportHome;

stPermissives.bIndexInitialisationReady :=
    NOT stIndexStatus.bBusy
    AND NOT fbIndex.IsFaulted();

stPermissives.bDoorInitialisationReady :=
    NOT fbMainDoorLock.IsFaulted()
    AND fbMainDoorLock.IsReadyForAutomatic();

stPermissives.bInitialisationAllowed :=
    stInputs.stSafety.bSafetyOk
    AND stPermissives.bAirSupplyReady
    AND stPermissives.bIndexInitialisationReady
    AND stPermissives.bSupportsHome
    AND stPermissives.bDoorInitialisationReady;
	

// =========================================================
// IVEK NATIVE SETTINGS LAUNCHER
// =========================================================
 
fbIvekSettingsLauncher(
    bOpenRequest 		:= GVL_HMI.bCmdOpenIvekSettings,
    bMachineStopped 	:= eMachineState = E_MachineState.Stopped,
    udiLauncherHeartbeat := GVL_HMI.udiIvekSettingsHeartbeat,
    bResetError 		:= stCommand.bReset,
    bLauncherActive 	:= GVL_HMI.bIvekSettingsActive,
    bOpenPermitted 		=> GVL_HMI.bIvekSettingsAccessAllowed,
    bSettingsInterlock 	=> GVL_HMI.bIvekSettingsInterlock,
    bLaunchPending 		=> GVL_HMI.bIvekSettingsLaunchPending,
    bLaunchBusy 		=> GVL_HMI.bIvekSettingsLaunchBusy,
    bLaunchError 		=> GVL_HMI.bIvekSettingsLaunchError,
    nLaunchErrorId 		=> GVL_HMI.nIvekSettingsLaunchErrorId,
    bActivationTimeout 	=> GVL_HMI.bIvekSettingsActTimeout,
    bHeartbeatLost 		=> GVL_HMI.bIvekSettingsHeartbeatLost
);

// =========================================================
// EVENT ARCHITECTURE NOTES
// =========================================================

// Event architecture from the Leak Tester.
// Point classification is fixed in PRG_Events; station latches are provided
// through stInputs.bEventFault and stInputs.bEventCycleStopRequest.

// =========================================================
// MANUAL MODE COORDINATOR
// =========================================================

// Manual-mode coordinator consumes only normalized component status and produces requests.
stManualModeInputs.bSafetyOk 						:= stInputs.stSafety.bSafetyOk;
stManualModeInputs.bMotionSafetyPermitted 			:= stInputs.stSafety.bMotionSafetyPermitted;
stManualModeInputs.bTwoHandsSafe 					:= stInputs.bTwoHandsSafe;
stManualModeInputs.bProcessSafetyPermitted 			:= stInputs.stSafety.bProcessSafetyPermitted;
stManualModeInputs.bMainDoorSafe 					:= stInputs.stSafety.bMainDoorSafe;
stManualModeInputs.bIndexReady 						:= stInputs.bIndexReady;
stManualModeInputs.bIndexLocked 					:= stInputs.bIndexLocked;
stManualModeInputs.bIndexBusy 						:= stIndexStatus.bBusy;
stManualModeInputs.bIndexFaulted 					:= fbIndex.IsFaulted();
stManualModeInputs.bSiliconeSupportExtended 		:=stInputs.bSiliconeSupportExtended;
stManualModeInputs.bSiliconeSupportRetracted 		:=stInputs.bSiliconeSupportRetracted;
stManualModeInputs.bAssemblySupportExtended 		:=stInputs.bAssemblySupportExtended;
stManualModeInputs.bAssemblySupportRetracted 		:=stInputs.bAssemblySupportRetracted;



stManualModeInputs.bProcessStationFaulted := fbProcessStation.IsFaulted();
stManualModeInputs.bEquipmentReady := ipEquipment.IsReady();
stManualModeInputs.bEquipmentBusy := ipEquipment.IsBusy();
stManualModeInputs.bEquipmentFaulted := ipEquipment.IsFaulted();
stManualModeInputs.bReservoirPartPresent := stInputs.bReservoirPartPresent;

fbManualMode.Cyclic(
    bEnable := eMachineState = E_MachineState.Manual,
    bStopRequest := bStopRequested,
    stCommand := stCommand,
    stInputs := stManualModeInputs,
    stRequests => stManualModeRequests,
    stStatus => stManualModeStatus);


stProcessCycleInputs.bSiliconeSupportExtended := stInputs.bSiliconeSupportExtended;
stProcessCycleInputs.bSiliconeSupportRetracted := stInputs.bSiliconeSupportRetracted;
stProcessCycleInputs.bAssemblySupportExtended := stInputs.bAssemblySupportExtended;
stProcessCycleInputs.bAssemblySupportRetracted := stInputs.bAssemblySupportRetracted;

// =========================================================
// STOP REQUEST TIMEOUT SUPERVISION
// =========================================================
// Once a Stop request has been latched, the machine must
// reach the Stopping state within the allowed time.
//
// This supervises the conditions that may delay leaving
// AutoCycle or Manual mode after a Stop request.
tonStopRequest(
    IN := bStopRequested
        AND eMachineState <> E_MachineState.Stopping
        AND eMachineState <> E_MachineState.Stopped
        AND eMachineState <> E_MachineState.Fault,
    PT := T#10S
);

IF tonStopRequest.Q THEN
    bStopRequestTimeout := TRUE;
    bSafetyDropRequest := TRUE;
END_IF


// =========================================================
// MACHINE STATE MANAGEMENT
// =========================================================

CASE eMachineState OF
	

	E_MachineState.PowerUp:
	
		eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_Reset := E_LEDs_Mode.FLASHING;
		eMode_LED_PASS  := E_LEDs_Mode.OFF;
		eMode_LED_Fail  := E_LEDs_Mode.OFF;
		
		// Air is not enabled during PowerUp or the first transition to Stopped.
		bAirSupplyEnable := FALSE;

		// Same machine lifecycle used by the Kistler: always enter a controlled stop first.
		tonInitialising(IN := FALSE);
		tonStopping(IN := FALSE);
		eCycleState := E_CycleState.Disabled;
		eMachineState := E_MachineState.Stopping;

	E_MachineState.Fault:

		eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_Reset := E_LEDs_Mode.FLASHING;
		eMode_LED_PASS  := E_LEDs_Mode.OFF;
		eMode_LED_Fail  := E_LEDs_Mode.ON;
		
		IF bMachineStateEntry THEN

			stFaultRejectResult.bValid := TRUE;
			stFaultRejectResult.bPassed := FALSE;
			stFaultRejectResult.eCode := E_ProcessResultCode.Aborted;
			stFaultRejectResult.sDetail := 'Rejected due to machine fault';
		
			// Position 2
			stFaultNest := fbNestManager.GetNestAtPosition(E_TablePosition.Position2);
		
			IF stFaultNest.bGearboxAssemblyPartPresent OR stFaultNest.bReservoirPartPresent THEN
				fbNestManager.StoreResultAtPosition(ePosition := E_TablePosition.Position2, stResult := stFaultRejectResult);
			END_IF
		
			// Position 3
			stFaultNest := fbNestManager.GetNestAtPosition(E_TablePosition.Position3);
		
			IF stFaultNest.bGearboxAssemblyPartPresent OR stFaultNest.bReservoirPartPresent THEN
				fbNestManager.StoreResultAtPosition(ePosition := E_TablePosition.Position3, stResult := stFaultRejectResult);
			END_IF
		
			// Position 4
			stFaultNest := fbNestManager.GetNestAtPosition(E_TablePosition.Position4);
		
			IF stFaultNest.bGearboxAssemblyPartPresent OR stFaultNest.bReservoirPartPresent THEN
				fbNestManager.StoreResultAtPosition(ePosition := E_TablePosition.Position4, stResult := stFaultRejectResult);
			END_IF
		
		END_IF
		bAirSupplyEnable := FALSE;
	
		tonInitialising(IN := FALSE);
		tonStopping(IN := FALSE);
	
		ipEquipment.RequestStop();
	
		// -----------------------------------------------------
		// LATCH RESET REQUEST
		// -----------------------------------------------------
		IF fbResetTrigger.Q AND NOT blogoutHMI THEN
	
			bFaultResetRequested := TRUE;
			bHmiLogoutFault := FALSE;
			bStopRequestTimeout := FALSE;
	
			fbIndex.Reset();
			fbSiliconeSupportCylinder.Reset();
			fbAssemblySupportCylinder.Reset();
	
			ipEquipment.RequestReset();
	
			bInitialisationTimeoutFault := FALSE;
			bStoppingTimeoutFault := FALSE;
	
			eCycleState := E_CycleState.Disabled;
	
		END_IF


    // -----------------------------------------------------
    // LEAVE FAULT ONLY AFTER ALL COMPONENTS ARE HEALTHY
    // -----------------------------------------------------
    IF bFaultResetRequested
        AND stInputs.stSafety.bSafetyOk
        AND NOT fbIndex.IsFaulted()
        AND NOT fbSiliconeSupportCylinder.IsFaulted()
        AND NOT fbAssemblySupportCylinder.IsFaulted()
        AND NOT fbProcessStation.IsFaulted()
    THEN

        bFaultResetRequested := FALSE;

        eMachineState := E_MachineState.Stopping;

    END_IF
	
	E_MachineState.Stopping:

		tonInitialising(IN := FALSE);
		tonStopping(
			IN := TRUE,
			PT := stConfig.tStoppingTimeout
		);
	
		ipEquipment.RequestStop();
	
		stIndexStatus := fbIndex.GetStatus();
	
		stMainDoorLockStatus := fbMainDoorLock.GetStatus();
	
		eStoppingWaitReason := E_StoppingWaitReason.None;
	
	
		// ---------------------------------------------------------
		// INDEX MUST BE STOPPED
		// ---------------------------------------------------------
	
		IF stIndexStatus.bBusy THEN
		eStoppingWaitReason := E_StoppingWaitReason.IndexStillMoving;
	
	
	ELSIF (stMainDoorLockStatus.eState = E_MainDoorLockState.Locking)
		OR (stMainDoorLockStatus.eState = E_MainDoorLockState.Unlocking)
	THEN
		eStoppingWaitReason := E_StoppingWaitReason.MainDoorTransition;
	END_IF
	
	
		// ---------------------------------------------------------
		// STOPPING COMPLETION
		// ---------------------------------------------------------
	
		bStoppingComplete := eStoppingWaitReason = E_StoppingWaitReason.None;
	
		IF bStoppingComplete THEN
	
			tonStopping(IN := FALSE);
	
			eCycleState := E_CycleState.Disabled;
	
			eMachineState := E_MachineState.Stopped;
	
		ELSIF tonStopping.Q THEN
	
			bStoppingTimeoutFault := TRUE;
			bSafetyDropRequest := TRUE;
				
			eMachineState := E_MachineState.Fault;
				
		END_IF
	
	E_MachineState.Stopped:
	
		eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_Reset := E_LEDs_Mode.FLASHING;
		eMode_LED_PASS  := E_LEDs_Mode.OFF;
		eMode_LED_Fail  := E_LEDs_Mode.OFF;
	
		bStopRequested := FALSE;
		
		
		tonInitialising(IN := FALSE);
		tonStopping(IN := FALSE);
		
		IF blogoutHMI THEN
				bStopRequested := TRUE;
		ELSE
		//ipEquipment.RequestStop();

			// Air may remain enabled after returning from an active machine state,
			// provided that the main door remains closed. Opening the door removes
			// the request. Closing it again does not restore the air in Stopped.
			IF NOT stInputs.bMainDoorClosed THEN
				bAirSupplyEnable := FALSE;
			END_IF
		
			IF NOT GVL_HMI.bIvekSettingsInterlock THEN
		
				IF stCommand.bReset AND stInputs.stSafety.bSafetyOk THEN
					eMachineState := E_MachineState.Initialising;
				END_IF
				
			END_IF
		 END_IF
// 	
	E_MachineState.Initialising:
		// =========================================================
		// TIMERS
		// =========================================================
	
		tonStopping(IN := FALSE);
		tonInitialising(IN := TRUE, PT := stConfig.tInitialiseTimeout);

		eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS := E_LEDs_Mode.OFF;
		eMode_LED_Fail := E_LEDs_Mode.OFF;

		IF NOT stInputs.bMainDoorClosed AND NOT stInputs.bMainDoorFeedback THEN
			eMachineState := E_MachineState.Fault;
		END_IF
		
		// =========================================================
		// AIR SUPPLY
		// =========================================================
		// Initialising restores the pneumatic supply before
		// recovering and validating safe component positions.
		// =========================================================
		
		bAirSupplyEnable := TRUE;
	
		// =========================================================
		// STATE ENTRY
		// =========================================================
	
		IF bMachineStateEntry THEN
	
			// fbProcessCycle.Initialise();
			// fbManualMode.Initialise();
			// fbProcessStation.Initialise();
	
			fbMainDoorLock.Initialise();
	
			// bResultStoredFeedback := FALSE;
	
			bIndexRequestAcceptedFeedback := FALSE;
			bIndexRecoveryRequestAcceptedFeedback := FALSE;
	
			// bProcessStartPulse := FALSE;
	
		END_IF
		// =========================================================
		// CURRENT COMPONENT STATUS
		// =========================================================
	
		stIndexStatus := fbIndex.GetStatus();
		stProcessStationStatus := fbProcessStation.GetStatus();
		stMainDoorLockStatus := fbMainDoorLock.GetStatus();
		
		
		
		
		// =========================================================
		// INITIALISING WAIT REASON
		// =========================================================
		
		eInitialisingWaitReason := E_InitialisingWaitReason.None;
		
		
		// ---------------------------------------------------------
		// AIR SUPPLY MUST BE READY
		// ---------------------------------------------------------
		
		IF NOT stPermissives.bAirSupplyReady THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.AirSupplyNotReady;
		
		
		// ---------------------------------------------------------
		// INDEX MUST NOT BE BUSY
		// ---------------------------------------------------------
		
		ELSIF stIndexStatus.bBusy THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.IndexBusy;
		
		
		// ---------------------------------------------------------
		// SILICONE SUPPORT MUST NOT BE FAULTED
		// ---------------------------------------------------------
		
		ELSIF fbSiliconeSupportCylinder.IsFaulted() THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.SiliconeSupportFaulted;
		
		
		// ---------------------------------------------------------
		// ASSEMBLY SUPPORT MUST NOT BE FAULTED
		// ---------------------------------------------------------
		
		ELSIF fbAssemblySupportCylinder.IsFaulted() THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.AssemblySupportFaulted;
		
		
		// ---------------------------------------------------------
		// SILICONE SUPPORT MUST BE RETRACTED
		// ---------------------------------------------------------
		
		ELSIF NOT stPermissives.bSiliconeSupportHome THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.SiliconeSupportNotRetracted;
		
		
		// ---------------------------------------------------------
		// ASSEMBLY SUPPORT MUST BE RETRACTED
		// ---------------------------------------------------------
		
		ELSIF NOT stPermissives.bAssemblySupportHome THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.AssemblySupportNotRetracted;
		
		
		// ---------------------------------------------------------
		// MAIN DOOR MUST NOT BE FAULTED
		// ---------------------------------------------------------
		
		ELSIF fbMainDoorLock.IsFaulted() THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.MainDoorFaulted;
		
		
		// ---------------------------------------------------------
		// MAIN DOOR MUST BE READY FOR AUTOMATIC OPERATION
		// ---------------------------------------------------------
		
		ELSIF NOT fbMainDoorLock.IsReadyForAutomatic() THEN
		
			eInitialisingWaitReason :=
				E_InitialisingWaitReason.MainDoorNotReady;
		
		END_IF
				
		
		
		// =========================================================
		// INITIALISATION COMPLETE
		// =========================================================
	
		bInitialisationComplete 	:=stPermissives.bInitialisationAllowed;
	
		IF bInitialisationComplete THEN
	
			tonInitialising(IN := FALSE);
			eCycleState := E_CycleState.Disabled;
			eMachineState := E_MachineState.ReadyToStart;
	
		ELSIF tonInitialising.Q THEN
	
			bInitialisationTimeoutFault := TRUE;
			eMachineState := E_MachineState.Fault;
	
		END_IF
	
 	
	E_MachineState.ReadyToStart:
		
		eMode_LED_Start := E_LEDs_Mode.FLASHING;
		eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS  := E_LEDs_Mode.OFF;
		eMode_LED_Fail  := E_LEDs_Mode.OFF;
		
		
		tonInitialising(IN := FALSE);
		tonStopping(IN := FALSE);
	
		IF bStopRequested THEN
	
			eMachineState := E_MachineState.Stopping;

		ELSIF stCommand.bManualRequest
			AND stInputs.stSafety.bSafetyOk
			AND NOT stIndexStatus.bBusy
			AND NOT fbIndex.IsFaulted()
			//AND NOT fbProcessStation.IsFaulted()
			//AND NOT ipEquipment.IsFaulted()
		THEN
	
			fbManualMode.Initialise();
			eMachineState := E_MachineState.Manual;
	
		ELSIF stCommand.bStart
			AND fbMainDoorLock.IsReadyForAutomatic()
		THEN
	
			eCycleState := E_CycleState.Disabled;
			eMachineState := E_MachineState.AutoCycle;
	
		END_IF
// 	
	E_MachineState.AutoCycle:
	
		eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_Reset := E_LEDs_Mode.OFF;

		// -----------------------------------------------------
		// OPERATOR RESULT LED INDICATION
		// -----------------------------------------------------
		// Same behaviour as the original implementation:
		//
		// PASS = valid result AND passed
		// FAIL = valid result AND not passed
		// -----------------------------------------------------
	
		IF stOperatorNest.stResult.bValid THEN
	
			IF stOperatorNest.stResult.bPassed THEN
	
				eMode_LED_PASS := E_LEDs_Mode.ON;
				eMode_LED_Fail := E_LEDs_Mode.OFF;
	
			ELSE
	
				eMode_LED_PASS := E_LEDs_Mode.OFF;
				eMode_LED_Fail := E_LEDs_Mode.ON;
	
			END_IF
	
		ELSE
	
			eMode_LED_PASS := E_LEDs_Mode.OFF;
			eMode_LED_Fail := E_LEDs_Mode.OFF;
	
		END_IF;

		tonInitialising(IN := FALSE);
		tonStopping(IN := FALSE);

	
		// PROCESS CYCLE INPUT MAPPING
		stProcessCycleInputs.bSafetyOk := stInputs.stSafety.bSafetyOk;
		stProcessCycleInputs.bTwoHandsSafe := stInputs.bTwoHandsSafe;
		
		// PROCESS REQUIREMENTS
		stProcessCycleInputs.bSiliconeProcessRequired := stSiliconeNest.bEnabled AND stSiliconeNest.bPartComplete AND NOT stSiliconeNest.stResult.bValid;
		
		stProcessCycleInputs.bAssemblyProcessRequired := stAssemblyNest.bEnabled AND stAssemblyNest.bPartComplete AND NOT stAssemblyNest.stResult.bValid;
			
		// Indexer
		stProcessCycleInputs.bIndexPositionValid := stInputs.eIndexPosition <> E_TablePosition.Unknown;
		stProcessCycleInputs.bIndexMoveAllowed := stPermissives.bIndexMoveAllowed AND stInputs.bSiliconeSupportRetracted AND stInputs.bAssemblySupportRetracted;
		stProcessCycleInputs.bIndexReady := fbIndex.IsReady();
		stProcessCycleInputs.bIndexLocked := stInputs.bIndexLocked;
		stProcessCycleInputs.bIndexBusy := stIndexStatus.bBusy;
		stProcessCycleInputs.bIndexDone := fbIndex.IsDone();
		stProcessCycleInputs.bIndexSamePositionDetected := stIndexStatus.bSamePositionDetected;
		stProcessCycleInputs.bIndexFaulted := fbIndex.IsFaulted();
		stProcessCycleInputs.bIndexRequestAccepted := bIndexRequestAcceptedFeedback;
		stProcessCycleInputs.bIndexRecoveryRequestAccepted := bIndexRecoveryRequestAcceptedFeedback;
		
		// Silicone Support
		stProcessCycleInputs.bSiliconeSupportExtended := stInputs.bSiliconeSupportExtended;
		stProcessCycleInputs.bSiliconeSupportRetracted := stInputs.bSiliconeSupportRetracted;
		stProcessCycleInputs.bSiliconeSupportFaulted := fbSiliconeSupportCylinder.IsFaulted();
	
		// Assembly Support
		stProcessCycleInputs.bAssemblySupportExtended := stInputs.bAssemblySupportExtended;
		stProcessCycleInputs.bAssemblySupportRetracted := stInputs.bAssemblySupportRetracted;
		stProcessCycleInputs.bAssemblySupportFaulted := fbAssemblySupportCylinder.IsFaulted();
	
		// FUTURE PROCESS INPUTS
		// stProcessNest := fbNestManager.GetNestAtPosition(stConfig.eProcessPosition);
		// stProcessCycleInputs.bProcessNestEnabled := stProcessNest.bEnabled;
		// stProcessCycleInputs.bReservoirPartPresent := stInputs.bReservoirPartPresent;
		// stProcessCycleInputs.bProcessResultAlreadyValid := stProcessNest.stResult.bValid;
		// stProcessCycleInputs.bProcessStationReady := fbProcessStation.IndexPermissive() AND NOT fbProcessStation.IsFaulted();
		// stProcessCycleInputs.bProcessStationBusy := ipEquipment.IsBusy();
		// stProcessCycleInputs.bProcessStationComplete := fbProcessStation.IsComplete();
		// stProcessCycleInputs.bProcessStationFaulted := fbProcessStation.IsFaulted();
		// stProcessCycleInputs.bResultStored := bResultStoredFeedback;
		stProcessCycleInputs.bOperatorExchangeComplete := fbOperatorStation.IsComplete();
	
			// =========================================================
		// SILICONE PROCESS STATUS
		// =========================================================
		
		stProcessCycleInputs.bSiliconeProcessReady 		:=fbSiliconeProcess.IsReady();
		stProcessCycleInputs.bSiliconeProcessBusy 		:=fbSiliconeProcess.IsBusy();
		stProcessCycleInputs.bSiliconeProcessComplete 	:=fbSiliconeProcess.IsDone();
		stProcessCycleInputs.bSiliconeProcessFaulted 	:=fbSiliconeProcess.IsFaulted();

		// =========================================================
		// ASSEMBLY PROCESS STATUS
		// =========================================================
		
		stProcessCycleInputs.bAssemblyProcessReady 		:=fbAssemblyProcess.IsReady();
		stProcessCycleInputs.bAssemblyProcessBusy 		:=fbAssemblyProcess.IsBusy();
		stProcessCycleInputs.bAssemblyProcessComplete 	:=fbAssemblyProcess.IsDone();
		stProcessCycleInputs.bAssemblyProcessFaulted 	:=fbAssemblyProcess.IsFaulted();
	
	
		// PROCESS CYCLE EXECUTION
		fbProcessCycle.Cyclic(
			bEnable := TRUE,
			bStopRequest := bStopRequested,
			bResetRequest := stCommand.bReset,
			stInputs := stProcessCycleInputs,
			stRequests => stProcessCycleRequests,
			stStatus => stProcessCycleStatus
		);
		
		// =========================================================
		// SILICONE PROCESS RESULT HANDLING
		// =========================================================
		
		IF fbSiliconeProcess.IsDone() THEN
		
			stLastResult := fbSiliconeProcess.GetResult();
		
			bResultStoredFeedback := fbNestManager.StoreSiliconeResultAtPosition( ePosition := stConfig.eSiliconePosition, stResult := stLastResult );
		
			IF bResultStoredFeedback THEN
				fbSiliconeProcess.RequestReset();
			END_IF
		
		END_IF
		// =========================================================
		// ASSEMBLY PROCESS RESULT HANDLING
		// =========================================================
		
		IF fbAssemblyProcess.IsDone() THEN
		
			// -----------------------------------------------------
			// STORE ASSEMBLY RESULT
			// -----------------------------------------------------
		
			stLastResult := fbAssemblyProcess.GetResult();
		
			bResultStoredFeedback := fbNestManager.StoreAssemblyResultAtPosition( ePosition := stConfig.eAssemblyPosition, stResult := stLastResult );
		
			IF bResultStoredFeedback THEN
		
				// -------------------------------------------------
				// READ UPDATED NEST AT ASSEMBLY POSITION
				// -------------------------------------------------
		
				stAssemblyNest := fbNestManager.GetNestAtPosition( stConfig.eAssemblyPosition );
		
				// -------------------------------------------------
				// CALCULATE FINAL RESULT
				// -------------------------------------------------
		
				stLastResult.bValid := stAssemblyNest.stSiliconeResult.bValid AND stAssemblyNest.stAssemblyResult.bValid;
		
				stLastResult.bPassed := stLastResult.bValid AND stAssemblyNest.stSiliconeResult.bPassed AND stAssemblyNest.stAssemblyResult.bPassed;
		
				// -------------------------------------------------
				// STORE FINAL RESULT IN NEST
				// -------------------------------------------------
		
				bResultStoredFeedback := fbNestManager.StoreResultAtPosition( ePosition := stConfig.eAssemblyPosition, stResult := stLastResult );
		
				// -------------------------------------------------
				// RESET ASSEMBLY PROCESS
				// -------------------------------------------------
		
				IF bResultStoredFeedback THEN
					fbAssemblyProcess.RequestReset();
				END_IF
		
			END_IF
		
		END_IF
		
		// =========================================================
		// STATION PROCESS REQUEST EXECUTION
		// =========================================================
		
		// Silicone Process
		IF stProcessCycleRequests.bStartSiliconeProcess THEN
			fbSiliconeProcess.RequestStart();
		END_IF
		
		IF stProcessCycleRequests.bStopSiliconeProcess THEN
			fbSiliconeProcess.RequestStop();
		END_IF
		
		
		// Assembly Process
		IF stProcessCycleRequests.bStartAssemblyProcess THEN
			fbAssemblyProcess.RequestStart();
		END_IF
		
		IF stProcessCycleRequests.bStopAssemblyProcess THEN
			fbAssemblyProcess.RequestStop();
		END_IF
		
		
			//Timeout process
		tonAutoCycleIdleTimeout(
			IN := stProcessCycleStatus.eState = E_CycleState.WaitingForProcessCycleTrigger,
			PT := T#2M
		);
		
		// FEEDBACK DEFAULTS
		bIndexRequestAcceptedFeedback := FALSE;
		bIndexRecoveryRequestAcceptedFeedback := FALSE;
		// bResultStoredFeedback := FALSE;
	
		// INDEX REQUEST EXECUTION
		IF stProcessCycleRequests.bRequestIndex THEN
			bIndexRequestAcceptedFeedback := fbIndex.RequestMove();
		END_IF
	
		IF stProcessCycleRequests.bRequestIndexRecovery THEN
			bIndexRecoveryRequestAcceptedFeedback := fbIndex.RequestPositionRecovery();
		END_IF
	
		// FUTURE PROCESS REQUEST EXECUTION
		// IF stProcessCycleRequests.bStartProcessStation THEN
		//     ipEquipment.RequestStart();
		// END_IF
	
		// IF stProcessCycleRequests.bStopProcessStation THEN
		//     ipEquipment.RequestStop();
		// END_IF
	
		// IF stProcessCycleRequests.bCaptureProcessResult THEN
		//     stLastResult := fbProcessStation.GetResult();
		// END_IF
	
		// IF stProcessCycleRequests.bStoreProcessResult THEN
		//     stLastResult := fbProcessStation.GetResult();
		//     bResultStoredFeedback := fbNestManager.StoreResultAtPosition(
		//         ePosition := stConfig.eProcessPosition,
		//         stResult := stLastResult
		//     );
		//
		//     IF bResultStoredFeedback THEN
		//         fbIndex.ReleaseProcessPosition();
		//     END_IF
		// END_IF
	
		// IF stProcessCycleRequests.bConfirmOperatorExchange THEN
		//     fbNestManager.MarkDispositionComplete(stConfig.eOperatorPosition);
		//     fbIndex.ConfirmOperatorExchange();
		// END_IF
	
		// IF stProcessCycleRequests.bUpdateNestPositions THEN
		//     fbNestManager.ClearOperatorNest(stConfig.eOperatorPosition);
		// END_IF
	
		// PROCESS CYCLE FAULT
		IF stProcessCycleStatus.bFaulted THEN
			eMachineState := E_MachineState.Fault;
		END_IF
	
		// LEAVE AUTO CYCLE
		IF bStopRequested
			AND stProcessCycleStatus.eState = E_CycleState.Disabled
		THEN
			eMachineState := E_MachineState.Stopping;
		END_IF
		
		IF tonAutoCycleIdleTimeout.Q THEN
			 bStopRequested := TRUE;
		END_IF
// 	
	E_MachineState.Manual:

		eMode_LED_Start := E_LEDs_Mode.OFF;
		eMode_LED_Reset := E_LEDs_Mode.OFF;
		eMode_LED_PASS  := E_LEDs_Mode.OFF;
		eMode_LED_Fail  := E_LEDs_Mode.OFF;
		
		tonInitialising(IN := FALSE);
		tonStopping(IN := FALSE);
		
		// ---------------------------------------------------------
		// INDEX MANUAL MOVEMENT
		// ---------------------------------------------------------
		IF stManualModeRequests.bIndexMoveRequest THEN
	
			bManualIndexRequestAccepted := fbIndex.RequestManualMove();
	
		END_IF
	
	
		// ---------------------------------------------------------
		// INDEX RESET / HOME
		// ---------------------------------------------------------
		// At this stage the home command resets the pneumatic index sequence.
		// A dedicated homing method can be introduced later if required.
		IF stManualModeRequests.bIndexHomeRequest THEN
	
			fbIndex.Reset();
	
		END_IF
	
	
		// ---------------------------------------------------------
		// PROCESS EQUIPMENT MANUAL COMMANDS
		// ---------------------------------------------------------
		IF stManualModeRequests.bEquipmentStart THEN
	
			ipEquipment.RequestStart();
	
		END_IF
	
		IF stManualModeRequests.bEquipmentStop THEN
	
			ipEquipment.RequestStop();
	
		END_IF
	
		IF stManualModeRequests.bEquipmentReset THEN
	
			ipEquipment.RequestReset();
	
		END_IF
	
		// ---------------------------------------------------------
		// LEAVE MANUAL MODE
		// ---------------------------------------------------------
		//
		// The Manual Mode coordinator first returns all manually
		// controlled components to their standard state.
		//
		// Machine state may leave Manual only after the coordinator
		// confirms that the exit sequence is complete.
		// ---------------------------------------------------------
		
		IF bStopRequested
			AND stManualModeStatus.bSafeToExit
		THEN
			eMachineState := E_MachineState.Stopping;
		END_IF
		
END_CASE



// =========================================================
// PROCESS CYCLE DISABLE HANDLING
// =========================================================
IF eMachineState <> E_MachineState.AutoCycle THEN
	fbProcessCycle.Cyclic(
        bEnable := FALSE,
        bResetRequest := stCommand.bReset,
        bStopRequest := TRUE,
        stInputs := stProcessCycleInputs,
        stRequests =>stProcessCycleRequests,
        stStatus =>stProcessCycleStatus);
END_IF

    

// =========================================================
// CYCLIC COMPONENT EXECUTION
// =========================================================
// =========================================================
// SUPPORT COMMAND SELECTION
// =========================================================

bSiliconeSupportRaiseRequest := FALSE;
bSiliconeSupportLowerRequest := FALSE;
bAssemblySupportRaiseRequest := FALSE;
bAssemblySupportLowerRequest := FALSE;


// ---------------------------------------------------------
// INITIALISING
// ---------------------------------------------------------
// Return both process supports to their standard
// safe retracted position before ReadyToStart.
// ---------------------------------------------------------

IF eMachineState = E_MachineState.Initialising THEN

    // Supports may only be recovered after the pneumatic
    // supply has been confirmed by TwinSAFE.
    IF stPermissives.bAirSupplyReady THEN

        bSiliconeSupportLowerRequest := TRUE;
        bAssemblySupportLowerRequest := TRUE;

    END_IF


// ---------------------------------------------------------
// MANUAL MODE
// ---------------------------------------------------------

ELSIF eMachineState = E_MachineState.Manual THEN

    bSiliconeSupportRaiseRequest := stManualModeRequests.bSiliconeSupportExtend;
    bSiliconeSupportLowerRequest := stManualModeRequests.bSiliconeSupportRetract;

    bAssemblySupportRaiseRequest := stManualModeRequests.bAssemblySupportExtend;
    bAssemblySupportLowerRequest := stManualModeRequests.bAssemblySupportRetract;


// ---------------------------------------------------------
// AUTOMATIC CYCLE
// ---------------------------------------------------------

ELSIF eMachineState = E_MachineState.AutoCycle THEN

    bSiliconeSupportRaiseRequest := stProcessCycleRequests.bSiliconeSupportExtend;
    bSiliconeSupportLowerRequest := stProcessCycleRequests.bSiliconeSupportRetract;

    bAssemblySupportRaiseRequest := stProcessCycleRequests.bAssemblySupportExtend;
    bAssemblySupportLowerRequest := stProcessCycleRequests.bAssemblySupportRetract;

END_IF



// =========================================================
// SILICONE SUPPORT CONTROL
// =========================================================

fbSiliconeSupportCylinder.Cyclic(
	bEnable := (eMachineState = E_MachineState.Initialising)
				OR (eMachineState = E_MachineState.Manual)
				OR (eMachineState = E_MachineState.AutoCycle),
    bRaiseRequest := bSiliconeSupportRaiseRequest,
    bLowerRequest := bSiliconeSupportLowerRequest,
    bStopRequest := (eMachineState = E_MachineState.Stopping)
        OR (eMachineState = E_MachineState.Fault),
    bExtended := stInputs.bSiliconeSupportExtended,
    bRetracted := stInputs.bSiliconeSupportRetracted,
    tMovementTimeout := stConfig.tCylinderTimeout,
    bExtendOutput => stOutputsInternal.bSiliconeSupportExtend,
    bRetractOutput => stOutputsInternal.bSiliconeSupportRetract
);

// =========================================================
// ASSEMBLY SUPPORT CONTROL
// =========================================================

fbAssemblySupportCylinder.Cyclic(
	bEnable := (eMachineState = E_MachineState.Initialising)
				OR (eMachineState = E_MachineState.Manual)
				OR (eMachineState = E_MachineState.AutoCycle),
    bRaiseRequest := bAssemblySupportRaiseRequest,
    bLowerRequest := bAssemblySupportLowerRequest,
    bStopRequest := (eMachineState = E_MachineState.Stopping)
        OR (eMachineState = E_MachineState.Fault),
    bExtended := stInputs.bAssemblySupportExtended,
    bRetracted := stInputs.bAssemblySupportRetracted,
    tMovementTimeout := stConfig.tCylinderTimeout,
    bExtendOutput => stOutputsInternal.bAssemblySupportExtend,
    bRetractOutput => stOutputsInternal.bAssemblySupportRetract
);

// Cyclic component execution
fbProcessStation.Cyclic(
    bEnable :=
    (eMachineState = E_MachineState.Initialising)
    OR
    (eMachineState = E_MachineState.AutoCycle),
    bAutomaticStartRequest 			:= bProcessStartPulse,
    bManualEnable 					:= eMachineState = E_MachineState.Manual,
	bAirSupplySafe 					:= GVL_Safety.bAirSupplySafe,
    bManualExtendRequest 			:= FALSE,
    bManualRetractRequest 			:= FALSE,
    bStopRequest 					:= (eMachineState = E_MachineState.Stopping) OR (eMachineState = E_MachineState.Fault),
    bResetRequest 					:= stCommand.bReset,
    bPartPresent					:= stInputs.bReservoirPartPresent,
    bProcessPermissive 				:= stPermissives.bProcessStartAllowed,
    bIndexReady 					:= stInputs.bIndexReady,
    bIndexLocked 					:= stInputs.bIndexLocked,
    bIndexBusy 						:= stIndexStatus.bBusy,
    bProcessSafetyPermitted 		:= stInputs.stSafety.bProcessSafetyPermitted,
    bMainDoorSafe 					:= stInputs.stSafety.bMainDoorSafe,
    bCylinderExtended 				:= stInputs.bSiliconeSupportExtended,
    bCylinderRetracted 				:= stInputs.bSiliconeSupportRetracted,
    tCylinderTimeout 				:= stConfig.tCylinderTimeout,
    tProcessTimeout 				:= stConfig.tProcessTimeout,
    bCylinderExtendOutput 			=> bProcExtend,
    bCylinderRetractOutput 			=> bProcRetract
);

// =========================================================
// MAIN DOOR LOCK CONTROL
// =========================================================

fbMainDoorLock.Cyclic(
    bEnableAutomatic := bAirAndDoorEnable,

    bManualEnable := FALSE,
    bManualLockRequest := FALSE,
    bManualUnlockRequest := FALSE,

    bStopRequest :=
        (eMachineState = E_MachineState.Fault)
        OR (eMachineState = E_MachineState.Stopping)
        OR (eMachineState = E_MachineState.Stopped),

    bResetRequest := stCommand.bReset,

    bDoorClosed := stInputs.bMainDoorClosed,
	bDoorLocked := stInputs.bMainDoorLocked,
	bDoorUnsafe := stInputs.bMainDoorUnsafe,

    bIndexBusy := stIndexStatus.bBusy,
    bProcessSafePosition := fbProcessStation.IsSafePosition(),

    tLockTimeout := GVL_config.stMachine.tDoorLockTimeout,
    tUnlockTimeout := GVL_config.stMachine.tDoorUnlockTimeout
);

stMainDoorLockStatus := fbMainDoorLock.GetStatus();

// The standard PLC only requests that the door be locked.
// TwinSAFE validates the safe conditions and controls the physical locker.
stOutputsInternal.bMainDoorLockRequest := bAirAndDoorEnable;

// =========================================================
// INDEX TABLE CONTROL
// =========================================================
fbIndex.Cyclic(
    bEnable := (eMachineState = E_MachineState.Initialising)
        OR (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (eMachineState = E_MachineState.Manual)
        OR (eMachineState = E_MachineState.Stopping),
    bReset := stCommand.bReset,
    bAutomaticMode := eMachineState = E_MachineState.AutoCycle,
    bManualMode := eMachineState = E_MachineState.Manual,
    bMovePermissive :=
    (
        (eMachineState = E_MachineState.AutoCycle)
        AND stInputs.bSiliconeSupportRetracted
        AND stInputs.bAssemblySupportRetracted
        AND
        (
            stPermissives.bIndexMoveAllowed
            OR
            (
                (stInputs.eIndexPosition = E_TablePosition.Unknown)
                AND stInputs.stSafety.bMotionSafetyPermitted
            )
        )
    )
    OR
    (
        stManualModeStatus.bIndexPermissive
        AND (eMachineState = E_MachineState.Manual)
    ),
    bSafetyMotionPermitted := stInputs.stSafety.bMotionSafetyPermitted,
    bTwoHandsSafe := stInputs.bTwoHandsSafe,
    bStationsHome := stInputs.bSiliconeSupportRetracted,
    bProcessToolingRetracted := stInputs.bSiliconeSupportRetracted,
    bTableReady := stInputs.bIndexReady,
    bTableLocked := stInputs.bIndexLocked,
    bCompletedSensor := stInputs.bIndexCompletedSensor,
    bSupportExtended := stInputs.bIndexSupportExtended,
    bSupportRetracted := stInputs.bIndexSupportRetracted,
    eCurrentPosition := stInputs.eIndexPosition,
    tRotateDelay := stConfig.tIndexRotateDelay,
    tStopDelay := stConfig.tIndexStopDelay,
    tSupportTimeout := stConfig.tIndexSupportTimeout,
    tMovementTimeout := stConfig.tIndexTimeout,
    tTwoHandHold := stConfig.tTwoHandHold,
    tTwoHandRecoveryTimeout := stConfig.tTwoHandRecoveryTimeout,
    bRotatePortA => stOutputsInternal.bIndexRotatePortA,
    bStopPortB => stOutputsInternal.bIndexStopPortB,
    bSupportExtendRequest => stOutputsInternal.bIndexSupportExtend,
    bSupportRetractRequest => stOutputsInternal.bIndexSupportRetract);
	

// =========================================================
// COMPONENT FAULT AGGREGATION
// =========================================================
	CheckComponentFaults();

// =========================================================
// PLC FAULT TO TWINSAFE RUN-DROP PULSE
// =========================================================

// Convert the one-scan internal request into a timed TwinSAFE run drop.
// This block must execute after the machine-state logic because fault
// transitions inside the CASE generate bSafetyDropRequest.
tpSafetyRunDrop(
    IN := bSafetyDropRequest,
    PT := T#500MS
);


// =========================================================
// EVENT-DRIVEN MACHINE TRANSITIONS
// =========================================================

// IF stInputs.bEventFault THEN
//     eMachineState := E_MachineState.Fault;
// ELSIF stInputs.bEventCycleStopRequest
//       AND (eMachineState = E_MachineState.AutoCycle OR eMachineState = E_MachineState.Manual)
// THEN
//     eMachineState := E_MachineState.Stopping;
// END_IF

// =========================================================
// MACHINE OUTPUT MAPPING
// =========================================================

// Outputs and public status
stOutputsInternal.bAirSupplyEnable := bAirSupplyEnable;
// An internal PLC machine fault temporarily removes the TwinSAFE run request.
// The request returns automatically after the configured TP duration.
stOutputsInternal.bSafetyRunRequest := NOT tpSafetyRunDrop.Q;
//stOutputsInternal.bSafetyRunRequest := TRUE;
stOutputsInternal.bSafetyResetRequest := stCommand.bReset AND NOT stInputs.stSafety.bSafetyOk;

stOutputsInternal.bSafetyErrorAcknowledgementRequest :=stOutputsInternal.bSafetyResetRequest;

// stOutputsInternal.bLedStart 		:= eMachineState = E_MachineState.ReadyToStart;
// stOutputsInternal.bLedReset 		:= eMachineState = E_MachineState.Fault OR eMachineState = E_MachineState.Stopped;
// // Result LEDs represent only the part currently
// // located at the operator position.
// stOutputsInternal.bLedPass 			:= stOperatorNest.stResult.bValid AND stOperatorNest.stResult.bPassed;
// stOutputsInternal.bLedFail 			:= (stOperatorNest.stResult.bValid AND NOT stOperatorNest.stResult.bPassed) OR eMachineState = E_MachineState.Fault;
stOutputsInternal.bInternalLight 	:= TRUE;
stOutputsInternal.bExternalLight 	:= stCommand.bExternalLight;


// =========================================================
// LED OUTPUT MAPPING
// =========================================================
	
	// START LED
	CASE eMode_LED_Start OF
		
		E_LEDs_Mode.OFF:stOutputsInternal.bLedStart := FALSE;
		E_LEDs_Mode.ON:stOutputsInternal.bLedStart := TRUE;
		E_LEDs_Mode.FLASHING:stOutputsInternal.bLedStart := bLedBlink;
	
	END_CASE
	// RESET LED
	CASE eMode_LED_Reset OF
	
		E_LEDs_Mode.OFF:stOutputsInternal.bLedReset := FALSE;
		E_LEDs_Mode.ON:stOutputsInternal.bLedReset := TRUE;
		E_LEDs_Mode.FLASHING:stOutputsInternal.bLedReset := bLedBlink;
	
	END_CASE
	// PASS LED
	CASE eMode_LED_PASS OF
	
		E_LEDs_Mode.OFF:stOutputsInternal.bLedPass := FALSE;
		E_LEDs_Mode.ON:stOutputsInternal.bLedPass := TRUE;
		E_LEDs_Mode.FLASHING:stOutputsInternal.bLedPass := bLedBlink;
	
	END_CASE	
	// FAIL LED
	CASE eMode_LED_Fail OF
		E_LEDs_Mode.OFF:stOutputsInternal.bLedFail := FALSE;
		E_LEDs_Mode.ON:stOutputsInternal.bLedFail := TRUE;
		E_LEDs_Mode.FLASHING:stOutputsInternal.bLedFail := bLedBlink;
	
	END_CASE


// =========================================================
// EQUIPMENT OUTPUT DATA
// =========================================================

stIvekOutput := fbIvek.stCyclicOut;
// =========================================================
// PUBLIC MACHINE STATUS
// =========================================================

stStatus.eMachineState 			:= eMachineState;
stStatus.eCycleState 			:= stProcessCycleStatus.eState;
stStatus.stProcessCycle 		:= stProcessCycleStatus;
stStatus.stProcessStation 		:= stProcessStationStatus;
stStatus.stMainDoorLock 		:= stMainDoorLockStatus;
stStatus.eInitialisingWaitReason := eInitialisingWaitReason;
stStatus.eStoppingWaitReason 	:= eStoppingWaitReason;
stIndexStatus 					:= fbIndex.GetStatus();
stStatus.eIndexState 			:= stIndexStatus.eState;
stStatus.stIndexStatus 			:= stIndexStatus;
stStatus.eEquipmentState 		:= ipEquipment.GetState();
stStatus.eOperatorExchangeState := fbOperatorStation.GetState();
stStatus.eOperatorInstruction 	:= fbOperatorStation.GetInstruction();
stStatus.stOperatorStation 		:= stOperatorStatus;
stStatus.eManualModeState 		:= stManualModeStatus.eState;
stStatus.stManualMode 			:= stManualModeStatus;
stStatus.bReady 				:= eMachineState = E_MachineState.ReadyToStart;
stStatus.bBusy 					:= eMachineState = E_MachineState.AutoCycle;
stStatus.bFaulted 				:= eMachineState = E_MachineState.Fault;
stStatus.bInitialisationTimeoutFault := bInitialisationTimeoutFault;
stStatus.bHmiLogoutFault 		:= bHmiLogoutFault;
stStatus.bStoppingTimeoutFault 	:= bStoppingTimeoutFault;
stStatus.bSafetyStopRequested 	:= tpSafetyRunDrop.Q;
stStatus.bSafetyRunRequested 	:= stOutputsInternal.bSafetyRunRequest;
stStatus.bEventFault 			:= stInputs.bEventFault;
stStatus.bStopRequestTimeout 	:= bStopRequestTimeout;

stStatus.bIndexPermissive 		:= stPermissives.bIndexMoveAllowed;
stStatus.bProcessPermissive 	:= stPermissives.bProcessStartAllowed;
stStatus.stPermissives 			:= stPermissives;
stStatus.stLastResult 			:= stLastResult;
stStatus.bEnableSetting 		:= eMachineState = E_MachineState.Stopped;
GVL_Persistent.stStatistics.aNest := fbNestManager.GetAllNestStatistics();
stStatus.bSiliconeSupportFaulted := fbSiliconeSupportCylinder.IsFaulted();
stStatus.bAssemblySupportFaulted := fbAssemblySupportCylinder.IsFaulted();

// 
// 
// GVL_Persistent.stStatistics.udiTotalCycles :=
//     GVL_Persistent.stStatistics.aNest[1].udiTotalTests
//     + GVL_Persistent.stStatistics.aNest[2].udiTotalTests
//     + GVL_Persistent.stStatistics.aNest[3].udiTotalTests
//     + GVL_Persistent.stStatistics.aNest[4].udiTotalTests;
// 
// GVL_Persistent.stStatistics.udiTotalPass :=
//     GVL_Persistent.stStatistics.aNest[1].udiGoodParts
//     + GVL_Persistent.stStatistics.aNest[2].udiGoodParts
//     + GVL_Persistent.stStatistics.aNest[3].udiGoodParts
//     + GVL_Persistent.stStatistics.aNest[4].udiGoodParts;
// 
// GVL_Persistent.stStatistics.udiTotalFail :=
//     GVL_Persistent.stStatistics.aNest[1].udiBadParts
//     + GVL_Persistent.stStatistics.aNest[2].udiBadParts
//     + GVL_Persistent.stStatistics.aNest[3].udiBadParts
//     + GVL_Persistent.stStatistics.aNest[4].udiBadParts;
// 	
	
	
// =========================================================
// ACTIVE FAULT SUMMARY FOR MAIN HMI GRID
// =========================================================

// This summary represents only the faults currently responsible for the
// machine Fault state. The Events system keeps the complete alarm history
// independently for the dedicated Alarm page.
IF eMachineState = E_MachineState.Fault THEN

    stStatus.stAlarms.bHasFault := TRUE;
    stStatus.stAlarms.bHasSafetyStopFault := NOT stInputs.stSafety.bSafetyOk;

    stStatus.stAlarms.uiActiveCount := 0;

    IF NOT stInputs.stSafety.bSafetyOk THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

    IF bInitialisationTimeoutFault THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

    IF bStoppingTimeoutFault THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF
	IF fbSiliconeSupportCylinder.IsFaulted() THEN
		stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
	END_IF
	
	IF fbAssemblySupportCylinder.IsFaulted() THEN
		stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
	END_IF
    IF fbMainDoorLock.IsFaulted() THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

    IF fbIndex.IsFaulted() THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

    IF fbProcessStation.IsFaulted() THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

    IF ipEquipment.IsFaulted() THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

    IF stInputs.bEventFault THEN
        stStatus.stAlarms.uiActiveCount := stStatus.stAlarms.uiActiveCount + 1;
    END_IF

ELSE

    // Clear only the active-fault summary used by the main screen.
    // Do not acknowledge, clear or delete the Events history here.
    stStatus.stAlarms.bHasFault := FALSE;
    stStatus.stAlarms.bHasSafetyStopFault := FALSE;
    stStatus.stAlarms.uiActiveCount := 0;

END_IF

stStatus.stAlarms.eHighestAlarm 			:= E_AlarmId.None;
stStatus.aNest 								:= fbNestManager.GetAllNests();
stStatus.aNestStatistics 					:= fbNestManager.GetAllNestStatistics();
stStatus.udiAlarmCode 						:= 0;
stStatus.sOperatorMessage 					:= fbOperatorStation.GetMessage();
// =========================================================
// MACHINE MESSAGE SELECTION
// =========================================================

// Row 0 of the event DataGrid is exclusively the current automatic-cycle instruction.
IF eMachineState = E_MachineState.AutoCycle THEN
    IF fbOperatorStation.GetInstruction() <> E_OperatorInstruction.None THEN
        stStatus.sMachineMessage := fbOperatorStation.GetMessage();
    ELSE
        stStatus.sMachineMessage := stProcessCycleStatus.sMessage;
    END_IF
	
ELSIF eMachineState = E_MachineState.Manual THEN
    stStatus.sMachineMessage := stManualModeStatus.sMessage;
	
ELSIF eMachineState = E_MachineState.Initialising THEN
    CASE eInitialisingWaitReason OF
		E_InitialisingWaitReason.MainDoorNotReady:stStatus.sMachineMessage 			:='System initialising - waiting for main door to lock';
        E_InitialisingWaitReason.SafetyNotReady: stStatus.sMachineMessage			:= 'System initialising - waiting for Safety OK';
        E_InitialisingWaitReason.FsoeNotReady: stStatus.sMachineMessage 			:= 'System initialising - waiting for FSoE';
        E_InitialisingWaitReason.SafetyLogicNotReady: stStatus.sMachineMessage 		:= 'System initialising - waiting for TwinSAFE logic';
        E_InitialisingWaitReason.IndexBusy: stStatus.sMachineMessage 				:= 'System initialising - waiting for index to stop';
        E_InitialisingWaitReason.SiliconeSupportNotRetracted:stStatus.sMachineMessage := 'System initialising - waiting for Silicone Support Cylinder retract';
		E_InitialisingWaitReason.AssemblySupportNotRetracted:stStatus.sMachineMessage := 'System initialising - waiting for Assembly Support Cylinder retract';
		E_InitialisingWaitReason.SiliconeSupportFaulted:stStatus.sMachineMessage 	:= 'System initialising - Silicone Support Cylinder fault';
		E_InitialisingWaitReason.AssemblySupportFaulted: stStatus.sMachineMessage 	:= 'System initialising - Assembly Support Cylinder fault';
        E_InitialisingWaitReason.ProcessStationFaulted: stStatus.sMachineMessage 	:= 'System initialising - process station fault';
        E_InitialisingWaitReason.MainDoorFaulted: stStatus.sMachineMessage 			:= 'System initialising - main door lock fault';
        E_InitialisingWaitReason.ProcessEquipmentNotReady: stStatus.sMachineMessage := 'System initialising - waiting for process equipment';
   		E_InitialisingWaitReason.AirSupplyNotReady:stStatus.sMachineMessage 		:= 'System initialising - waiting for air supply';


 ELSE stStatus.sMachineMessage 													:= 'System initialising'; 
		
		
		
END_CASE
	
ELSIF eMachineState = E_MachineState.ReadyToStart THEN
    stStatus.sMachineMessage := 'Ready to start';
	
	
ELSIF eMachineState = E_MachineState.Stopping THEN
    CASE eStoppingWaitReason OF
        E_StoppingWaitReason.IndexStillMoving:
            stStatus.sMachineMessage := 'System stopping - waiting for index';
        E_StoppingWaitReason.SiliconeSupportRetracting:
            stStatus.sMachineMessage := 'System stopping - retracting Silicone Support Cylinder';
		E_StoppingWaitReason.AssemblySupportRetracting:
            stStatus.sMachineMessage := 'System stopping - retracting Assembly Support Cylinder';
        E_StoppingWaitReason.ProcessEquipmentStopping:
            stStatus.sMachineMessage := 'System stopping - stopping process equipment';
        E_StoppingWaitReason.MainDoorTransition:
            stStatus.sMachineMessage := 'System stopping - waiting for main door transition';
    ELSE
        stStatus.sMachineMessage := 'System stopping';
    END_CASE
	
	
ELSIF eMachineState = E_MachineState.Fault THEN

    IF NOT stInputs.stSafety.bSafetyOk THEN

        stStatus.sMachineMessage :=
            'Machine fault - safety system not ready';


    // ---------------------------------------------------------
    // SILICONE SUPPORT FAULT
    // ---------------------------------------------------------

    ELSIF fbSiliconeSupportCylinder.IsFaulted() THEN

        stStatus.sMachineMessage :=
            'Machine fault - Silicone Support Cylinder feedback fault';


    // ---------------------------------------------------------
    // ASSEMBLY SUPPORT FAULT
    // ---------------------------------------------------------

    ELSIF fbAssemblySupportCylinder.IsFaulted() THEN

        stStatus.sMachineMessage :=
            'Machine fault - Assembly Support Cylinder feedback fault';


    // ---------------------------------------------------------
    // INITIALISATION TIMEOUT
    // ---------------------------------------------------------

    ELSIF bInitialisationTimeoutFault THEN

        CASE eInitialisingWaitReason OF

            E_InitialisingWaitReason.AirSupplyNotReady:
                stStatus.sMachineMessage := 'Initialisation timeout - air supply not ready';

            E_InitialisingWaitReason.IndexBusy:
                stStatus.sMachineMessage := 'Initialisation timeout - index did not stop';

            E_InitialisingWaitReason.SiliconeSupportNotRetracted:
                stStatus.sMachineMessage := 'Initialisation timeout - Silicone Support Cylinder not retracted';

            E_InitialisingWaitReason.AssemblySupportNotRetracted:
                stStatus.sMachineMessage := 'Initialisation timeout - Assembly Support Cylinder not retracted';

            E_InitialisingWaitReason.SiliconeSupportFaulted:
                stStatus.sMachineMessage := 'Initialisation timeout - Silicone Support Cylinder fault';

            E_InitialisingWaitReason.AssemblySupportFaulted:
                stStatus.sMachineMessage := 'Initialisation timeout - Assembly Support Cylinder fault';

            E_InitialisingWaitReason.MainDoorFaulted:
                stStatus.sMachineMessage := 'Initialisation timeout - main door lock fault';

            E_InitialisingWaitReason.MainDoorNotReady:
                stStatus.sMachineMessage := 'Initialisation timeout - main door did not lock';

            E_InitialisingWaitReason.ProcessStationFaulted:
                stStatus.sMachineMessage := 'Initialisation timeout - process station fault';

            E_InitialisingWaitReason.ProcessEquipmentNotReady:
                stStatus.sMachineMessage := 'Initialisation timeout - process equipment not ready';

        ELSE

            stStatus.sMachineMessage :=
                'Machine fault - initialisation timeout';

        END_CASE
    ELSIF bStoppingTimeoutFault THEN
        CASE eStoppingWaitReason OF
            E_StoppingWaitReason.IndexStillMoving:
                stStatus.sMachineMessage := 'Stopping timeout - index still moving';
            E_StoppingWaitReason.SiliconeSupportRetracting:
                stStatus.sMachineMessage := 'Stopping timeout - Silicone Support Cylinder not retracted';
			E_StoppingWaitReason.AssemblySupportRetracting:
                stStatus.sMachineMessage := 'Stopping timeout - Assembly Support Cylinder not retracted';
            E_StoppingWaitReason.ProcessEquipmentStopping:
                stStatus.sMachineMessage := 'Stopping timeout - process equipment still running';
            E_StoppingWaitReason.MainDoorTransition:
                stStatus.sMachineMessage := 'Stopping timeout - main door transition incomplete';
        ELSE
            stStatus.sMachineMessage := 'Machine fault - stopping timeout';
        END_CASE
		
	ELSIF stProcessCycleStatus.bFaulted THEN
   	 	stStatus.sMachineMessage := stProcessCycleStatus.sMessage;
    ELSIF fbMainDoorLock.IsFaulted() THEN
        stStatus.sMachineMessage := 'Machine fault - main door lock fault';
    ELSIF fbIndex.IsFaulted() THEN
        stStatus.sMachineMessage := 'Machine fault - index table fault';
    ELSIF fbProcessStation.IsFaulted() THEN
        stStatus.sMachineMessage := 'Machine fault - process station fault';
    ELSIF ipEquipment.IsFaulted() THEN
        stStatus.sMachineMessage := 'Machine fault - process equipment fault';
    ELSIF stInputs.bEventFault THEN
        stStatus.sMachineMessage := 'Machine fault - check active alarms';
    ELSE
        stStatus.sMachineMessage := 'Machine fault - reset required';
    END_IF
ELSIF eMachineState = E_MachineState.Stopped THEN
    IF GVL_HMI.bIvekSettingsInterlock THEN
        stStatus.sMachineMessage := 'Machine stopped - IVEK configuration interface active';
    ELSIF NOT stInputs.bMainDoorClosed THEN
        stStatus.sMachineMessage := 'Machine stopped - close the main door and press Reset';
    ELSE
        stStatus.sMachineMessage := 'Machine stopped - press Reset to initialise';
    END_IF
ELSE
    stStatus.sMachineMessage := 'Machine stopped';
END_IF

// =========================================================
// END-OF-CYCLE STATE AND OUTPUT PUBLICATION
// =========================================================

ePreviousMachineState := eMachineState;
stOutputs := stOutputsInternal;




]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetCyclicOutputs" Id="{9b31b272-cf95-4c0b-9674-4eee2c2eaa71}">
      <Declaration><![CDATA[METHOD PRIVATE ResetCyclicOutputs]]></Declaration>
      <Implementation>
        <ST><![CDATA[stOutputsInternal.bSafetyRunRequest := FALSE;
stOutputsInternal.bSafetyResetRequest := FALSE;
stOutputsInternal.bAirSupplyEnable := FALSE;
stOutputsInternal.bIndexRotatePortA := FALSE;
stOutputsInternal.bIndexStopPortB := FALSE;
stOutputsInternal.bAssemblySupportExtend := FALSE;
stOutputsInternal.bAssemblySupportRetract := TRUE;
stOutputsInternal.bSiliconeSupportExtend := FALSE;
stOutputsInternal.bSiliconeSupportRetract := TRUE;
stOutputsInternal.bMainDoorLockRequest := FALSE;
stOutputsInternal.bLedStart := FALSE;
stOutputsInternal.bLedReset := FALSE;
stOutputsInternal.bLedPass := FALSE;
stOutputsInternal.bLedFail := FALSE;
stOutputsInternal.bInternalLight := FALSE;
//stOutputsInternal.bExternalLight := FALSE;
stOutputsInternal.bPuckLockerPinUp := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>