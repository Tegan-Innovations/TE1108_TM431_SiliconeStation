<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_Events" Id="{e737e082-d667-460d-b7e6-01e02be943ba}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Events
VAR
    fbEventsManager 		: FB_EventsManager;
    tonDoorNotSafe  		: TON;
    tonUpSupplyLost : TON;
    tonUsSupplyLost : TON;
    tonAirSupplyLost : TON;
    tonDoorDiagnostic : TON;
    tonMs6Feedback : TON;
    tonIndexPositionInvalid : TON;
    tonIndexSupportMismatch : TON;
    tonTransferSupportMismatch : TON;
	fbLocalSystemTime : FB_LocalSystemTime;
	bAirLostDuringOperation		:BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[

fbLocalSystemTime(
    sNetID := '',
    bEnable := TRUE,
    dwCycle := 5,
    dwOpt := 1,
    tTimeout := T#5S
);



GVL_MASTER.sSystemDate :=
    CONCAT(
        CONCAT(
            CONCAT(
                UINT_TO_STRING(fbLocalSystemTime.systemTime.wDay),
                '/'
            ),
            CONCAT(
                UINT_TO_STRING(fbLocalSystemTime.systemTime.wMonth),
                '/'
            )
        ),
        UINT_TO_STRING(fbLocalSystemTime.systemTime.wYear)
    );

GVL_MASTER.sSystemTime := '';

	IF fbLocalSystemTime.systemTime.wHour < 10 THEN
		GVL_MASTER.sSystemTime := CONCAT(GVL_MASTER.sSystemTime, '0');
	END_IF
	
	GVL_MASTER.sSystemTime := CONCAT(
		GVL_MASTER.sSystemTime,
		UINT_TO_STRING(fbLocalSystemTime.systemTime.wHour)
	);
	
	GVL_MASTER.sSystemTime := CONCAT(GVL_MASTER.sSystemTime, ':');
	
	IF fbLocalSystemTime.systemTime.wMinute < 10 THEN
		GVL_MASTER.sSystemTime := CONCAT(GVL_MASTER.sSystemTime, '0');
	END_IF
	
	GVL_MASTER.sSystemTime := CONCAT(
		GVL_MASTER.sSystemTime,
		UINT_TO_STRING(fbLocalSystemTime.systemTime.wMinute)
	);
	
	GVL_MASTER.sSystemTime := CONCAT(GVL_MASTER.sSystemTime, ':');
	
	IF fbLocalSystemTime.systemTime.wSecond < 10 THEN
		GVL_MASTER.sSystemTime := CONCAT(GVL_MASTER.sSystemTime, '0');
	END_IF
	
	GVL_MASTER.sSystemTime := CONCAT(
		GVL_MASTER.sSystemTime,
		UINT_TO_STRING(fbLocalSystemTime.systemTime.wSecond)
	);
	
// -----------------------------------------------------------------------------
// EMERGENCY STOP
// -----------------------------------------------------------------------------
// Both physical channels are normally closed.
// A FALSE state on either channel indicates an open E-stop safety circuit.
GVL_MASTER.stStationEvents[0].aEvents[0].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[0].bEventFlag := NOT GVL_MASTER.stInputs.bEmergencyStopChannel1 OR NOT GVL_MASTER.stInputs.bEmergencyStopChannel2;
GVL_MASTER.stStationEvents[0].aEvents[0].bEventText := 'Emergency stop activated';
GVL_MASTER.stStationEvents[0].aEvents[0].sSolution := 'Release the emergency stop and check both E-stop safety channels';

// -----------------------------------------------------------------------------
// EMERGENCY STOP CHANNEL 1 FAULT
// -----------------------------------------------------------------------------
GVL_MASTER.stStationEvents[0].aEvents[1].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[1].bEventFlag := NOT GVL_MASTER.stInputs.bEmergencyStopChannel1 AND GVL_MASTER.stInputs.bEmergencyStopChannel2;
GVL_MASTER.stStationEvents[0].aEvents[1].bEventText := 'Emergency stop Channel 1 fault';
GVL_MASTER.stStationEvents[0].aEvents[1].sSolution := 'Check Emergency Stop Channel 1 wiring, contact and EL1918 input';

// -----------------------------------------------------------------------------
// EMERGENCY STOP CHANNEL 2 FAULT
// -----------------------------------------------------------------------------
GVL_MASTER.stStationEvents[0].aEvents[2].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[2].bEventFlag := GVL_MASTER.stInputs.bEmergencyStopChannel1 AND NOT GVL_MASTER.stInputs.bEmergencyStopChannel2;
GVL_MASTER.stStationEvents[0].aEvents[2].bEventText := 'Emergency stop Channel 2 fault';
GVL_MASTER.stStationEvents[0].aEvents[2].sSolution := 'Check Emergency Stop Channel 2 wiring, contact and EL1918 input';


// -----------------------------------------------------------------------------
// MAIN SAFETY DOOR OPEN
// -----------------------------------------------------------------------------
// All three physical signals are FALSE when the door is normally opened.
// Individual channel mismatches are diagnosed by separate events.
GVL_MASTER.stStationEvents[0].aEvents[3].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[3].bEventFlag :=
    NOT GVL_MASTER.stInputs.bMainDoorChannel1
    AND NOT GVL_MASTER.stInputs.bMainDoorChannel2
    AND NOT GVL_MASTER.stInputs.bMainDoorFeedback
	AND GVL_MASTER.stStatus.eMachineState <> E_MachineState.Stopped;

GVL_MASTER.stStationEvents[0].aEvents[3].bEventText := 'Main safety door open';
GVL_MASTER.stStationEvents[0].aEvents[3].sSolution := 'Close the main safety door and reset the machine';

// -----------------------------------------------------------------------------
// LEFT SAFETY FLAP
// -----------------------------------------------------------------------------
// Diagnostic is based directly on the two physical safety channels.
// Both channels must be active for the left flap to be considered safe.
GVL_MASTER.stStationEvents[0].aEvents[4].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[4].bEventFlag := (NOT GVL_MASTER.stInputs.bLeftFlapChannel1 OR NOT GVL_MASTER.stInputs.bLeftFlapChannel2) AND GVL_MASTER.stStatus.eMachineState <> E_MachineState.PowerUp;
GVL_MASTER.stStationEvents[0].aEvents[4].bEventText := 'Left safety flap activated';
GVL_MASTER.stStationEvents[0].aEvents[4].sSolution := 'Clear the left flap, inspect the safety device and reset the safety circuit';

// -----------------------------------------------------------------------------
// RIGHT SAFETY FLAP
// -----------------------------------------------------------------------------
// Diagnostic is based directly on the two physical safety channels.
// Both channels must be active for the right flap to be considered safe.
GVL_MASTER.stStationEvents[0].aEvents[5].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[5].bEventFlag := (NOT GVL_MASTER.stInputs.bRightFlapChannel1 OR NOT GVL_MASTER.stInputs.bRightFlapChannel2) AND GVL_MASTER.stStatus.eMachineState <> E_MachineState.PowerUp;
GVL_MASTER.stStationEvents[0].aEvents[5].bEventText := 'Right safety flap activated';
GVL_MASTER.stStationEvents[0].aEvents[5].sSolution := 'Clear the right flap, inspect the safety device and reset the safety circuit';
GVL_MASTER.stStationEvents[0].aEvents[6].bCycleStopRequest := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[6].bEventFlag := GVL_MASTER.stCommand.bStop;
GVL_MASTER.stStationEvents[0].aEvents[6].bEventText := 'Cycle stop requested';
GVL_MASTER.stStationEvents[0].aEvents[6].sSolution := 'Wait for the current operation to stop safely';

GVL_MASTER.stStationEvents[0].aEvents[7].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[7].bEventFlag := GVL_MASTER.stStatus.bInitialisationTimeoutFault;
GVL_MASTER.stStationEvents[0].aEvents[7].bEventText := 'System initialisation timeout';
GVL_MASTER.stStationEvents[0].aEvents[7].sSolution := 'Check safety, index home condition, tooling position and process equipment readiness';

GVL_MASTER.stStationEvents[0].aEvents[8].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[8].bEventFlag := GVL_MASTER.stStatus.bStoppingTimeoutFault;
GVL_MASTER.stStationEvents[0].aEvents[8].bEventText := 'System stopping timeout';
GVL_MASTER.stStationEvents[0].aEvents[8].sSolution := 'Check process equipment stop, Silicone Support Cylinder retraction and index table status';

// EPLAN power and pneumatic diagnostics (Term 7 / TwinSAFE aliases)
tonUpSupplyLost(IN := NOT GVL_MASTER.stInputs.bUp24VPowerSupplyOk AND GVL_MASTER.stStatus.eMachineState <> E_MachineState.PowerUp, PT := T#1S);
GVL_MASTER.stStationEvents[0].aEvents[10].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[10].bEventFlag := tonUpSupplyLost.Q;
GVL_MASTER.stStationEvents[0].aEvents[10].bEventText := '24 V Up power supply not healthy';
GVL_MASTER.stStationEvents[0].aEvents[10].sSolution := 'Check PSU 1, DC-OK signal, fuse and Term 7 Channel 3 wiring';

tonUsSupplyLost(IN := NOT GVL_MASTER.stInputs.bUs24VPowerSupplyOk AND GVL_MASTER.stStatus.eMachineState <> E_MachineState.PowerUp, PT := T#1S);
GVL_MASTER.stStationEvents[0].aEvents[11].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[11].bEventFlag := tonUsSupplyLost.Q;
GVL_MASTER.stStationEvents[0].aEvents[11].bEventText := '24 V Us power supply not healthy';
GVL_MASTER.stStationEvents[0].aEvents[11].sSolution := 'Check PSU 2, DC-OK signal, fuse and Term 7 Channel 4 wiring';


// -----------------------------------------------------------------------------
// AIR SUPPLY NOT AVAILABLE
// -----------------------------------------------------------------------------
// During Initialising, when the pneumatic supply is requested, the MS6/dump
// feedback must confirm that the pneumatic system becomes available.
//
// The timeout is intentionally set to 9 seconds:
// - the pneumatic supply normally takes almost 8 seconds to become available;
// - the machine Initialising timeout is 10 seconds;
// - using 9 seconds allows the air fault to be identified before the machine
//   reaches the general Initialising timeout / ReadyToStart transition.
// -----------------------------------------------------------------------------
tonAirSupplyLost(
    IN := GVL_Safety.bAirSupplyEnableRequest
        AND NOT GVL_MASTER.stInputs.bAirExhausted
        AND GVL_MASTER.stStatus.eMachineState = E_MachineState.Initialising,
    PT := T#9S
);

bAirLostDuringOperation :=
    NOT GVL_MASTER.stInputs.bAirExhausted
    AND (
        GVL_MASTER.stStatus.eMachineState = E_MachineState.ReadyToStart
        OR GVL_MASTER.stStatus.eMachineState = E_MachineState.AutoCycle
        OR GVL_MASTER.stStatus.eMachineState = E_MachineState.Manual
    );

GVL_MASTER.stStationEvents[0].aEvents[12].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[12].bEventFlag := tonAirSupplyLost.Q OR bAirLostDuringOperation;
GVL_MASTER.stStationEvents[0].aEvents[12].bEventText := 'Air supply not available';
GVL_MASTER.stStationEvents[0].aEvents[12].sSolution := 'Check the main air supply, MS6 unit and dump valve feedback';


tonMs6Feedback(IN := NOT GVL_MASTER.stInputs.bMs6FeedbackOk AND (GVL_MASTER.stStatus.eMachineState = E_MachineState.Initialising OR GVL_MASTER.stStatus.eMachineState = E_MachineState.ReadyToStart OR GVL_MASTER.stStatus.eMachineState = E_MachineState.AutoCycle OR GVL_MASTER.stStatus.eMachineState = E_MachineState.Manual), PT := T#1S);
GVL_MASTER.stStationEvents[0].aEvents[14].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[14].bEventFlag := tonMs6Feedback.Q;
GVL_MASTER.stStationEvents[0].aEvents[14].bEventText := 'Festo MS6 feedback not healthy';
GVL_MASTER.stStationEvents[0].aEvents[14].sSolution := 'Check MS6 feedback channels, Pilz relays, pneumatic enable and exhaust state';

GVL_MASTER.stStationEvents[0].aEvents[15].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[15].bEventFlag := GVL_MASTER.stInputs.bAirExhausted AND (GVL_MASTER.stStatus.eMachineState = E_MachineState.ReadyToStart OR GVL_MASTER.stStatus.eMachineState = E_MachineState.AutoCycle OR GVL_MASTER.stStatus.eMachineState = E_MachineState.Manual);
GVL_MASTER.stStationEvents[0].aEvents[15].bEventText := 'Pneumatic system is exhausted while operation is requested';
GVL_MASTER.stStationEvents[0].aEvents[15].sSolution := 'Check the MS6 dump valve, reset circuit and air exhaust feedback';

// -----------------------------------------------------------------------------
// UNEXPECTED HMI LOGOUT
// -----------------------------------------------------------------------------
GVL_MASTER.stStationEvents[0].aEvents[16].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[16].bEventFlag := GVL_MASTER.stStatus.bHmiLogoutFault;
GVL_MASTER.stStationEvents[0].aEvents[16].bEventText := 'Unexpected HMI logout during machine operation';
GVL_MASTER.stStationEvents[0].aEvents[16].sSolution := 'Log in to the HMI and reset the machine';

// -----------------------------------------------------------------------------
// STOP REQUEST TIMEOUT
// -----------------------------------------------------------------------------
// A Stop request was issued, but the machine could not reach the Stopping
// state within the allowed time because an exit condition was not satisfied.
GVL_MASTER.stStationEvents[0].aEvents[17].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[17].bEventFlag := GVL_MASTER.stStatus.bStopRequestTimeout;
GVL_MASTER.stStationEvents[0].aEvents[17].bEventText := 'Stop request timeout';
GVL_MASTER.stStationEvents[0].aEvents[17].sSolution := 'Check why the current machine state could not complete the stop sequence';


// Station 1 - Process station / simulated IVEK
GVL_MASTER.stStationEvents[1].aEvents[0].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[0].bEventFlag := GVL_MASTER.stStatus.eCycleState = E_CycleState.Fault;
GVL_MASTER.stStationEvents[1].aEvents[0].bEventText := 'Process cycle fault';
GVL_MASTER.stStationEvents[1].aEvents[0].sSolution := 'Check Silicone Support Cylinder, equipment status and process permissives';

GVL_MASTER.stStationEvents[1].aEvents[1].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[1].bEventFlag := GVL_MASTER.stStatus.eEquipmentState = E_ProcessEquipmentState.Fault;
GVL_MASTER.stStationEvents[1].aEvents[1].bEventText := 'Process equipment fault';
GVL_MASTER.stStationEvents[1].aEvents[1].sSolution := 'Check the IVEK or simulated equipment diagnostics and reset the equipment';


// EPLAN process material and heater signals (Term 7)
GVL_MASTER.stStationEvents[1].aEvents[2].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[2].bEventFlag := GVL_MASTER.stInputs.bIvekHeaterControllerAlarm;
GVL_MASTER.stStationEvents[1].aEvents[2].bEventText := 'IVEK heater controller alarm';
GVL_MASTER.stStationEvents[1].aEvents[2].sSolution := 'Check the heater controller alarm output, temperature control and power supply';

GVL_MASTER.stStationEvents[1].aEvents[3].bCycleStopRequest := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[3].bEventFlag := NOT GVL_MASTER.stInputs.bSiliconeMinimumLevelSensor1;
GVL_MASTER.stStationEvents[1].aEvents[3].bEventText := 'Silicone minimum level sensor 1 not satisfied';
GVL_MASTER.stStationEvents[1].aEvents[3].sSolution := 'Check silicone level, sensor alignment and Term 7 Channel 15';

GVL_MASTER.stStationEvents[1].aEvents[4].bCycleStopRequest := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[4].bEventFlag := NOT GVL_MASTER.stInputs.bSiliconeMinimumLevelSensor2;
GVL_MASTER.stStationEvents[1].aEvents[4].bEventText := 'Silicone minimum level sensor 2 not satisfied';
GVL_MASTER.stStationEvents[1].aEvents[4].sSolution := 'Check silicone level, sensor alignment and Term 7 Channel 16';

GVL_MASTER.stStationEvents[1].aEvents[5].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[5].bEventFlag :=GVL_MASTER.stStatus.stProcessCycle.bTimeoutFault;
GVL_MASTER.stStationEvents[1].aEvents[5].bEventText :='Automatic process cycle timeout';
GVL_MASTER.stStationEvents[1].aEvents[5].sSolution :='Check index movement, support cylinders and Assembly/Silicone process execution';


// Process station component faults
GVL_MASTER.stStationEvents[1].aEvents[10].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[10].bEventFlag := GVL_MASTER.stStatus.stProcessStation.eFault = E_ProcessStationFault.CylinderExtendTimeout;
GVL_MASTER.stStationEvents[1].aEvents[10].bEventText := 'Silicone Support Cylinder extend timeout';
GVL_MASTER.stStationEvents[1].aEvents[10].sSolution := 'Check air supply, extend valve and extended sensor';
GVL_MASTER.stStationEvents[1].aEvents[11].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[11].bEventFlag := GVL_MASTER.stStatus.stProcessStation.eFault = E_ProcessStationFault.CylinderRetractTimeout;
GVL_MASTER.stStationEvents[1].aEvents[11].bEventText := 'Silicone Support Cylinder retract timeout';
GVL_MASTER.stStationEvents[1].aEvents[11].sSolution := 'Check air supply, retract valve and retracted sensor';
GVL_MASTER.stStationEvents[1].aEvents[12].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[12].bEventFlag := GVL_MASTER.stStatus.stProcessStation.eFault = E_ProcessStationFault.CylinderSensorMismatch;
GVL_MASTER.stStationEvents[1].aEvents[12].bEventText := 'Silicone Support Cylinder sensor mismatch';
GVL_MASTER.stStationEvents[1].aEvents[12].sSolution := 'Check extended and retracted sensors; both cannot be active together';
GVL_MASTER.stStationEvents[1].aEvents[13].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[13].bEventFlag := GVL_MASTER.stStatus.stProcessStation.eFault = E_ProcessStationFault.ProcessTimeout;
GVL_MASTER.stStationEvents[1].aEvents[13].bEventText := 'Process station timeout';
GVL_MASTER.stStationEvents[1].aEvents[13].sSolution := 'Check process equipment, permissives and cylinder position';

// Main door lock component faults
GVL_MASTER.stStationEvents[0].aEvents[20].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[20].bEventFlag := GVL_MASTER.stStatus.stMainDoorLock.eFault = E_MainDoorLockFault.LockTimeout;
GVL_MASTER.stStationEvents[0].aEvents[20].bEventText := 'Main door lock timeout';
GVL_MASTER.stStationEvents[0].aEvents[20].sSolution := 'Close the door and check the lock output and locked feedback';
GVL_MASTER.stStationEvents[0].aEvents[21].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[21].bEventFlag := GVL_MASTER.stStatus.stMainDoorLock.eFault = E_MainDoorLockFault.UnlockTimeout;
GVL_MASTER.stStationEvents[0].aEvents[21].bEventText := 'Main door unlock timeout';
GVL_MASTER.stStationEvents[0].aEvents[21].sSolution := 'Check the lock mechanism and unlock feedback';
GVL_MASTER.stStationEvents[0].aEvents[22].bFault := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[22].bEventFlag := GVL_MASTER.stStatus.stMainDoorLock.eFault = E_MainDoorLockFault.FeedbackMismatch;
GVL_MASTER.stStationEvents[0].aEvents[22].bEventText := 'Main door feedback mismatch';
GVL_MASTER.stStationEvents[0].aEvents[22].sSolution := 'Check closed, locked and TwinSAFE door feedbacks';

// Station 2 - Index table
GVL_MASTER.stStationEvents[2].aEvents[0].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[0].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.InitialPositionInvalid OR GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.PositionInvalid;
GVL_MASTER.stStationEvents[2].aEvents[0].bEventText := 'Index table position invalid';
GVL_MASTER.stStationEvents[2].aEvents[0].sSolution := 'Check table position sensors and recover the table using the two-hand controls';

GVL_MASTER.stStationEvents[2].aEvents[1].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[1].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.SupportRetractTimeout;
GVL_MASTER.stStationEvents[2].aEvents[1].bEventText := 'Index support retract timeout';
GVL_MASTER.stStationEvents[2].aEvents[1].sSolution := 'Check air supply, support cylinder and retracted sensor';

GVL_MASTER.stStationEvents[2].aEvents[2].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[2].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.RotationTimeout;
GVL_MASTER.stStationEvents[2].aEvents[2].bEventText := 'Index table rotation timeout';
GVL_MASTER.stStationEvents[2].aEvents[2].sSolution := 'Check table air supply, Port A valve and completed sensor';

GVL_MASTER.stStationEvents[2].aEvents[3].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[3].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.StopAndLockTimeout;
GVL_MASTER.stStationEvents[2].aEvents[3].bEventText := 'Index table stop or lock timeout';
GVL_MASTER.stStationEvents[2].aEvents[3].sSolution := 'Check Port B valve, ready sensor and locked sensor';

GVL_MASTER.stStationEvents[2].aEvents[4].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[4].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.SupportExtendTimeout;
GVL_MASTER.stStationEvents[2].aEvents[4].bEventText := 'Index support extend timeout';
GVL_MASTER.stStationEvents[2].aEvents[4].sSolution := 'Check support cylinder, extended sensor and pneumatic supply';

GVL_MASTER.stStationEvents[2].aEvents[5].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[5].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.eFault = E_IndexFault.WrongPositionTimeout;
GVL_MASTER.stStationEvents[2].aEvents[5].bEventText := 'Index recovery two-hand timeout';
GVL_MASTER.stStationEvents[2].aEvents[5].sSolution := 'Press both safety controls to complete index recovery';

GVL_MASTER.stStationEvents[2].aEvents[10].bMessage := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[10].bEventFlag := GVL_MASTER.stStatus.stIndexStatus.bWaitingOperatorExchange;
GVL_MASTER.stStationEvents[2].aEvents[10].bEventText := 'Index waiting for operator exchange';
GVL_MASTER.stStationEvents[2].aEvents[10].sSolution := 'Complete part removal, reject confirmation.';
// =========================================================
// PROCESS SUPPORT CYLINDER FAULTS
// =========================================================

// ---------------------------------------------------------
// SILICONE SUPPORT CYLINDER
// ---------------------------------------------------------

GVL_MASTER.stStationEvents[1].aEvents[20].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[20].bEventFlag := GVL_MASTER.stStatus.bSiliconeSupportFaulted;
GVL_MASTER.stStationEvents[1].aEvents[20].bEventText := 'Silicone Support Cylinder fault';
GVL_MASTER.stStationEvents[1].aEvents[20].sSolution := 'Check Silicone Support Cylinder air supply, valve and position sensors';


// ---------------------------------------------------------
// ASSEMBLY SUPPORT CYLINDER
// ---------------------------------------------------------

GVL_MASTER.stStationEvents[1].aEvents[21].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[21].bEventFlag := GVL_MASTER.stStatus.bAssemblySupportFaulted;
GVL_MASTER.stStationEvents[1].aEvents[21].bEventText := 'Assembly Support Cylinder fault';
GVL_MASTER.stStationEvents[1].aEvents[21].sSolution := 'Check Assembly Support Cylinder air supply, valve and position sensors';

// Operator station diagnostics. These are visual messages only; the active
// operator instruction itself remains reserved for DataGrid row 0.
GVL_MASTER.stStationEvents[0].aEvents[30].bMessage := TRUE;
GVL_MASTER.stStationEvents[0].aEvents[30].bEventFlag := GVL_MASTER.stStatus.stOperatorStation.bRejectWaitingForClear;
GVL_MASTER.stStationEvents[0].aEvents[30].bEventText := 'Reject confirmation ignored because reject chute sensor was active before nest removal';
GVL_MASTER.stStationEvents[0].aEvents[30].sSolution := 'Clear the reject chute sensor, then place the rejected part in the bin again';



// Physical sensor coherence from EPLAN
// A valid absolute position is required whenever the index reports ready and locked.
tonIndexPositionInvalid(IN := GVL_MASTER.stInputs.bIndexReady AND GVL_MASTER.stInputs.bIndexLocked AND GVL_MASTER.stInputs.eIndexPosition = E_TablePosition.Unknown, PT := T#500MS);
GVL_MASTER.stStationEvents[2].aEvents[6].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[6].bEventFlag := tonIndexPositionInvalid.Q;
GVL_MASTER.stStationEvents[2].aEvents[6].bEventText := 'Index table position sensor combination invalid';
GVL_MASTER.stStationEvents[2].aEvents[6].sSolution := 'Check position sensors 1, 2 and 3, their binary code and Term 7 Channels 6 to 8';

tonIndexSupportMismatch(IN := GVL_MASTER.stInputs.bIndexSupportExtended AND GVL_MASTER.stInputs.bIndexSupportRetracted, PT := T#250MS);
GVL_MASTER.stStationEvents[2].aEvents[7].bFault := TRUE;
GVL_MASTER.stStationEvents[2].aEvents[7].bEventFlag := tonIndexSupportMismatch.Q;
GVL_MASTER.stStationEvents[2].aEvents[7].bEventText := 'Nest support cylinder sensor mismatch';
GVL_MASTER.stStationEvents[2].aEvents[7].sSolution := 'Check the nest support cylinder extended and retracted sensors on Term 8 Channels 1 and 2';

tonTransferSupportMismatch(IN := GVL_MASTER.stInputs.bSiliconeSupportExtended AND GVL_MASTER.stInputs.bSiliconeSupportRetracted, PT := T#250MS);
GVL_MASTER.stStationEvents[1].aEvents[14].bFault := TRUE;
GVL_MASTER.stStationEvents[1].aEvents[14].bEventFlag := tonTransferSupportMismatch.Q;
GVL_MASTER.stStationEvents[1].aEvents[14].bEventText := 'Silicone Support Cylinder sensor mismatch';
GVL_MASTER.stStationEvents[1].aEvents[14].sSolution := 'Check the Silicone Support Cylinder sensors on Term 8 Channels 3 and 4';



//=======================
//DELETE
//=========================



// Operator instructions are reserved for astActiveEvents[0] and are not event triggers.

fbEventsManager(
    bPulse := TRUE,
    sSystemTime := GVL_MASTER.sSystemTime,
