<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HmiCommands" Id="{77685773-5031-434b-8aac-fa8b49ef7063}">
    <Declaration><![CDATA[TYPE ST_HmiCommands :
STRUCT
    bStart                          : BOOL;
    bStop                           : BOOL;
    bReset                          : BOOL;
    bAcknowledge                    : BOOL;
    bManualModeEnable               : BOOL;
    bManualModeRequest              : BOOL; // Legacy compatibility
    bIndexForward                   : BOOL;
    bIndexHome                      : BOOL;
	bExternalLight					: BOOL;
	uiResetStatisticsNestId 		: UINT;
	 
	
    // Silicone Support
	bSiliconeSupportExtend  		: BOOL;
	bSiliconeSupportRetract 		: BOOL;

	// Assembly Support
	bAssemblySupportExtend  		: BOOL;
	bAssemblySupportRetract 		: BOOL;
	
    bMainDoorUnlock                 : BOOL;
    bSimulateProcessPass            : BOOL;
    bSimulateProcessFail            : BOOL;
    bSimulateProcessFault           : BOOL;
    bIvekStartManual                : BOOL;
    bIvekStopManual                 : BOOL;
    bIvekReset                      : BOOL;
    // Engineer Settings - IVEK maintenance
    bIvekPrime                      : BOOL;
    bIvekReference                  : BOOL;
    bIvekMaintenanceStop            : BOOL;
	bIndexerManualEnable            : BOOL;
    usiRecipeRequest                : USINT;
	
	
    // Silicone reservoir Settings toggles
    bReservoir1Select                  : BOOL;
    bReservoir2Select                  : BOOL;
    bReservoir1Degass                 : BOOL;
    bReservoir2Degass                 : BOOL;
    bCancelReservoirDegassing         : BOOL;

    // Degassing action popup commands
    bReservoirDegassingPopupStart     : BOOL;
    bReservoirDegassingPopupClose     : BOOL;


    // Manual Assembly / Flipping Station
    bAssemblyStationManualEnable       : BOOL;
    bAssemblyStationStart              : BOOL;

    // Manual enable for Silicone/Assembly nest support cylinders
    bNestCylindersManualEnable          : BOOL;


    // Manual Silicone Station
    bSiliconeStationManualEnable        : BOOL;
    bSiliconeStationStart               : BOOL;

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>