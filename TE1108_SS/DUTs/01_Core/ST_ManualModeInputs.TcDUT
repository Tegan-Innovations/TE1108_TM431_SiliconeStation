  <DUT Name="ST_ManualModeInputs" Id="{18456921-6213-41f6-a504-07e7e56d014a}">
    <Declaration><![CDATA[TYPE ST_ManualModeInputs :
STRUCT
    bSafetyOk                      : BOOL;
    bMotionSafetyPermitted         : BOOL;
    bTwoHandsSafe                  : BOOL;
    bProcessSafetyPermitted        : BOOL;
    bMainDoorSafe                  : BOOL;

    bIndexReady                    : BOOL;
    bIndexLocked                   : BOOL;
    bIndexBusy                     : BOOL;
    bIndexFaulted                  : BOOL;

    bSiliconeSupportExtended       : BOOL;
    bSiliconeSupportRetracted      : BOOL;
	bAssemblySupportExtended  	   : BOOL;
	bAssemblySupportRetracted 	   : BOOL;

    bProcessStationFaulted         : BOOL;

    bEquipmentReady                : BOOL;
    bEquipmentBusy                 : BOOL;
    bEquipmentFaulted              : BOOL;

    // Assembly / flipping station
    bAssemblyStationReady          : BOOL;
    bAssemblyStationBusy           : BOOL;
    bAssemblyStationFaulted        : BOOL;
    bAssemblyNestPartPresent       : BOOL;
    bAssemblyNestSiliconized       : BOOL;
    bAssemblyNestAlreadyAssembled   : BOOL;

    bReservoirPartPresent          : BOOL;

    // Manual Silicone Station
    bSiliconeProcessReady               : BOOL;
    bSiliconeProcessBusy                : BOOL;
    bSiliconeProcessFaulted             : BOOL;
    bSiliconeNestPartPresent            : BOOL;
    bSiliconeNestAlreadyProcessed       : BOOL;

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
