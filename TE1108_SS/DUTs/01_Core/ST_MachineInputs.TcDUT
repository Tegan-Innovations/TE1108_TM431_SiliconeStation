<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MachineInputs" Id="{2ac5c147-5176-4b29-b405-f833d8595045}">
    <Declaration><![CDATA[TYPE ST_MachineInputs :
STRUCT
    stSafety                         : ST_SafetyStatus;

    bStartButton                     : BOOL;
    bStopButton                      : BOOL;
    bResetButton                     : BOOL;

    bEventFault                      : BOOL;
    bEventCycleStopRequest           : BOOL;

    bUp24VPowerSupplyOk              : BOOL;
    bUs24VPowerSupplyOk              : BOOL;
    bIvekHeaterControllerAlarm       : BOOL;
    bMainDoorDiagnosticOk            : BOOL;
    bMs6FeedbackOk                   : BOOL;
    bAirExhausted                    : BOOL;

    uiMainAirPressureRaw             : UINT;
    uiSiliconePressureRaw            : UINT;
    uiNozzlePressureRaw              : UINT;
    uiVacuumPressureRaw              : UINT;
		// Vacuum extractor
	uiExtractorFeedbackRaw 			 : UINT;
	iPartVacuumPressureRaw 			 : INT;
	bPartVacuumOk          			 : BOOL;
	bExtractorRunning      			 : BOOL;

    bTwoHandsSafe                    : BOOL;
	
	bExternalLight					  :BOOL;

    bGearboxAssemblyPartPresent      : BOOL;
    bReservoirPartPresent            : BOOL;
    bRejectChutePartPresent          : BOOL;
	bBothPartPresent		         : BOOL;

    bIndexReady                      : BOOL;
    bIndexLocked                     : BOOL;
    bIndexCompletedSensor            : BOOL;
    bIndexSupportExtended            : BOOL;
    bIndexSupportRetracted           : BOOL;
    eIndexPosition                   : E_TablePosition;

    bMainDoorClosed                  : BOOL;
    bMainDoorLocked                  : BOOL;
    bMainDoorUnsafe                  : BOOL;

    bSiliconeSupportExtended         : BOOL;
    bSiliconeSupportRetracted        : BOOL;
	bAssemblySupportExtended  		 : BOOL;
	bAssemblySupportRetracted 		 : BOOL;
	
	

    // Flipping / assembly station feedback
    bTransferVerticalMiniSlideRetracted : BOOL;
    bTransferVerticalMiniSlideExtended  : BOOL;
    bRotaryGripperOpened                : BOOL;
    bRotaryGripperClosed                : BOOL;
    bRotaryGripperRotationPick0         : BOOL;
    bRotaryGripperRotationPlace180      : BOOL;
	
	// Physical safety diagnostics used for root-cause alarm identification.
	bEmergencyStopChannel1 			 : BOOL;
	bEmergencyStopChannel2 			 : BOOL;
	
	// Main door physical channels used for root-cause diagnostics
	bMainDoorChannel1             	 : BOOL;
	bMainDoorChannel2             	 : BOOL;
	bMainDoorFeedback                : BOOL;
	// Safety flap physical channels used for root-cause diagnostics
	bLeftFlapChannel1             	 : BOOL;
	bLeftFlapChannel2             	 : BOOL;
	bRightFlapChannel1            	 : BOOL;
	bRightFlapChannel2            	 : BOOL;
	
	// =========================================================
	// SILICONE SUPPLY INPUTS
	// =========================================================
	
	// Reservoir level sensors
	// TRUE = silicone present / level OK
	// FALSE = minimum level reached
	bSiliconeMinimumLevel1      : BOOL;
	bSiliconeMinimumLevel2      : BOOL;
	
	// Analog values converted to engineering units
	rSiliconePressureBar        : REAL;
	rNozzlePressureBar          : REAL;
	rVacuumEngineering   		: REAL;
	
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>