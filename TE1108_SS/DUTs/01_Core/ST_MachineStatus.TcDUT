<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MachineStatus" Id="{f4291e0c-7f34-4828-9807-36e2caee1fcf}">
    <Declaration><![CDATA[TYPE ST_MachineStatus :
STRUCT
    eMachineState           : E_MachineState;
    eCycleState             : E_CycleState;
    stProcessStation        : ST_ProcessStationStatus;
    stAssemblyStation       : ST_AssemblyStationStatus;
    stMainDoorLock          : ST_MainDoorLockStatus;
    eInitialisingWaitReason : E_InitialisingWaitReason;
    eStoppingWaitReason     : E_StoppingWaitReason;
    stProcessCycle          : ST_ProcessCycleStatus;
    eIndexState             : E_IndexState;
    stIndexStatus           : ST_IndexStatus;
    eEquipmentState         : E_ProcessEquipmentState;
	eIvekStatusState 		: E_IvekStatusState;
    eOperatorExchangeState  : E_OperatorExchangeState;
    eOperatorInstruction    : E_OperatorInstruction;
    stOperatorStation       : ST_OperatorStationStatus;
    eManualModeState        : E_ManualModeState;
    stManualMode            : ST_ManualModeStatus;
	stSiliconeSupply 		: ST_SiliconeSupplyStatus;
	
    bReady                 			: BOOL;
    bBusy                  			: BOOL;
    bFaulted               			: BOOL;
    bInitialisationTimeoutFault 	: BOOL;
    bStoppingTimeoutFault       	: BOOL;
	bStopRequestTimeout 			: BOOL;
	bHmiLogoutFault 				: BOOL;
    bSafetyStopRequested   			: BOOL;
    bSafetyRunRequested    			: BOOL;
    bEventFault            			: BOOL;
    bCycleStopRequested    			: BOOL;
    bIndexPermissive       			: BOOL;
    bProcessPermissive     			: BOOL;
	bEnableSetting		   			: BOOL;
	bSiliconeSupportFaulted 		: BOOL;
	bAssemblySupportFaulted 		: BOOL;
    bAssemblyStationFaulted         : BOOL;
	bExtractorAutoCycleFault 		: BOOL;
	bPartVacuumBuildTimeoutFault   : BOOL;
	bPartVacuumLostFault           : BOOL;
	bPartVacuumReleaseTimeoutFault : BOOL;
	
    stPermissives           : ST_MachinePermissives;
    stLastResult            : ST_ProcessResult;
    stAlarms                : ST_AlarmManagerStatus;
    aNest                   : ARRAY[1..4] OF ST_Nest;
	aNestStatistics 		: ARRAY[1..4] OF ST_NestStatistics;
    udiAlarmCode            : UDINT;
    sMachineMessage         : STRING(160);
    sOperatorMessage        : STRING(255);
	
	

    // Current nest and manual Assembly / Flipping Station status
    uiAssemblyStationNestId               : UINT;
    bAssemblyStationPartPresent           : BOOL;
    bAssemblyStationPartSiliconized       : BOOL;
    bAssemblyStationManualEnabled         : BOOL;
    bAssemblyStationManualStartPermissive : BOOL;


    // Current nest and manual Silicone Station status
    uiSiliconeStationNestId                 : UINT;
    bSiliconeStationPartPresent             : BOOL;
    bSiliconeStationReady                   : BOOL;
    bSiliconeStationManualEnabled           : BOOL;
    bSiliconeStationManualStartPermissive   : BOOL;

    // IVEK Manual HMI status
    bIvekReady                              : BOOL;
    bIvekProductionReady                    : BOOL;
    bIvekBusy                               : BOOL;
    bIvekHealthy                            : BOOL;
    bIvekFaulted                            : BOOL;
    bIvekMotionEnabled                      : BOOL;
    bIvekReferenceRequired                   : BOOL;
    bIvekReferenceReady                      : BOOL;
    bIvekReferenceActive                     : BOOL;
    bIvekFluidicReady                        : BOOL;
    bIvekFluidicActive                       : BOOL;
    bIvekPrimePermissive                     : BOOL;
    bIvekReferencePermissive                 : BOOL;

END_STRUCT
END_TYPE

]]></Declaration>
  </DUT>
</TcPlcObject>