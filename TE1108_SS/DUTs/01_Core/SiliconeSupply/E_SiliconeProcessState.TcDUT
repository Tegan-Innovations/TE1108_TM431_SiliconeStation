<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="E_SiliconeProcessState" Id="{2b708f69-adec-48e2-8ddf-18866f066cbd}">
    <Declaration><![CDATA[TYPE E_SiliconeProcessState :
(
    Idle                     := 0,

    StartingVacuum           := 10,
    WaitingVacuumReady       := 20,

    OpeningPinchValve        := 30,
    WaitingPinchSettling     := 40,
    StartingEquipment        := 50,
    WaitingEquipmentBusy     := 60,
    WaitingEquipmentComplete := 70,
    ClosingPinchValve        := 80,

    StoppingVacuum           := 90,
    WaitingVacuumReleased    := 100,

    Complete                 := 110,
    Fault                    := 120
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>