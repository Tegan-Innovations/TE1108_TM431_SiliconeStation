    bSiliconePressureOk     : BOOL;
    bNozzlePressureOk       : BOOL;
    bSiliconePressureLow    : BOOL;
    bSiliconePressureHigh   : BOOL;
    bNozzlePressureLow      : BOOL;
    bNozzlePressureHigh     : BOOL;

    bAnyReservoirReady          : BOOL;
    bSelectedReservoirReady     : BOOL;
    bReservoirSelectionRequired : BOOL;
    bSupplyReadyForDispense     : BOOL;
    bDegassingActive        : BOOL;
    bNoReservoirAvailable   : BOOL;
    bStopRequest            : BOOL;
    bVacuumPumpCommand      : BOOL;
    bVacuumToAir1Command    : BOOL;
    bVacuumToAir2Command    : BOOL;
    bPinchValve1Command     : BOOL;
    bPinchValve2Command     : BOOL;
    sMessage                : STRING(160);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
