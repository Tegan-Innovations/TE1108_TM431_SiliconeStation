  <DUT Name="ST_SiliconeSupplyStatus" Id="{d2e0e930-9bff-4036-9896-87cabb3bf824}">
    <Declaration><![CDATA[TYPE ST_SiliconeSupplyStatus :
STRUCT
    aReservoir              : ARRAY[1..2] OF ST_SiliconeReservoirStatus;
    eDegassingState         : E_SiliconeDegassingState;
    usiSelectedReservoir    : USINT;
    usiDegassingReservoir   : USINT;

    rSiliconePressureBar    : REAL;
    rNozzlePressureBar      : REAL;
