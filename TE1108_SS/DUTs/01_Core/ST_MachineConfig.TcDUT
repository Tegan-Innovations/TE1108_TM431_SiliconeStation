<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MachineConfig" Id="{846fa9b5-dfee-4d5c-87c6-eecc7b019629}">
    <Declaration><![CDATA[TYPE ST_MachineConfig :
STRUCT
    tInitialiseTimeout          : TIME := T#15S;
    tStoppingTimeout            : TIME := T#15S;
    tIndexTimeout               : TIME := T#10S;
    tIndexRotateDelay           : TIME := T#500MS;
    tIndexStopDelay             : TIME := T#1S;
    tIndexSupportTimeout        : TIME := T#5S;
    tTwoHandHold                : TIME := T#500MS;
    tTwoHandRecoveryTimeout     : TIME := T#10S;
    tDoorLockTimeout            : TIME := T#10S;
    tDoorUnlockTimeout          : TIME := T#10S;
    tCylinderTimeout            : TIME := T#30S;
    tProcessTimeout             : TIME := T#12S;
    tOperatorIdleTimeout        : TIME := T#30S;
	tPartVacuumBuildTimeout     : TIME := T#2S;
	tPartVacuumReleaseTimeout   : TIME := T#2S;
    

    // Flipping station commissioning values. Reduce action delay after validation.
    tAssemblyActionDelay       : TIME := T#10MS;
    tAssemblyMovementTimeout   : TIME := T#7S;
	tAssemblyReleaseDelay 	   : TIME := T#500MS;
	
    eOperatorPosition : E_TablePosition := E_TablePosition.Position1;
	eSiliconePosition : E_TablePosition := E_TablePosition.Position3;
	eAssemblyPosition : E_TablePosition := E_TablePosition.Position4;
	eRejectPosition   : E_TablePosition := E_TablePosition.Position1;
	
    bRequireTwoHandsForIndex    : BOOL := TRUE;
    bAllowEmptyNestIndex        : BOOL := TRUE;
    bRequireRejectConfirm       : BOOL := TRUE;
    aNestEnabled                : ARRAY[1..4] OF BOOL := [TRUE, TRUE, TRUE, TRUE];
	
	// =========================================================
	// SILICONE SUPPLY STRUCTURE
	// =========================================================
	stSiliconeSupply : ST_SiliconeSupplyConfig;
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>