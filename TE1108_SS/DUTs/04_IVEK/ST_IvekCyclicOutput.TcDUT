  <DUT Name="ST_IvekCyclicOutput" Id="{e2a8cbe8-63e3-4570-8dfd-87e9d5b32117}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_IvekCyclicOutput :
STRUCT
    // EtherNet/IP Assembly 150 - PLC -> IVEK
    // Total size: 20 bytes

    udiCommands          : UDINT;                // P010 - bytes 0..3
    udiCommandsExt       : UDINT;                // P011 - bytes 4..7

    usiRecipeGet         : USINT;                // P018 - byte 8
    aReserved            : ARRAY[0..2] OF BYTE; // bytes 9..11

    diDispenseVolume     : DINT;                 // P052 - bytes 12..15
    diRateOrSetpoint     : DINT;                 // P076 - bytes 16..19
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
