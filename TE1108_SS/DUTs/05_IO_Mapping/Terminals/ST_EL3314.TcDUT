<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_EL3314" Id="{be13e629-a4d0-4e0a-b398-0a3544e21105}">
    <Declaration><![CDATA[TYPE ST_EL3314 :
STRUCT
    //--------------------------------------------------------------------------------------------------------
    sTerminalName                                           : STRING(200) := 'EL3314 | 4-Channel Thermocouple Input';
    //============================================================================================================================
    // TERMINAL - EL3314 4-Channel Thermocouple Input Terminal (Term 33)
    iEL3314_Ch1                         AT %I*               : INT;    // EL3314 channel 1 - Temperature [0.1 °C]
    iEL3314_Ch2                         AT %I*               : INT;    // EL3314 channel 2 - Temperature [0.1 °C]
    iEL3314_Ch3                         AT %I*               : INT;    // EL3314 channel 3 - Temperature [0.1 °C]
    iEL3314_Ch4                         AT %I*               : INT;    // EL3314 channel 4 - Temperature [0.1 °C]

    stTerminalInfo                                           : ST_Terminal_Info;

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>