<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_PhysicalInputs" Id="{d4e9038a-638b-4b93-a8ec-1f818bc84700}">
    <Declaration><![CDATA[TYPE ST_PhysicalInputs :
STRUCT
    // Physical operator controls (standard PLC inputs)
    bStartButton                  : BOOL;
    bStopButton                   : BOOL;

    // Reset and validated safety diagnostics received through TwinSAFE aliases
    bResetButton                  : BOOL;
    bTwoHandsSafe                 : BOOL;
	bTouchButtonleft              : BOOL;
	bTouchButtonRight             : BOOL;
    bSafetyOk                     : BOOL;
	// Emergency Stop physical channels
	bEmergencyStopChannel1        : BOOL;
	bEmergencyStopChannel2        : BOOL;
	
	// Safety flap physical channels
	bLeftFlapChannel1             : BOOL;
	bLeftFlapChannel2             : BOOL;
	bRightFlapChannel1            : BOOL;
	bRightFlapChannel2            : BOOL;

    bAirSupplyOk                  : BOOL;

    // Power and auxiliary diagnostics
    bUp24VPowerSupplyOk         	: BOOL;
    bUs24VPowerSupplyOk         	: BOOL;
    bIvekHeaterControllerAlarm  	: BOOL;
    bSiliconeMinimumLevelSensor1 	: BOOL;
    bSiliconeMinimumLevelSensor2 	: BOOL;
	
	// Door physical channels used for root-cause diagnostics
	bMainDoorChannel1             : BOOL;
	bMainDoorChannel2             : BOOL;
	bMainDoorFeedback             : BOOL;

    // Door diagnostics returned by TwinSAFE
    bMainDoorClosed               : BOOL;
    bMainDoorLocked               : BOOL;
	bMainDoorUnsafe               : BOOL;
    bMainDoorDiagnosticOk         : BOOL;
    bMs6FeedbackOk                : BOOL;
    bAirExhausted                 : BOOL;

    // Part detection
    bGearboxAssemblyPartPresent   : BOOL;
    bReservoirPartPresent         : BOOL;
    bRejectChutePartPresent       : BOOL;
	bBothPartPresent			  : BOOL;

    // Index table
    bIndexPositionSensor1         : BOOL;
    bIndexPositionSensor2         : BOOL;
    bIndexPositionSensor3         : BOOL;
    bIndexReady                   : BOOL;
    bIndexLocked                  : BOOL;
    bIndexCompletedSensor         : BOOL;
    bIndexSupportExtended         : BOOL;
    bIndexSupportRetracted        : BOOL;
    eIndexPosition                : E_TablePosition;

    // Transfer nest support / process tooling cylinder
    bSiliconeSupportExtended        : BOOL;
    bSiliconeSupportRetracted       : BOOL;
	bAssemblySupportExtended  		: BOOL;
	bAssemblySupportRetracted 		: BOOL;

    // Flipping / assembly station - EPLAN Term 8 Ch5..Ch10
    bTransferVerticalMiniSlideRetracted : BOOL;
    bTransferVerticalMiniSlideExtended  : BOOL;
    bRotaryGripperOpened                : BOOL;
    bRotaryGripperClosed                : BOOL;
    bRotaryGripperRotationPick0         : BOOL;
    bRotaryGripperRotationPlace180      : BOOL;

    // Analog raw values. Engineering-unit scaling is intentionally kept
    // outside the terminal mapping until the sensor ranges are confirmed.
    uiMainAirPressureRaw          : UINT;
    uiSiliconePressureRaw         : UINT;
    uiNozzlePressureRaw           : UINT;
    uiVacuumPressureRaw           : UINT;
	uiExtractionAVacuumPressureRaw: UINT;
	uiExtractionBVacuumPressureRaw: UINT;
	iPartVacuumPressureRaw 			: INT;

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>